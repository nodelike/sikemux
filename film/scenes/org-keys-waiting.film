# A host signed in after its org's vault was made, while the person's only host holding the vault's key sleeps.
stage 1440 900
window 1440 900
project storefront shop
host mac-mini
orgrole admin "Fjord Labs"
orgkey mac-mini "Fjord Labs" openrouter
asleep mac-mini
orgrole user "Fjord Labs"
signed-in
settle 5
settings "API providers"
settle 2
cursor 900,600
scroll -6000 1
settle 1
snap org-keys-waiting
