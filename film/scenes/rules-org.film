# The Rules page of a project Ines shares with Fjord Labs, where she is a member: a rule kept on
# this Mac beside one in the org's store, with the pointer on it, then admins approve first: her
# next one waits and a sensitive one stays hers.
stage 1440 900
window 1440 900
prefer themeId aura-noir
signed-in
origin https://fjord.invalid/storefront.git
project storefront shop
core memoryAdd "{\"project\":\"$project\",\"entry\":{\"kind\":\"rule\",\"text\":\"Keep each test in test/ beside the file it covers in src/.\",\"goal\":null,\"sensitive\":false,\"store\":\"project\"}}"
orgrole admin "Fjord Labs"
orgshare "Fjord Labs"
settle 5
orgrole user "Fjord Labs"
settle 5
core memoryAdd "{\"project\":\"$project\",\"entry\":{\"kind\":\"rule\",\"text\":\"Run pnpm check before every commit.\",\"goal\":null,\"sensitive\":false,\"store\":\"project\"}}"
settle 4
chat Wren
settle 2
key cmd-alt-6
settle 3
snap rules-org
move 900,375 0.3
settle 1
snap rules-org-move
move 1300,860 0.3
orgpolicy admins_approve "Fjord Labs"
settle 3
core memoryAdd "{\"project\":\"$project\",\"entry\":{\"kind\":\"rule\",\"text\":\"Ask before adding a dependency.\",\"goal\":null,\"sensitive\":false,\"store\":\"project\"}}"
settle 4
snap rules-org-waiting
core memoryAdd "{\"project\":\"$project\",\"entry\":{\"kind\":\"rule\",\"text\":\"Deploy previews with the staging token in 1Password.\",\"goal\":null,\"sensitive\":true,\"store\":\"project\"}}"
settle 4
snap rules-org-sensitive
