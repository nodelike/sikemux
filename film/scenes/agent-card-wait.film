# An agent's hover card while its chat waits on a trigger with a long title.
stage 1440 900
window 1440 900
replies agent-card-wait.json
prefer themeId aura-noir
prefer uiTextScale 1.25
project storefront line-shop
core openChief {"project":"storefront"}
chat Flint
title "Fix the rounding in cart totals"
lead Chief
say "hold 600000"
chat Maple
title "Bundle the storefront"
lead Chief
say "hold 600000"
chat Otter
title "Check the refund totals"
say "Watch the Arch news feed for the AUR registration change."
settle 6
move 1238,540
settle 1.5
snap agent-card-wait
