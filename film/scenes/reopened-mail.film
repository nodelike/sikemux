# A worker reopened after its chat was closed: a message another agent sends it while it rests
# after a turn waits in its queued list.
stage 1440 900
window 1440 900
replies reopened-mail.json
prefer themeId aura-noir
prefer uiTextScale 1.25
project storefront line-shop
core openChief {"project":"storefront"}
chat Mira
title "Fix the rounding in cart totals"
lead Chief
say "Round the cart totals once, at the end."
settle 3
core closeChat {"agentId":"$chat"}
settle 2
core reopenAgent {"agentId":"$chat"}
settle 3
say "Check the receipts round the same way."
settle 3
chat Otter
title "Check the refund totals"
say "Tell Mira refunds round per line."
settle 4
front Mira
settle 1.5
snap reopened-mail
