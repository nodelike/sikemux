# The Agent Board, a tab of its own: each thing the person asked, with the screenshots they sent,
# in lanes by how far it has gone. Two asks lost their agents, so nobody is on them. A card opens
# on a sheet over the board.
stage 1760 1000
window 1760 1000
prefer themeId aura-noir
replies asks-board.json
project storefront shop-site
chat Senku
title "Invoice pay button"
say "Pay button on the invoice does nothing in Safari" asks-board/invoice.jpg asks-board/invoice-phone.jpg asks-board/cart-phone.jpg
settle 2
core closeChat {"agentId":"$chat"}
chat Kaguya
title "Gift note"
say "Add a gift note field at checkout"
settle 2
core closeChat {"agentId":"$chat"}
chat Rimuru
title "Receipt rounding"
say "Some orders come out a cent off on the receipt [Image #1], like @Nami saw with tax" asks-board/cart.jpg asks-board/cart-phone.jpg
chat Yuno
title "Search order"
say "Search puts sold-out items first"
chat Nami
title "Tax per country"
say "Tax shows 19% for every country" asks-board/cart.jpg
core openChief {"project":"storefront"}
settle 6
click 1505,275
settle 2
snap now-pill
key cmd-alt-7
settle 4
snap asks-board
click 1250,554
settle 2
snap asks-sheet
