# @Chief's chat with the Now card over its top right: four counts, then who waits on the person,
# who is ready to look at, who is moving and who has closed. A click on its head folds it to the counts.
stage 1440 900
window 1440 900
prefer themeId aura-noir
project storefront line-shop
core openChief {"project":"storefront"}
chat Flint
title "Fix the rounding in cart totals"
say "shell pnpm test"
chat Otter
title "Check the refund totals"
say "hello"
chat Maple
title "Bundle the storefront"
say "shell pnpm build"
chat Wren
title "Some orders come out a cent off"
say "hello"
settle 4
click 1186,248
settle 4
snap rail
