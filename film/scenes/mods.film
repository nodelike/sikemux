# The tab rail's Mods section on the Agents and Pages pages, then a mod open on the desk.
stage 1440 900
window 1440 900
prefer themeId aura-noir
prefer starAsked true
project storefront line-shop
project handbook mods-book
chat Juniper
title "Set up the mods"
say "shell sh mods.sh"
settle 3
chat Maple
title "Bundle the storefront"
chat Otter
title "Check the refund totals"
chat Wren
title "Cache the product pages"
core setModBadge "{\"id\":\"posts\",\"badge\":\"2 to post\"}"
core setModBadge "{\"id\":\"ci-board\",\"badge\":\"3 failing\"}"
settle 4
snap mods
key cmd-alt-8
settle 2
snap mods-pages
key cmd-alt-4
settle 1
click "Posts"
settle 4
snap mods-desk
