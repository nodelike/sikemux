# The DBML viewer in one take: Claude answers with a ```dbml block that draws itself as a
# diagram in the chat, then the schema file opens full size to be pinched, dragged and panned.
replies replies.json
project storefront shop
chat Wren
settle 6
cursor 1200,700
record
wait 1.0
zoom 760,610 1.45 1.0 &
move 600,768 1.0
click
type "draw the shop's schema so I can see how orders connect" 26
key enter
hold 0.5
zoom 760,520 1.25 0.8 &
wait 6.5
move 330,600 0.5
scroll 220 0.8
zoom 360,230,760,470 0.8 &
move 700,553 0.8
wait 0.8
still card-hover
move 716,600 0.4
wait 0.8
still card-tip
move 740,610 0.3
pinch 1.45 0.8
pan -120,-60 0.8
wait 0.3
still card-pinched
# The camera settles on the editor's pane while the finder is open, then holds still.
zoom 300,140,890,700 0.7 &
key cmd-p
move 848,453 0.6 &
wait 0.3
type "schema" 20
wait 0.2
key enter
hold 1
move 850,456 0.15
pinch 2.3 0.7
wait 0.4
still canvas-in
move 863,504 0.5
wait 0.9
still column-tip
move 543,603 0.6
drag 560,470 0.8
wait 0.3
still dragged
move 900,520 0.4
pan -240,-60 1.0
pan 120,30 0.7
pinch 0.82 0.7
wait 0.4
still panned
zoom out 0.8 &
move 1300,700 0.8
end 1.6
