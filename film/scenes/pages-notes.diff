diff --git a/notes/mockups.html b/notes/mockups.html
new file mode 100644
index 0000000..b44c0a9
--- /dev/null
+++ b/notes/mockups.html
@@ -0,0 +1,26 @@
+<!doctype html><html><head><title>Empty projects page, three ways</title><style>
+body{margin:0;padding:2px 0 0}
+h1{font-size:15px;font-weight:600;margin:0 0 2px} .sub{color:var(--muted-foreground);font-size:12.5px;margin:0 0 12px}
+.row{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
+.opt{border:1px solid var(--border);border-radius:var(--radius);background:var(--card);padding:10px;display:flex;flex-direction:column;gap:8px}
+.opt.pick{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent) inset}
+.top{display:flex;justify-content:space-between;align-items:center;font-size:12.5px;font-weight:600}
+.tag{font-size:11px;font-weight:500;color:var(--accent);border:1px solid var(--accent);border-radius:999px;padding:0 7px}
+.screen{border:1px solid var(--border);border-radius:6px;background:var(--background);height:170px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;padding:10px;box-sizing:border-box;text-align:center}
+.mark{width:34px;height:34px;border-radius:9px;background:linear-gradient(135deg,var(--chart-1),var(--chart-2))}
+.t1{font-size:12.5px;font-weight:600} .t2{font-size:11px;color:var(--muted-foreground);max-width:150px}
+.btn{font-size:11px;font-weight:600;border-radius:6px;padding:4px 10px;background:var(--accent);color:var(--accent-foreground)}
+.btn.o{background:transparent;color:var(--foreground);border:1px solid var(--border)}
+.steps{width:100%;display:grid;gap:5px}
+.step{display:flex;gap:7px;align-items:center;font-size:11px;border:1px solid var(--border);border-radius:5px;padding:4px 7px;text-align:left}
+.n{width:14px;height:14px;border-radius:50%;border:1px solid var(--muted-foreground);font-size:9px;display:grid;place-items:center;color:var(--muted-foreground);flex:none}
+.n.done{background:var(--success);border-color:var(--success);color:rgba(0,0,0,.8);font-weight:700}
+.drop{width:100%;height:100%;border:1.5px dashed var(--border);border-radius:6px;display:grid;place-items:center;font-size:11px;color:var(--muted-foreground)}
+.why{font-size:11.5px;color:var(--muted-foreground)}
+</style></head><body>
+<h1>Empty projects page, three ways</h1><p class="sub">Drawn with the dashboard's own colours and type.</p>
+<div class="row">
+<div class="opt"><div class="top">A · Friendly</div><div class="screen"><div class="mark"></div><div class="t1">No projects yet</div><div class="t2">Create one to start tracking deploys.</div><div class="btn">New project</div></div><div class="why">Warm, but one path only.</div></div>
+<div class="opt pick"><div class="top">B · Guided <span class="tag">recommended</span></div><div class="screen"><div class="steps"><div class="step"><span class="n done">✓</span>Connect GitHub</div><div class="step"><span class="n">2</span>Pick a repository</div><div class="step"><span class="n">3</span>Invite your team</div></div><div style="display:flex;gap:6px"><div class="btn">Pick a repo</div><div class="btn o">Import</div></div></div><div class="why">Two clicks to a first deploy.</div></div>
+<div class="opt"><div class="top">C · Drop zone</div><div class="screen"><div class="drop">Drop a folder here<br>or press ⌘O</div></div><div class="why">Fast for people who know it.</div></div>
+</div></body></html>
\ No newline at end of file
