  {
    "id": "sim-02",
    "from": ["err_tools_sikemux-027"],
    "category": "malformed_call",
    "severity": "low",
    "tools": ["sim_tap", "sim_state"],
    "prompt": "In the phone app on the simulator you tapped Add host a moment ago, and the sheet was still sliding up when you last read the screen: Connect was element 4 then. Tap Connect on that sheet and tell me what the screen shows after.",
    "fixture": {
      "answers": [
        {
          "tool": "sim_state",
          "reply": {
            "app": "Sikemux Dev",
            "elements": "9 StaticText \"Add a host\" at (201, 430)\n10 TextField \"Host address\" at (201, 500)\n11 Button \"Cancel\" at (80, 610)\n12 Button \"Connect\" at (300, 610)"
          }
        },
        { "tool": "sim_tap", "args": { "index": 4 }, "error": "element 4 is not on the screen now; the screen changed since you read it, so read it again with sim_state" },
        {
          "tool": "sim_tap",
          "args": { "$any": [{ "index": 12 }, { "label": "/^connect$/i" }] },
          "reply": {
            "app": "Sikemux Dev",
            "changes": { "elements": "14 StaticText \"Waiting for the host to approve this phone\" at (201, 460)\n15 Button \"Cancel\" at (201, 560)", "removed": "9, 10, 11, 12" }
          }
        },
        { "tool": "sim_tap", "error": "no element on screen is labelled as given; it may be scrolled out of view, so scroll and read the screen again" }
      ]
    },
    "grade": {
      "expect": [{ "tool": "sim_tap", "args": { "$any": [{ "index": 12 }, { "label": "/^connect$/i" }] } }],
      "forbid": [
        { "tool": "sim_tap", "args": { "x": { "$present": true } }, "why": "tapped a point instead of the element's number or label" },
        { "tool": ["Bash", "BashOutput"], "args": { "command": "/\\b(xcrun|simctl|idb)\\b/" }, "why": "drove the simulator outside sim_*" }
      ],
      "limit": [{ "tool": "sim_tap", "max": 2 }],
      "reply": "/approve|waiting/i",
      "replyWhy": "did not report the waiting-for-approval screen"
    },
    "maxTurns": 8
  }
]
