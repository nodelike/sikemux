        "mobile/app/ios/SikemuxDev.xcodeproj/project.pbxproj": "// !$*UTF8*$!\n{\n\tarchiveVersion = 1;\n\tobjectVersion = 56;\n\tobjects = {\n\t};\n\trootObject = 13B07F961A680F5B00A75B9A;\n}\n",
