{
  "name": "sikemux-mobile",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "native:android": "pnpm --filter @sikemux/native ubrn:android",
    "native:android:release": "pnpm --filter @sikemux/native ubrn:android:release",
    "native:clean": "pnpm --filter @sikemux/native ubrn:clean",
    "clean": "rm -rf app/android app/.expo && pnpm native:clean",
    "android": "pnpm --filter sikemux-app android",
    "android:release": "pnpm --filter sikemux-app android:release",
    "start": "pnpm --filter sikemux-app start",
    "typecheck": "pnpm -r typecheck",
    "lint": "node scripts/check-shared-imports.mjs && pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "format": "pnpm -r --if-present format",
    "format:check": "pnpm -r --if-present format:check",
    "design": "node design/build.mjs --serve",
    "showcase": "node showcase/capture.mjs",
    "doctor": "node scripts/doctor.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  }
}
