{
  "extends": "./tsconfig.json",
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "../showcase/native.ts"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../../shared/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "@sikemux/protocol": ["../../server/protocol/generated/types.ts"],
      "@sikemux/protocol/*": ["../../server/protocol/src/*"]
    }
  }
}
