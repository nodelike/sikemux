{
  "expo": {
    "name": "Sikemux",
    "slug": "sikemux",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sikemux",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.nodelike.sikemux.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0d0d14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      "@clerk/expo",
      "expo-local-authentication",
      "@clerk/expo-google-signin",
      "./plugins/rustls-platform-verifier",
      "./plugins/small-apk",
      "./plugins/release-signing",
      "./plugins/notifications",
      "./plugins/stash",
      "./plugins/backup-rules",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f0f13",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/figtree/400Regular/Figtree_400Regular.ttf",
            "./node_modules/@expo-google-fonts/figtree/400Regular_Italic/Figtree_400Regular_Italic.ttf",
            "./node_modules/@expo-google-fonts/figtree/500Medium/Figtree_500Medium.ttf",
            "./node_modules/@expo-google-fonts/figtree/600SemiBold/Figtree_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/jetbrains-mono/400Regular/JetBrainsMono_400Regular.ttf"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 28,
            "useLegacyPackaging": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep, includedescriptorclasses class org.rustls.platformverifier.** { *; }\n-keep class expo.modules.gl.** { *; }\n-dontwarn kotlin.MustUseReturnValues"
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "nodelike",
          "project": "sikemux-mobile",
          "url": "https://sentry.io/",
          "experimental_android": { "enableAndroidGradlePlugin": true, "includeNativeSources": false }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0f0f13"
  }
}
