{
  "expo": {
    "name": "Sikemux",
    "slug": "sikemux",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sikemux",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.nodelike.sikemux.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Sikemux finds the Macs on your network that you can pair with.",
        "NSBonjourServices": [
          "_sikemux._udp"
        ]
      },
      "icon": "../../src-tauri/icons/sikemux.icon"
    },
    "android": {
      "package": "com.nodelike.sikemux.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0d0d14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/link-system-configuration",
      "./plugins/rustls-platform-verifier",
      "./plugins/small-apk",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f0f13",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Sikemux uses the camera to scan the pairing code on your Mac.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 28,
            "useLegacyPackaging": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep, includedescriptorclasses class org.rustls.platformverifier.** { *; }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0f0f13"
  }
}
