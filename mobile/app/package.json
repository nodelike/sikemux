{
  "name": "sikemux-app",
  "main": "./index.ts",
  "version": "0.2.0",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "start": "node scripts/generate.mjs && expo start --dev-client",
    "ios": "node scripts/run.mjs ios development",
    "ios:release": "node scripts/run.mjs ios production --configuration Release",
    "android": "node scripts/run.mjs android development",
    "android:release": "node scripts/run.mjs android production --variant release",
    "prebuild": "node scripts/run.mjs prebuild",
    "typecheck": "node ../scripts/require-bindings.mjs && node scripts/generate.mjs && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write \"**/*.{ts,tsx,mts,js,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,js,mjs}\""
  },
  "dependencies": {
    "@clerk/expo": "^4.8.0",
    "@clerk/expo-google-signin": "^1.0.4",
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@paper-design/shaders": "0.0.81",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@shopify/flash-list": "2.3.3",
    "@sikemux/native": "workspace:*",
    "expo": "~57.0.26",
    "expo-apple-authentication": "~57.0.2",
    "expo-application": "~57.0.3",
    "expo-auth-session": "~57.0.13",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-gl": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-media-library": "~57.0.5",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.24",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@testing-library/react": "^16.3.3",
    "@types/react": "catalog:",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-expo": "^57.0.2",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "react-dom": "19.2.3",
    "react-native-web": "^0.21.3",
    "typescript": "catalog:",
    "vitest": "^5.0.3"
  }
}
