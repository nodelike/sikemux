  </LinearLayout>
  <LinearLayout android:id="@+id/limit_3" android:layout_width="match_parent" android:layout_height="25dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
    <TextView android:id="@+id/limit_3_label" android:layout_width="104dp" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/sikemux_widget_secondary" android:maxLines="1" android:ellipsize="end" />
