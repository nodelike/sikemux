{
  "sourceLanguage": "en",
  "strings": {
    "%@ needs permission to continue": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ necesita permiso para continuar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 需要权限才能继续"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ braucht eine Erlaubnis, um fortzufahren"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ a besoin d’une autorisation pour continuer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ が続行するには許可が必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@에서 계속하려면 권한이 필요합니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ требуется разрешение, чтобы продолжить"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ precisa de permissão para continuar"
          }
        }
      }
    },
    "%@ stops and closes on %@, along with anything it still has running.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ se detiene y se cierra en %@, junto con todo lo que tenga en ejecución."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ 会在 %2$@ 上停止并关闭，其仍在运行的所有内容也会一并停止。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ stoppt und schließt auf %@, zusammen mit allem, was noch läuft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ s’arrête et se ferme sur %@, ainsi que tout ce qui est encore en cours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ は %2$@ で停止して閉じます。実行中のものもすべて停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@은(는) %2$@에서 중지되고 닫히며, 아직 실행 중인 모든 작업도 함께 중지됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ остановится и закроется на %@ вместе со всем, что ещё запущено."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ para e fecha em %@, junto com tudo o que ainda estiver em execução."
          }
        }
      }
    },
