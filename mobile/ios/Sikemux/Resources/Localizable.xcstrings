    "Phones, this one too, are signed out and removed from every host.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los teléfonos, incluido este, cierran sesión y se quitan de todos los hosts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "所有手机（包括这部）都将退出登录并从每台主机移除。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Telefone, auch dieses, werden abgemeldet und von jedem Host entfernt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les téléphones, celui-ci compris, sont déconnectés et retirés de chaque hôte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この電話を含むすべての電話がサインアウトされ、すべてのホストから削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 휴대폰을 포함한 모든 휴대폰이 로그아웃되고 모든 호스트에서 제거됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Телефоны, включая этот, выходят из аккаунта и удаляются со всех хостов."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os celulares, inclusive este, são desconectados e removidos de todos os hosts."
          }
        }
      }
    },
