    "Lost connection to %@. Sikemux sends it again when you're back online.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se perdió la conexión con %@. Sikemux lo enviará de nuevo cuando vuelvas a estar en línea."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "与 %@ 的连接已断开。你恢复联网后，Sikemux 会重新发送。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verbindung zu %@ verloren. Sikemux sendet es erneut, sobald du wieder online bist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connexion à %@ perdue. Sikemux le renverra quand vous serez de nouveau en ligne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ との接続が切れました。オンラインに戻ると Sikemux が再送します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 연결이 끊겼습니다. 다시 온라인이 되면 Sikemux가 다시 보냅니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Потеряно соединение с %@. Sikemux отправит снова, когда вы будете в сети."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conexão com %@ perdida. O Sikemux envia de novo quando você voltar a ficar online."
          }
        }
      }
    },
