    "After %lld days your sign-in, device keys and history are erased, and backups %lld days later.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tras %lld días se borran tu inicio de sesión, las claves de los dispositivos y el historial, y las copias de seguridad %lld días después."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld 天后，你的登录信息、设备密钥和历史记录将被清除，备份则在之后 %lld 天清除。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nach %lld Tagen werden deine Anmeldung, Geräteschlüssel und dein Verlauf gelöscht, Backups %lld Tage später."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Après %lld jours, votre connexion, les clés des appareils et l’historique sont effacés, et les sauvegardes %lld jours plus tard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld 日後にサインイン情報、デバイスの鍵、履歴が消去され、バックアップはその %lld 日後に消去されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld일 후 로그인 정보, 기기 키, 기록이 삭제되고 백업은 그로부터 %lld일 후에 삭제됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Через %lld дн. ваши данные входа, ключи устройств и история стираются, а резервные копии — ещё через %lld дн."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Após %lld dias, seu login, as chaves dos dispositivos e o histórico são apagados, e os backups %lld dias depois."
          }
        }
      }
    },
