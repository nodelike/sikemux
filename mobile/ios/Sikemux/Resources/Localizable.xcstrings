    "A call's answer takes words and files, not chips. Take the chips off, or send them to the agent.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La respuesta a una llamada admite texto y archivos, no fichas. Quita las fichas o envíalas al agente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请求的回答只接受文字和文件，不接受标签。请移除标签，或把它们发给智能体。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Antwort nimmt Text und Dateien, keine Chips. Entferne die Chips oder sende sie an den Agenten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une réponse accepte du texte et des fichiers, pas de puces. Retirez les puces ou envoyez-les à l’agent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "呼び出しへの回答には文字とファイルのみ使えます。チップを外すか、エージェントに送ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "호출 답변에는 글과 파일만 넣을 수 있습니다. 칩을 빼거나 에이전트에게 보내세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ответ на вызов принимает текст и файлы, но не метки. Уберите метки или отправьте их агенту."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A resposta a uma chamada aceita texto e arquivos, não chips. Remova os chips ou envie-os ao agente."
          }
        }
      }
    },
