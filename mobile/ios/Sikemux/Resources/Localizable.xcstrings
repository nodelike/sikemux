    "%@ does not trust this Sikemux server. Update it, then try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ no confía en este servidor de Sikemux. Actualízalo y vuelve a intentarlo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 不信任此 Sikemux 服务器。请更新后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ vertraut diesem Sikemux-Server nicht. Aktualisiere ihn und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ne fait pas confiance à ce serveur Sikemux. Mettez-le à jour, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ はこの Sikemux サーバーを信頼していません。アップデートしてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@이(가) 이 Sikemux 서버를 신뢰하지 않습니다. 업데이트한 다음 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ не доверяет этому серверу Sikemux. Обновите его и попробуйте снова."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ não confia neste servidor do Sikemux. Atualize-o e tente de novo."
          }
        }
      }
    },
