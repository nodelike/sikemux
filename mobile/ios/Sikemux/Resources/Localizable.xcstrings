    "Apple did not sign you in. Check this iPhone is signed in to an Apple Account in Settings, then try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple no inició tu sesión. Comprueba en Ajustes que este iPhone tenga una sesión iniciada con una Cuenta de Apple y vuelve a intentarlo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple 未能让你登录。请在“设置”中确认此 iPhone 已登录 Apple 账户，然后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple hat dich nicht angemeldet. Prüfe in den Einstellungen, ob dieses iPhone bei einem Apple Account angemeldet ist, und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple ne vous a pas connecté. Vérifiez dans Réglages que cet iPhone est connecté à un compte Apple, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple でサインインできませんでした。設定でこの iPhone が Apple アカウントにサインインしているか確認してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple 로그인에 실패했습니다. 설정에서 이 iPhone이 Apple 계정에 로그인되어 있는지 확인한 다음 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple не выполнил вход. Проверьте в Настройках, что на этом iPhone выполнен вход в Аккаунт Apple, и попробуйте снова."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A Apple não fez seu login. Verifique nos Ajustes se este iPhone está com uma Conta Apple conectada e tente de novo."
          }
        }
      }
    },
