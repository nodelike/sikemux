    "It may be asleep, offline, or have remote access turned off.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puede estar en reposo, sin conexión o con el acceso remoto desactivado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "它可能处于睡眠、离线状态，或已关闭远程访问。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Er schläft vielleicht, ist offline oder hat den Fernzugriff ausgeschaltet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il est peut-être en veille, hors ligne, ou son accès à distance est désactivé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "スリープ中かオフライン、またはリモートアクセスがオフになっている可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "잠자기 상태이거나 오프라인이거나 원격 접속이 꺼져 있을 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
