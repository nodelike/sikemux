{
  "schemaVersion": 1,
  "id": "grok",
  "version": "2026.09.01.1",
  "rules": [
    {
      "id": "permission_prompt",
      "state": "blocked",
      "priority": 950,
      "region": "bottomNonEmptyLines(16)",
      "visibleBlocker": true,
      "gate": {
        "any": [
          { "contains": ["allow once", "deny"] },
          { "contains": ["always allow", "deny"] },
          { "contains": ["permission required"] },
          { "contains": ["approve this action"] }
        ],
        "all": [
          {
            "any": [
              { "contains": ["enter"] },
              { "contains": ["to select"] },
              { "contains": ["confirm"] }
            ]
          }
        ]
      }
    },
    {
      "id": "working_hint",
      "state": "working",
      "priority": 700,
      "region": "bottomNonEmptyLines(8)",
      "visibleWorking": true,
      "gate": {
        "any": [
          { "contains": ["esc to interrupt"] },
          { "contains": ["ctrl+c to interrupt"] },
          { "contains": ["press esc to interrupt"] }
        ]
      }
    },
    {
      "id": "input_prompt",
      "state": "idle",
      "priority": 400,
      "region": "bottomNonEmptyLines(4)",
      "visibleIdle": true,
      "gate": {
        "lineRegex": ["^\\s*[>›❯]\\s*$"],
        "not": [
          { "contains": ["permission required"] },
          { "contains": ["esc to interrupt"] }
        ]
      }
    }
  ]
}
