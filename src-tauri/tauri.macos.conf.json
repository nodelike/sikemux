{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "bash -c './scripts/icons.sh && pnpm dev'",
    "beforeBuildCommand": "bash -c './scripts/icons.sh && pnpm build'"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sikemux",
        "width": 1340,
        "height": 880,
        "minWidth": 860,
        "minHeight": 540,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 25
        }
      }
    ]
  },
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "icons/build/Assets.car": "Assets.car"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": {
          "width": 660,
          "height": 440
        },
        "appPosition": {
          "x": 180,
          "y": 180
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 180
        }
      }
    }
  }
}
