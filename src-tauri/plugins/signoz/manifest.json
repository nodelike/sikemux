{
  "id": "sikemux.signoz",
  "name": "SigNoz",
  "version": "0.1.0",
  "sikemux": ">=0.4",
  "environment": ["SIGNOZ_URL", "SIGNOZ_API_KEY"],
  "tools": [
    {
      "name": "signoz_services",
      "method": "agentServices",
      "description": "Traced services with calls, errors and p99. Name a service for its overview, its endpoints or its errors grouped by message.",
      "properties": {
        "service": {
          "type": "string"
        },
        "show": {
          "type": "string",
          "enum": [
            "overview",
            "endpoints",
            "errors"
          ],
          "description": "With service. Default overview."
        },
        "environment": {
          "type": "string",
          "description": "deployment.environment, e.g. production."
        },
        "minutes": {
          "type": "integer",
          "maximum": 10080,
          "description": "Default 30."
        },
        "start": {
          "type": "integer",
          "description": "Unix ms; with end, replaces minutes."
        },
        "end": {
          "type": "integer"
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "op": {
                "type": "string",
                "enum": [
                  "equals",
                  "not-equals",
                  "contains",
                  "not-contains",
                  "exists",
                  "not-exists"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "required": [
              "key",
              "op"
            ],
            "additionalProperties": false
          },
          "description": "Leave value out for exists and not-exists."
        },
        "expression": {
          "type": "string",
          "description": "SigNoz filter syntax, e.g. status >= 500 AND path != '/health'."
        }
      },
      "required": []
    },
    {
      "name": "signoz_logs",
      "method": "searchLogs",
      "description": "Search logs, newest first. Fields every line shares are listed once in `shared`. Bodies over 1000 characters are clipped; pass id to read one whole.",
      "properties": {
        "service": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "description": "Text the body contains."
        },
        "severities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Only these levels, e.g. [\"ERROR\", \"FATAL\"]; any case."
        },
        "traceId": {
          "type": "string",
          "description": "Only lines from this trace."
        },
        "id": {
          "type": "string",
          "description": "One line's id, to read that line whole."
        },
        "limit": {
          "type": "integer",
          "maximum": 200,
          "description": "Default 30."
        },
        "offset": {
          "type": "integer"
        },
        "environment": {
          "type": "string",
          "description": "deployment.environment, e.g. production."
        },
        "minutes": {
          "type": "integer",
          "maximum": 10080,
          "description": "Default 30."
        },
        "start": {
          "type": "integer",
          "description": "Unix ms; with end, replaces minutes."
        },
        "end": {
          "type": "integer"
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "op": {
                "type": "string",
                "enum": [
                  "equals",
                  "not-equals",
                  "contains",
                  "not-contains",
                  "exists",
                  "not-exists"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "required": [
              "key",
              "op"
            ],
            "additionalProperties": false
          },
          "description": "Leave value out for exists and not-exists."
        },
        "expression": {
          "type": "string",
          "description": "SigNoz filter syntax, e.g. status >= 500 AND path != '/health'."
        }
      },
      "required": []
    },
    {
      "name": "signoz_traces",
      "method": "agentTraces",
      "description": "Find traces by their root spans. Pass traceId for one trace as an outline of its root, failing spans and slowest spans; spanId opens one span.",
      "properties": {
        "service": {
          "type": "string"
        },
        "errorsOnly": {
          "type": "boolean",
          "description": "Only traces whose root span failed."
        },
        "minDurationMs": {
          "type": "number"
        },
        "order": {
          "type": "string",
          "enum": [
            "slowest",
            "recent"
          ]
        },
        "limit": {
          "type": "integer",
          "maximum": 200,
          "description": "Default 20."
        },
        "offset": {
          "type": "integer"
        },
        "traceId": {
          "type": "string"
        },
        "spanId": {
          "type": "string"
        },
        "maxSpans": {
          "type": "integer",
          "maximum": 500,
          "description": "Default 40."
        },
        "environment": {
          "type": "string",
          "description": "deployment.environment, e.g. production."
        },
        "minutes": {
          "type": "integer",
          "maximum": 10080,
          "description": "Default 30, or 1440 to find a traceId."
        },
        "start": {
          "type": "integer",
          "description": "Unix ms; with end, replaces minutes."
        },
        "end": {
          "type": "integer"
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "op": {
                "type": "string",
                "enum": [
                  "equals",
                  "not-equals",
                  "contains",
                  "not-contains",
                  "exists",
                  "not-exists"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "required": [
              "key",
              "op"
            ],
            "additionalProperties": false
          },
          "description": "Leave value out for exists and not-exists."
        },
        "expression": {
          "type": "string",
          "description": "SigNoz filter syntax, e.g. status >= 500 AND path != '/health'."
        }
      },
      "required": []
    },
    {
      "name": "signoz_dashboards",
      "method": "agentDashboards",
      "description": "Saved dashboards. Pass id for one dashboard's variables and panels, and panelId as well for that panel's data.",
      "properties": {
        "id": {
          "type": "string"
        },
        "panelId": {
          "type": "string"
        },
        "variables": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "description": "Dashboard variable values by name, e.g. {\"environment\": \"production\"}; the rest keep the dashboard's choice."
        },
        "minutes": {
          "type": "integer",
          "maximum": 10080,
          "description": "Default 30."
        },
        "start": {
          "type": "integer",
          "description": "Unix ms; with end, replaces minutes."
        },
        "end": {
          "type": "integer"
        }
      },
      "required": []
    },
    {
      "name": "signoz_fields",
      "method": "agentFields",
      "description": "Attribute names to filter on, matching search. Pass name for the values one attribute takes.",
      "properties": {
        "signal": {
          "type": "string",
          "enum": [
            "logs",
            "traces"
          ]
        },
        "name": {
          "type": "string"
        },
        "search": {
          "type": "string"
        }
      },
      "required": []
    }
  ]
}
