{
  "id": "sikemux.signoz",
  "name": "SigNoz",
  "version": "0.1.0",
  "sikemux": ">=0.4",
  "tools": [
    {
      "name": "signoz_services",
      "method": "services",
      "description": "Every traced service with its calls, errors, error rate and p99 latency.",
      "properties": {
        "environment": {
          "type": "string",
          "description": "deployment.environment, e.g. production. Omit for every environment."
        },
        "minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10080,
          "description": "Look back this many minutes. Default 30."
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "description": "Window start, Unix ms. Use with end instead of minutes."
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "description": "Window end, Unix ms."
        }
      },
      "required": []
    },
    {
      "name": "signoz_service_overview",
      "method": "serviceOverview",
      "description": "One service's request rate, error rate, p99 and p50, as totals and over time.",
      "properties": {
        "service": {
          "type": "string",
          "minLength": 1,
          "description": "service.name"
        },
        "environment": {
          "type": "string",
          "description": "deployment.environment, e.g. production. Omit for every environment."
        },
        "minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10080,
          "description": "Look back this many minutes. Default 30."
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "description": "Window start, Unix ms. Use with end instead of minutes."
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "description": "Window end, Unix ms."
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "op": {
                "type": "string",
                "enum": [
                  "equals",
                  "not-equals",
                  "contains",
                  "not-contains",
                  "exists",
                  "not-exists"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "required": [
              "key",
              "op"
            ],
            "additionalProperties": false
          },
          "description": "Attribute filters, e.g. [{\"key\": \"http.status_code\", \"op\": \"equals\", \"value\": 503}]. value is left out for exists and not-exists."
        },
        "expression": {
          "type": "string",
          "description": "Extra filter in SigNoz query syntax, e.g. status >= 500 AND path != '/health'. Brackets and quotes must balance."
        }
      },
      "required": [
        "service"
      ]
    },
    {
      "name": "signoz_endpoints",
      "method": "operations",
      "description": "One service's endpoints, busiest first, with rate, errors and latency.",
      "properties": {
        "service": {
          "type": "string",
          "minLength": 1,
          "description": "service.name"
        },
        "environment": {
          "type": "string",
          "description": "deployment.environment, e.g. production. Omit for every environment."
        },
        "minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10080,
          "description": "Look back this many minutes. Default 30."
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "description": "Window start, Unix ms. Use with end instead of minutes."
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "description": "Window end, Unix ms."
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "op": {
                "type": "string",
                "enum": [
                  "equals",
                  "not-equals",
                  "contains",
                  "not-contains",
                  "exists",
                  "not-exists"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "required": [
              "key",
              "op"
            ],
            "additionalProperties": false
          },
          "description": "Attribute filters, e.g. [{\"key\": \"http.status_code\", \"op\": \"equals\", \"value\": 503}]. value is left out for exists and not-exists."
        },
        "expression": {
          "type": "string",
          "description": "Extra filter in SigNoz query syntax, e.g. status >= 500 AND path != '/health'. Brackets and quotes must balance."
        }
      },
      "required": [
        "service"
      ]
    },
