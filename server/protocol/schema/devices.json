{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devices.json",
  "$defs": {
    "DeviceKey": {
      "description": "A device's iroh public key: 32 bytes of Ed25519, in lowercase hex.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "DeviceRole": {
      "description": "A host is a core people connect to, such as a Mac. A client connects to hosts, such as a phone.",
      "type": "string",
      "enum": ["host", "client"]
    },
    "Platform": {
      "description": "A web client is the web app in a browser, which may only read its hosts' look.",
      "type": "string",
      "enum": ["macos", "linux", "ios", "android", "web"]
    },
    "Channel": {
      "description": "Which build a host runs. Dev, nightly and stable cores are separate hosts.",
      "type": "string",
      "enum": ["dev", "nightly", "stable"]
    },
    "Challenge": {
      "description": "A one-time value a device signs to prove it holds its key.",
      "type": "object",
      "properties": {
        "nonce": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nonce", "expiresAt"],
      "additionalProperties": false
    },
    "DeviceRename": {
      "description": "What a device or host is called on the account, everywhere it is shown.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "DeviceRegistration": {
      "description": "Adds a device to the signed-in account, or updates it if it is already there. The signature is the device key's Ed25519 signature over the UTF-8 text `sikemux-register|<nonce>|<user id>|<key>`.",
      "type": "object",
      "properties": {
        "key": { "$ref": "#/$defs/DeviceKey" },
        "role": { "$ref": "#/$defs/DeviceRole" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "platform": { "$ref": "#/$defs/Platform" },
        "channel": { "$ref": "#/$defs/Channel" },
        "handsOnly": {
          "description": "A client whose join tickets say it never signs for the person. Once set it stays set.",
          "type": "boolean"
        },
        "nonce": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signature": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
      },
      "required": ["key", "role", "name", "platform", "nonce", "signature"],
      "additionalProperties": false
    },
    "Device": {
      "type": "object",
      "properties": {
        "key": { "$ref": "#/$defs/DeviceKey" },
        "role": { "$ref": "#/$defs/DeviceRole" },
        "name": { "type": "string" },
        "platform": { "$ref": "#/$defs/Platform" },
        "channel": { "$ref": "#/$defs/Channel" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastSeenAt": { "type": ["string", "null"], "format": "date-time" }
      },
      "required": [
        "key",
        "role",
        "name",
        "platform",
        "createdAt",
        "lastSeenAt"
      ],
      "additionalProperties": false
    },
    "DeviceList": {
      "type": "object",
      "properties": {
        "devices": { "type": "array", "items": { "$ref": "#/$defs/Device" } }
      },
      "required": ["devices"],
      "additionalProperties": false
    },
    "MacSignIn": {
      "description": "What the Mac's browser sign-in handed back to it. The API trades the code at Clerk itself and keeps none of the tokens, so the Mac never holds one.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 8,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9._~-]+$"
        },
        "codeVerifier": {
          "description": "The PKCE verifier the Mac made for this sign-in.",
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]{43,128}$"
        },
        "redirectUri": {
          "description": "Where the browser handed the code back, on the Mac itself.",
          "type": "string",
          "maxLength": 64,
          "pattern": "^http://127\\.0\\.0\\.1:[0-9]{1,5}/callback$"
        }
      },
      "required": ["code", "codeVerifier", "redirectUri"],
      "additionalProperties": false
    },
    "MacSignInState": {
      "description": "The account the browser signed in to, and a challenge good for two minutes that the Mac signs as it would a DeviceRegistration and sends back in MacSignInFinish.",
      "type": "object",
      "properties": {
        "account": {
          "type": "string",
          "pattern": "^user_[A-Za-z0-9]+$",
          "maxLength": 64
        },
        "nonce": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["account", "nonce", "expiresAt"],
      "additionalProperties": false
    },
    "MacSignInFinish": {
      "description": "Adds the Mac's host to the account its sign-in proved. The signature is the host key's, over the same text a DeviceRegistration signs, with the account from MacSignInState.",
      "type": "object",
      "properties": {
        "key": { "$ref": "#/$defs/DeviceKey" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "platform": { "$ref": "#/$defs/Platform" },
        "channel": { "$ref": "#/$defs/Channel" },
        "nonce": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signature": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
      },
      "required": ["key", "name", "platform", "channel", "nonce", "signature"],
      "additionalProperties": false
    }
  }
}
