{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "billing.json",
  "$defs": {
    "PlanId": {
      "description": "A plan. Free is having no paid plan; Team is held through a seat in an org whose Team plan is paid.",
      "type": "string",
      "enum": ["free", "pro", "team"]
    },
    "PlanFeature": {
      "description": "Something a paid plan includes. Free's are everyone's and are not listed.",
      "type": "string",
      "enum": [
        "sync",
        "move_work",
        "history_search",
        "own_triggers",
        "org_hosts",
        "org_shared_setup",
        "org_model_keys",
        "org_github",
        "org_bot_triggers",
        "chat_handover",
        "org_roles",
        "org_policy"
      ]
    },
    "BillingProductId": {
      "description": "What can be bought: a plan, or one of the Shed's boxes.",
      "type": "string",
      "enum": ["pro", "team", "shed", "shed_always_on", "shed_large"]
    },
    "BillingProductKind": {
      "description": "A plan, held once; or a Shed box, bought by the box on any plan.",
      "type": "string",
      "enum": ["plan", "shed"]
    },
    "BillingUnit": {
      "description": "What the quantity counts: the one account, a seat in an org, or a box.",
      "type": "string",
      "enum": ["account", "seat", "box"]
    },
    "BillingPayer": {
      "description": "Who a product may be bought by: a person, an org, or either.",
      "type": "string",
      "enum": ["person", "org", "either"]
    },
    "BillingInterval": {
      "type": "string",
      "enum": ["month", "year"]
    },
    "Currency": {
      "description": "An ISO 4217 code, in lowercase. The catalog prices in usd; a provider may charge in the buyer's own.",
      "type": "string",
      "pattern": "^[a-z]{3}$"
    },
    "Money": {
      "description": "An amount in the currency's smallest unit, such as cents.",
      "type": "object",
      "properties": {
        "amount": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        }
      },
      "required": ["amount", "currency"],
      "additionalProperties": false
    },
    "BillingPrice": {
      "description": "What one unit costs each interval.",
      "type": "object",
      "properties": {
        "interval": {
          "$ref": "#/$defs/BillingInterval"
        },
        "unit": {
          "$ref": "#/$defs/Money"
        }
      },
      "required": ["interval", "unit"],
      "additionalProperties": false
    },
    "BillingProduct": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/BillingProductId"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/BillingProductKind"
        },
        "unit": {
          "$ref": "#/$defs/BillingUnit"
        },
        "payer": {
          "$ref": "#/$defs/BillingPayer"
        },
        "plan": {
          "description": "Only on plans: the plan it is.",
          "$ref": "#/$defs/PlanId"
        },
        "maxQuantity": {
          "type": "integer",
          "minimum": 1
        },
        "prices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BillingPrice"
          }
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "unit",
        "payer",
        "maxQuantity",
        "prices"
      ],
      "additionalProperties": false
    },
    "BillingPlan": {
      "description": "A plan and everything it includes, the plans it includes counted in.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/PlanId"
        },
        "name": {
          "type": "string"
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanFeature"
          }
        }
      },
      "required": ["id", "name", "features"],
      "additionalProperties": false
    },
    "BillingCatalog": {
      "description": "Everything on sale, what it costs and what each plan includes.",
      "type": "object",
      "properties": {
        "products": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BillingProduct"
          }
        },
        "plans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BillingPlan"
          }
        },
        "refundDays": {
          "description": "How many days after a subscription's first payment it may be refunded in full.",
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["products", "plans", "refundDays"],
      "additionalProperties": false
    },
    "SubscriptionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "SubscriptionStatus": {
      "description": "active: paid for the current period. lapsed: a payment failed and the provider is still trying; nothing it pays for is allowed meanwhile. ended: over for good.",
      "type": "string",
      "enum": ["active", "lapsed", "ended"]
    },
    "Subscription": {
      "description": "One product bought in a quantity, billed each interval.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/SubscriptionId"
        },
        "product": {
          "$ref": "#/$defs/BillingProductId"
        },
        "interval": {
          "$ref": "#/$defs/BillingInterval"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "$ref": "#/$defs/SubscriptionStatus"
        },
        "currentPeriodEnd": {
          "type": "string",
          "format": "date-time"
        },
        "cancelAtPeriodEnd": {
          "description": "It ends at currentPeriodEnd unless resumed first.",
          "type": "boolean"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "endedAt": {
          "type": "string",
          "format": "date-time"
        },
        "atRenewal": {
          "description": "A change asked for at renewal, which takes over at currentPeriodEnd.",
          "$ref": "#/$defs/ScheduledChange"
        }
      },
      "required": [
        "id",
        "product",
        "interval",
        "quantity",
        "status",
        "currentPeriodEnd",
        "cancelAtPeriodEnd",
        "startedAt"
      ],
      "additionalProperties": false
    },
    "ScheduledChange": {
      "type": "object",
      "properties": {
        "product": {
          "$ref": "#/$defs/BillingProductId"
        },
        "interval": {
          "$ref": "#/$defs/BillingInterval"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["product", "interval", "quantity"],
      "additionalProperties": false
    },
    "ShedBoxes": {
      "type": "object",
      "properties": {
        "product": {
          "$ref": "#/$defs/BillingProductId"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["product", "quantity"],
      "additionalProperties": false
    },
    "Allowance": {
      "description": "What an account or org may use. Until billing is live, features lists everything for everyone.",
      "type": "object",
      "properties": {
        "plan": {
          "$ref": "#/$defs/PlanId"
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanFeature"
          }
        },
        "boxes": {
          "description": "The Shed boxes it has bought and paid for.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ShedBoxes"
          }
        },
        "seatOrgs": {
          "description": "For a person: the orgs whose paid Team plan they hold a seat in.",
          "type": "array",
          "items": {
            "$ref": "orgs.json#/$defs/OrgId"
          }
        }
      },
      "required": ["plan", "features", "boxes"],
      "additionalProperties": false
    },
    "BillingOverview": {
      "description": "A person's or an org's plan, what it allows and what it pays for.",
      "type": "object",
      "properties": {
        "allowance": {
          "$ref": "#/$defs/Allowance"
        },
        "subscriptions": {
          "description": "Every subscription that has not ended, then the ended ones, newest first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Subscription"
          }
        },
        "live": {
          "description": "Whether plans are enforced and sold to everyone. Until then billing answers only staff.",
          "type": "boolean"
        },
        "canBuy": {
          "description": "Whether a payment provider is set up, so checkouts and changes can be made.",
          "type": "boolean"
        },
        "card": {
          "description": "Left out when the provider holds no card for this payer, or could not be asked.",
          "$ref": "#/$defs/PaymentCard"
        }
      },
      "required": ["allowance", "subscriptions", "live", "canBuy"],
      "additionalProperties": false
    },
    "CheckoutRequest": {
      "description": "Buy a product. The server sets the price from the catalog.",
      "type": "object",
      "properties": {
        "product": {
          "$ref": "#/$defs/BillingProductId"
        },
        "interval": {
          "$ref": "#/$defs/BillingInterval"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "orgId": {
          "$ref": "orgs.json#/$defs/OrgId"
        }
      },
      "required": ["product", "interval", "quantity"],
      "additionalProperties": false
    },
    "Checkout": {
      "description": "The provider's page to pay on. The plan changes when the provider says the payment went through, not when the page returns.",
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["url"],
      "additionalProperties": false
    },
    "SubscriptionChange": {
      "description": "A new quantity, product or interval, now with the rest of the period charged or credited, or from the next renewal. Plans change only to another of the same kind: a Shed box to another Shed box.",
      "type": "object",
      "properties": {
        "product": {
          "$ref": "#/$defs/BillingProductId"
        },
        "interval": {
          "$ref": "#/$defs/BillingInterval"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "when": {
          "description": "Now when left out.",
          "$ref": "#/$defs/ChangeWhen"
        }
      },
      "additionalProperties": false
    },
    "ChangeWhen": {
      "description": "now charges the prorated difference at once and changes nothing if that payment fails; renewal waits for the end of the period, for payment methods that cannot be charged mid-period.",
      "type": "string",
      "enum": ["now", "renewal"]
    },
    "InvoiceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "InvoiceStatus": {
      "type": "string",
      "enum": ["paid", "failed", "refunded"]
    },
    "InvoiceLine": {
      "description": "One product a payment was for, and how many accounts, seats or boxes of it the subscription held after it.",
      "type": "object",
      "properties": {
        "product": {
          "$ref": "#/$defs/BillingProductId"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["product", "quantity"],
      "additionalProperties": false
    },
    "Invoice": {
      "description": "A payment the provider took or tried to take.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/InvoiceId"
        },
        "lines": {
          "description": "What it paid for, one line for each product the subscription holds.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/InvoiceLine"
          }
        },
        "reason": {
          "$ref": "#/$defs/InvoiceReason"
        },
        "total": {
          "$ref": "#/$defs/Money"
        },
        "status": {
          "$ref": "#/$defs/InvoiceStatus"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "refundRequestedAt": {
          "description": "A refund was asked of the provider, which has not made it yet.",
          "type": "string",
          "format": "date-time"
        },
        "refundableUntil": {
          "description": "Only on a subscription's first payment, while it may still be refunded in full.",
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "lines", "reason", "total", "status", "at"],
      "additionalProperties": false
    },
    "InvoiceList": {
      "type": "object",
      "properties": {
        "invoices": {
          "description": "Newest first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Invoice"
          }
        }
      },
      "required": ["invoices"],
      "additionalProperties": false
    },
    "InvoiceReason": {
      "description": "Why a payment was taken: a subscription's first, one for a new period, or the prorated difference of a change.",
      "type": "string",
      "enum": ["first_payment", "renewal", "change"]
    },
    "BillingLink": {
      "description": "A page of the provider's: its portal for payment methods, or one payment's receipt.",
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["url"],
      "additionalProperties": false
    },
    "PaddleCheckout": {
      "description": "Paddle.js opens its checkout with a client token, which Paddle makes public by design.",
      "type": "object",
      "properties": {
        "clientToken": {
          "type": "string"
        },
        "environment": {
          "$ref": "#/$defs/PaddleEnvironment"
        }
      },
      "required": ["clientToken", "environment"],
      "additionalProperties": false
    },
    "PaddleEnvironment": {
      "type": "string",
      "enum": ["sandbox", "production"]
    },
    "PaymentCard": {
      "description": "The card a payer pays with, as the provider shows it. Nothing more of a card is ever sent or kept.",
      "type": "object",
      "properties": {
        "brand": {
          "description": "The provider's name for the card's network, such as visa.",
          "type": "string"
        },
        "last4": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "expMonth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "expYear": {
          "type": "integer",
          "minimum": 2000
        }
      },
      "required": ["brand", "last4", "expMonth", "expYear"],
      "additionalProperties": false
    }
  }
}
