Ref: vault_entries.user_id > vaults.user_id [delete: cascade]
Ref: vault_uses.user_id > users.id [delete: cascade]
Ref: mod_counters.user_id - vaults.user_id [delete: cascade]
Ref: mod_documents.user_id > mod_counters.user_id [delete: cascade]
Ref: mod_purges.user_id > mod_counters.user_id [delete: cascade]
Ref: mod_files.user_id > mod_counters.user_id [delete: cascade]
Ref: org_users.org_id > orgs.id [delete: cascade]
Ref: org_users.user_id > users.id [delete: cascade]
Ref: org_invites.org_id > orgs.id [delete: cascade]
Ref: billing_customers.org_id > orgs.id [delete: cascade]
Ref: billing_customers.paid_by > users.id [delete: set null]
Ref: billing_customers.user_id > users.id [delete: cascade]
Ref: subscriptions.customer_id > billing_customers.id [delete: cascade]
Ref: invoices.customer_id > billing_customers.id [delete: cascade]
Ref: billing_checkouts.customer_id > billing_customers.id [delete: cascade]
Ref: billing_checkouts.opened_by > users.id [delete: cascade]
Ref: billing_people.user_id > users.id [delete: cascade]
Ref: plan_gifts.user_id - users.id [delete: cascade]
Ref: org_teams.org_id > orgs.id [delete: cascade]
Ref: org_team_members.member_id > org_users.id [delete: cascade]
Ref: org_team_members.team_id > org_teams.id [delete: cascade]
Ref: org_domains.org_id > orgs.id [delete: cascade]
Ref: org_shares.member_id > org_users.id [delete: cascade]
Ref: org_vaults.org_id - orgs.id [delete: cascade]
Ref: org_vault_keys.org_id > org_vaults.org_id [delete: cascade]
Ref: org_vault_entries.org_id > org_vaults.org_id [delete: cascade]
Ref: org_vault_ended.org_id > org_vaults.org_id [delete: cascade]
Ref: address_proofs.org_id > orgs.id [delete: set null]
Ref: address_proofs.user_id > users.id [delete: cascade]
Ref: account_folds.from_user > users.id [delete: cascade]
Ref: account_folds.into_user > users.id [delete: cascade]
Ref: account_folds.org_id > orgs.id [delete: set null]
Ref: sign_in_removals.user_id > users.id [delete: cascade]
Ref: work_address_sittings.user_id > users.id [delete: cascade]
