  org_id uuid [not null]
  domain text [not null, note: '(length(domain) <= 253) AND (domain ~ \'^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$\')']
  token text [not null, note: 'token ~ \'^[A-Za-z0-9_-]{22}$\'']
  joining text [not null, default: 'offered', note: 'joining = ANY (ARRAY[\'open\', \'offered\'])']
  added_by text [not null]
  created_at timestamptz [not null, default: `now()`]
  verified_at timestamptz
  ours_since timestamptz

  indexes {
    (org_id, domain) [unique]
    domain [name: 'org_domains_verified', unique, note: 'where (verified_at IS NOT NULL)']
  }

  Note: '(ours_since IS NULL) OR (verified_at IS NOT NULL)'
}

Table org_shares {
  member_id uuid [not null]
  project text [not null, note: 'project ~ \'^[0-9a-f]{64}$\'']
  host text [not null, note: 'host ~ \'^[0-9a-f]{64}$\'']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (member_id, project) [pk]
  }
}

Table org_vaults {
  org_id uuid [pk]
  generation integer [not null, default: 1, note: 'generation >= 1']
  created_by text [not null]
  created_at timestamptz [not null, default: `now()`]
  rotated_at timestamptz
  changes bigint [not null, default: 0]
}

Table org_vault_keys {
  org_id uuid [not null]
  host_key text [not null, note: 'host_key ~ \'^[0-9a-f]{64}$\'']
  generation integer [not null, note: 'generation >= 1']
  wrapped text [not null, note: '(wrapped ~ \'^[A-Za-z0-9_-]+$\') AND (length(wrapped) <= 256)']
  wrapped_by text [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (org_id, host_key) [pk]
  }
}

Table org_vault_entries {
  id text [not null, note: 'id ~ \'^[0-9a-f]{32}$\'']
  org_id uuid [not null]
  kind text [not null, note: 'kind ~ \'^[a-z][a-z0-9-]{0,47}$\'']
  generation integer [not null, note: 'generation >= 1']
  sealed text [not null, note: '(sealed ~ \'^[A-Za-z0-9_-]+$\') AND (length(sealed) <= 87400)']
  revision integer [not null, note: 'revision >= 1']
  updated_by text [not null]
  updated_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  change bigint [not null, default: 0]

  indexes {
    (org_id, id) [pk]
  }
}

Table org_vault_ended {
  org_id uuid [not null]
  id text [not null, note: 'id ~ \'^[0-9a-f]{32}$\'']
  revision integer [not null, note: 'revision >= 1']
  change bigint [not null, default: 0]

  indexes {
    (org_id, id) [pk]
  }
}

Table address_proofs {
  address_hash bytea [pk, note: 'length(address_hash) = 32']
  user_id text [not null]
  domain text [not null, note: '(length(domain) >= 1) AND (length(domain) <= 253)']
  org_id uuid
  via text [not null, note: 'via = ANY (ARRAY[\'fold\', \'google\'])']
  proven_at timestamptz [not null, default: `now()`]
  id uuid [not null, unique, default: `gen_random_uuid()`]

  indexes {
    domain [name: 'address_proofs_by_domain']
    user_id [name: 'address_proofs_by_user']
  }
}

Table account_folds {
  id uuid [pk, default: `gen_random_uuid()`]
  from_user text
  into_user text
  secret_hash bytea [not null, note: 'length(secret_hash) = 32']
  why text [not null, note: 'why = ANY (ARRAY[\'invite\', \'share\', \'browser\', \'domain\', \'address\', \'seat\'])']
  org_id uuid
  address_hash bytea [note: 'length(address_hash) = 32']
  domain text
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  done_at timestamptz

  indexes {
    from_user [name: 'account_folds_by_from', note: 'where (done_at IS NOT NULL)']
  }

  Note: '(from_user IS NOT NULL) OR (into_user IS NOT NULL); (done_at IS NULL) OR ((from_user IS NOT NULL) AND (into_user IS NOT NULL) AND (address_hash IS NOT NULL))'
}

Table sign_in_removals {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id text [not null]
  address_id text [not null, note: '(length(address_id) >= 1) AND (length(address_id) <= 64)']
  domain text [not null, note: '(length(domain) >= 1) AND (length(domain) <= 253)']
  org_name text
  provider text
  removed_at timestamptz [not null, default: `now()`]
  told_at timestamptz

  indexes {
    (user_id, address_id) [unique]
    user_id [name: 'sign_in_removals_untold', note: 'where (told_at IS NULL)']
  }
}

Table work_address_sittings {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id text [not null]
  state_hash bytea [not null, unique, note: 'length(state_hash) = 32']
  nonce text [not null]
  verifier text [not null]
  address_hash bytea [note: 'length(address_hash) = 32']
  created_at timestamptz [not null, default: `now()`]
  proven_at timestamptz
  joined_at timestamptz

  indexes {
    user_id [name: 'work_address_sittings_by_user']
  }
}

Ref: devices.user_id > users.id [delete: cascade]
Ref: update_channels.update_id > updates.id [delete: cascade]
Ref: events.user_id > users.id [delete: cascade]
Ref: removed_devices.user_id > users.id [delete: cascade]
Ref: push_tokens.device_key - devices.key [delete: cascade]
