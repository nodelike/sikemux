{
  "name": "@sikemux/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "migrate": "node --env-file-if-exists=.env src/main.ts migrate",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "schema:generate": "UPDATE_SCHEMA=1 vitest run test/schema.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@sentry/node": "^11.12.0",
    "@sikemux/protocol": "workspace:*",
    "hono": "^4.13.18",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "mmdb-lib": "^3.0.3",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "catalog:"
  }
}
