(sikemux_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

api.sikemux.com {
	import sikemux_headers
	header Referrer-Policy "no-referrer"
	encode zstd gzip
	# A stashed file may be 25 MiB; every other body stays small.
	@stash_upload {
		method POST
		path /v1/stash
	}
	request_body @stash_upload {
		max_size 26MiB
	}
	@small_body not {
		method POST
		path /v1/stash
	}
	request_body @small_body {
		max_size 1MiB
	}
	# Only the relay, on this machine, asks the API at /internal.
	@internal path /internal/*
	respond @internal 404
	# /v1/live is one WebSocket per device. A reload leaves open ones up to 5 minutes before
	# closing them, so devices reconnect spread out instead of all at once.
	reverse_proxy 127.0.0.1:4000 {
		stream_close_delay 5m
	}
	log {
		output file /var/log/caddy/sikemux-api.log {
			roll_size 10MiB
			roll_keep 10
		}
		format json
	}
}

app.sikemux.com {
	import sikemux_headers
	# Clerk's script, sign-in, pictures and bot check, the API and its sockets, and the
	# markdown parser's WebAssembly. A shared chat's key stays in the link's #, so it never
	# reaches a server; the share's id is cut from the log below.
	header {
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://clerk.sikemux.com https://challenges.cloudflare.com; connect-src 'self' https://clerk.sikemux.com https://api.sikemux.com wss://api.sikemux.com; img-src 'self' data: blob: https://img.clerk.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:; frame-src https://challenges.cloudflare.com; form-action 'self' https://clerk.sikemux.com http://127.0.0.1:*; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
	}
	root * /srv/sikemux/current/app
	encode zstd gzip
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@pages not path /assets/*
	header @pages Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
	log {
		output file /var/log/caddy/sikemux-app.log {
			roll_size 10MiB
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>uri regexp ^/s/[^/?#]+ /s/-
				request>headers>Referer delete
			}
		}
	}
}

updates.sikemux.com {
	import sikemux_headers
	header Referrer-Policy "no-referrer"
	encode zstd gzip
	handle /manifest {
		rewrite * /updates/manifest
		reverse_proxy 127.0.0.1:4000
	}
	# Assets are stored as <sha256>.<type>.<subtype>, such as <sha256>.image.png, and served at
	# /assets/<sha256> with the media type their name carries.
	@asset {
		path_regexp ^/assets/[0-9a-f]{64}$
		file {
			root /srv/sikemux/updates
			try_files {path}.*
		}
	}
	route @asset {
		root * /srv/sikemux/updates
		rewrite {file_match.relative}
		@typed path_regexp type ^/assets/[0-9a-f]{64}\.([a-z]+)\.([a-z0-9.+-]+)$
		header @typed Content-Type {re.type.1}/{re.type.2}
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	respond 404
	log {
		output file /var/log/caddy/sikemux-updates.log {
			roll_size 10MiB
			roll_keep 10
		}
		format json
	}
}

# The iroh relay apps fall back to when two devices cannot reach each other directly. It speaks
# plain HTTP on 127.0.0.1:3340; Caddy terminates TLS. Its QUIC address discovery listens on
# udp/7842 by itself, with a copy of this site's certificate (see relay-certificate).
relay.sikemux.com {
	import sikemux_headers
	header Referrer-Policy "no-referrer"
	# Each device holds one WebSocket at /relay. A reload leaves open ones up to 5 minutes, so
	# devices reconnect spread out instead of all at once.
	reverse_proxy 127.0.0.1:3340 {
		stream_close_delay 5m
	}
	log {
		output file /var/log/caddy/sikemux-relay.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}

# Apps check for a captive portal with a plain-HTTP request to /generate_204, which must reach the
# relay rather than Caddy's usual redirect to HTTPS.
http://relay.sikemux.com {
	handle /generate_204 {
		reverse_proxy 127.0.0.1:3340
	}
	handle {
		redir https://{host}{uri} 308
	}
}
