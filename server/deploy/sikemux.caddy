(sikemux_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

(sikemux_preview) {
	lb_try_duration 2s
	lb_try_interval 250ms
	header_down -X-Request-Id
}

api.sikemux.com {
	import sikemux_headers
	header Referrer-Policy "no-referrer"
	encode zstd gzip
	# Vault rotations may be ~46 MiB, stashed files, shared pages and mod files 25 MiB, and
	# mod document pushes or vault keys/vouches up to ~4.3 MiB; the API holds each to its own
	# limit. Every other body stays small.
	@vault_rotate `method('POST') && path('/v1/vault/rotate', '/v1/orgs/*/vault/rotate')`
	request_body @vault_rotate {
		max_size 50MiB
	}
	@upload `(method('POST') && path('/v1/stash')) || (method('PUT') && path('/v1/pages/*', '/v1/mods/*/files/*'))`
	request_body @upload {
		max_size 26MiB
	}
	@batch `(method('POST') && path('/v1/mods/documents')) || (method('PUT') && path('/v1/vault/keys', '/v1/orgs/*/vault/keys', '/v1/orgs/*/vault/vouches'))`
	request_body @batch {
		max_size 5MiB
	}
	@small_body `!(method('POST') && path('/v1/stash', '/v1/mods/documents', '/v1/vault/rotate', '/v1/orgs/*/vault/rotate')) && !(method('PUT') && path('/v1/pages/*', '/v1/mods/*/files/*', '/v1/vault/keys', '/v1/orgs/*/vault/keys', '/v1/orgs/*/vault/vouches'))`
	request_body @small_body {
		max_size 1MiB
	}
	# Only the relay, on this machine, asks the API at /internal.
	@internal path /internal/*
	respond @internal 404
	# /v1/live is one WebSocket per device. A reload leaves open ones up to 5 minutes before
	# closing them, so devices reconnect spread out instead of all at once.
	# While the API restarts on a deploy, a request waits for it instead of failing. Caddy sends
	# a request again only if the API never received it, or if it is a GET.
	reverse_proxy 127.0.0.1:4000 {
		stream_close_delay 5m
		lb_try_duration 15s
		lb_try_interval 250ms
	}
	log {
		output file /var/log/caddy/sikemux-api.log {
			roll_size 10MiB
			roll_keep 10
		}
		format filter {
			wrap json
			fields {
				request>uri regexp ^/v1/(pages|shares)/[^/?#]+ /v1/${1}/-
				request>headers>X-Page-Proof delete
				request>headers>X-Page-Title delete
				request>headers>X-Page-Shared-By delete
				request>headers>Authorization delete
				request>headers>Cookie delete
				request>headers>Referer delete
			}
		}
	}
}

app.sikemux.com {
	import sikemux_headers
	# Clerk's script, sign-in, pictures and bot check, the API and its sockets, and the
	# markdown parser's WebAssembly. A shared chat's key stays in the link's #, so it never
	# reaches a server; the share's id is cut from the log below.
	header {
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}
	@app not path /p/*
	header @app Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://clerk.sikemux.com https://challenges.cloudflare.com https://cdn.paddle.com; connect-src 'self' https://clerk.sikemux.com https://api.sikemux.com wss://api.sikemux.com https://relay.sikemux.com wss://relay.sikemux.com; img-src 'self' data: blob: https://img.clerk.com; style-src 'self' 'unsafe-inline' https://cdn.paddle.com https://sandbox-cdn.paddle.com; font-src 'self' data:; worker-src 'self' blob:; frame-src https://challenges.cloudflare.com https://buy.paddle.com https://sandbox-buy.paddle.com; form-action 'self' https://clerk.sikemux.com http://127.0.0.1:*; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
	# A shared page is drawn in a sandboxed frame whose local assets are inlined as data:/blob:
	# URIs; no remote https: origins are permitted beyond Clerk and Turnstile on the host page.
	@page path /p/*
	header @page Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://clerk.sikemux.com https://challenges.cloudflare.com; connect-src 'self' https://clerk.sikemux.com https://api.sikemux.com; img-src 'self' data: blob: https://img.clerk.com; style-src 'self' 'unsafe-inline'; font-src 'self' data: blob:; media-src 'self' data: blob:; worker-src 'self' blob:; frame-src https://challenges.cloudflare.com; form-action 'self' https://clerk.sikemux.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
	root * /srv/sikemux/current/app
	encode zstd gzip
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@pages not path /assets/*
	header @pages Cache-Control "no-cache"
	# A share link has its own page only for what it previews as. Any id gets the same one.
	map {path} {built_page} {
		~^/p/ /shared-artifact.html
		~^/s/ /shared-chat.html
		default /index.html
	}
	# The API knows what a live share with a title previews as. Anything else, the API being down
	# too, is answered alike, so nobody learns whether an id was ever shared.
	@titled path_regexp id ^/p/([A-Za-z0-9_-]{22})$
	handle @titled {
		rewrite * /internal/shared-pages/{re.id.1}
		reverse_proxy 127.0.0.1:4000 {
			import sikemux_preview
			@untitled status 4xx 5xx
			handle_response @untitled {
				rewrite * /shared-artifact.html
				file_server
			}
		}
	}
	@picture path_regexp id ^/p/([A-Za-z0-9_-]{22})/preview\.png$
	handle @picture {
		rewrite * /internal/shared-pages/{re.id.1}/preview.png
		reverse_proxy 127.0.0.1:4000 {
			import sikemux_preview
			@undrawn status 4xx 5xx
			handle_response @undrawn {
				error 404
			}
		}
	}
	handle {
		try_files {path} {built_page} /index.html
		file_server
	}
	handle_errors 502 504 {
		header -Server
		@undrawn path */preview.png
		handle @undrawn {
			respond 404
		}
		handle {
			rewrite * /shared-artifact.html
			file_server {
				status 200
			}
		}
	}
	handle_errors {
		header -Server
	}
	log {
		output file /var/log/caddy/sikemux-app.log {
			roll_size 10MiB
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>uri regexp ^/(s|p)/[^/?#]+ /${1}/-
				request>headers>Referer delete
			}
		}
	}
}

updates.sikemux.com {
	import sikemux_headers
	header Referrer-Policy "no-referrer"
	encode zstd gzip
	handle /manifest {
		rewrite * /updates/manifest
		reverse_proxy 127.0.0.1:4000 {
			lb_try_duration 15s
			lb_try_interval 250ms
		}
	}
	# Assets are stored as <sha256>.<type>.<subtype>, such as <sha256>.image.png, and served at
	# /assets/<sha256> with the media type their name carries.
	@asset {
		path_regexp ^/assets/[0-9a-f]{64}$
		file {
			root /srv/sikemux/updates
			try_files {path}.*
		}
	}
	route @asset {
		root * /srv/sikemux/updates
		rewrite {file_match.relative}
		@typed path_regexp type ^/assets/[0-9a-f]{64}\.([a-z]+)\.([a-z0-9.+-]+)$
		header @typed Content-Type {re.type.1}/{re.type.2}
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	respond 404
	log {
		output file /var/log/caddy/sikemux-updates.log {
			roll_size 10MiB
			roll_keep 10
		}
		format json
	}
}

# The iroh relay apps fall back to when two devices cannot reach each other directly. It speaks
# plain HTTP on 127.0.0.1:3340; Caddy terminates TLS. Its QUIC address discovery listens on
# udp/7842 by itself, with a copy of this site's certificate (see relay-certificate).
relay.sikemux.com {
	import sikemux_headers
	header Referrer-Policy "no-referrer"
	# Each device holds one WebSocket at /relay. A reload leaves open ones up to 5 minutes, so
	# devices reconnect spread out instead of all at once.
	reverse_proxy 127.0.0.1:3340 {
		stream_close_delay 5m
	}
	log {
		output file /var/log/caddy/sikemux-relay.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}

# Apps check for a captive portal with a plain-HTTP request to /generate_204, which must reach the
# relay rather than Caddy's usual redirect to HTTPS.
http://relay.sikemux.com {
	handle /generate_204 {
		reverse_proxy 127.0.0.1:3340
	}
	handle {
		redir https://{host}{uri} 308
	}
}
