#!/usr/bin/env bash
# Receives what the deploy key may send, and nothing else, since its authorized_keys entry forces
# this script:
#   ssh sikemux-deploy@citadel <commit> < release.tar.gz          installs a server release
#   ssh sikemux-deploy@citadel publish-update < update.tar.gz     publishes a phone update
#   ssh sikemux-deploy@citadel promote-update <update id>         offers an update on stable too
#   ssh sikemux-deploy@citadel withdraw-update <update id>        stops offering an update
#   ssh sikemux-deploy@citadel roll-back-update <update id> < directive.json
#                                                                 rolls phones back from an update
set -euo pipefail
# shellcheck source=lib.sh
. "$(dirname "$0")/lib.sh"

ROOT=/srv/sikemux
RELEASES="$ROOT/releases"
UPDATES="$ROOT/updates"
KEEP=5
MAX_BYTES=$((200 * 1024 * 1024))
MAX_UPDATE_BYTES=$((100 * 1024 * 1024))
MAX_DIRECTIVE_BYTES=$((16 * 1024))
HEALTH=http://127.0.0.1:4000/v1/health
export DATABASE_URL="$SIKEMUX_DATABASE_URL"

say() { printf '[deploy] %s\n' "$*"; }
fail() {
  say "$*" >&2
  exit 1
}

usage() {
  fail "usage: ssh sikemux-deploy@citadel <40-character commit> < release.tar.gz
         ssh sikemux-deploy@citadel publish-update < update.tar.gz
         ssh sikemux-deploy@citadel promote-update <update id>
         ssh sikemux-deploy@citadel withdraw-update <update id>
         ssh sikemux-deploy@citadel roll-back-update <update id> < directive.json"
}

api() {
  [ -f "$ROOT/current/api/dist/main.mjs" ] || fail "no server release is installed yet"
  node "$ROOT/current/api/dist/main.mjs" "$@"
}

publish_update() {
  exec 9>"$ROOT/deploy.lock"
  flock 9

  incoming="$(mktemp -d "$UPDATES/.incoming.XXXXXX")"
  trap 'rm -rf "$incoming"' EXIT
  head -c "$((MAX_UPDATE_BYTES + 1))" >"$incoming/update.tar.gz"
  [ "$(stat -c %s "$incoming/update.tar.gz")" -le "$MAX_UPDATE_BYTES" ] ||
    fail "the update is larger than $((MAX_UPDATE_BYTES / 1024 / 1024)) MB"
  # Unpacked with a cap too, so a small archive cannot fill the disk.
  { gzip -dc "$incoming/update.tar.gz" 2>/dev/null || true; } | head -c "$((MAX_UPDATE_BYTES + 1))" >"$incoming/update.tar"
  [ "$(stat -c %s "$incoming/update.tar")" -le "$MAX_UPDATE_BYTES" ] ||
    fail "the update unpacks to more than $((MAX_UPDATE_BYTES / 1024 / 1024)) MB"

  # Only plain files and folders with the names a bundle has, so nothing lands outside it.
  local listing names line name
  listing="$(tar -tvf "$incoming/update.tar" 2>/dev/null)" || fail "the update is not a .tar.gz"
  names="$(tar -tf "$incoming/update.tar")"
  while IFS= read -r line; do
    [[ "$line" =~ ^[-d] ]] || fail "the update holds something other than files and folders"
  done <<<"$listing"
  while IFS= read -r name; do
    name="${name#./}"
    [ -z "$name" ] || [[ "$name" =~ ^(update\.json|manifest\.json|manifest\.sig|assets/?|assets/[0-9a-f]{64}(\.type)?)$ ]] ||
      fail "the update holds $name, which a bundle does not"
  done <<<"$names"

  mkdir "$incoming/bundle"
  tar -xf "$incoming/update.tar" -C "$incoming/bundle" --no-same-owner --no-same-permissions
  [ -z "$(find "$incoming/bundle" ! -type f ! -type d)" ] ||
    fail "the update holds something other than files and folders"

  say "publishing the update"
  api publish-update "$incoming/bundle" "$UPDATES/assets" || fail "the update was refused"
  say "the update is published"
  exit 0
}

promote_update() {
  local id="$1"

  exec 9>"$ROOT/deploy.lock"
  flock 9

  say "promoting $id to stable"
  api promote-update "$id" || fail "promoting $id was refused"
  say "$id is on stable"
  exit 0
}

withdraw_update() {
  local id="$1"

  exec 9>"$ROOT/deploy.lock"
  flock 9

  say "withdrawing $id"
  api withdraw-update "$id" || fail "withdrawing $id was refused"
  say "$id is withdrawn"
  exit 0
}

roll_back_update() {
  local id="$1"

  exec 9>"$ROOT/deploy.lock"
  flock 9

  incoming="$(mktemp "$UPDATES/.directive.XXXXXX")"
  trap 'rm -f "$incoming"' EXIT
  head -c "$((MAX_DIRECTIVE_BYTES + 1))" >"$incoming"
  [ "$(stat -c %s "$incoming")" -le "$MAX_DIRECTIVE_BYTES" ] ||
    fail "the directive is larger than $((MAX_DIRECTIVE_BYTES / 1024)) KB"

  say "rolling phones back from $id"
  api roll-back-update "$id" "$incoming" || fail "rolling back $id was refused"
  say "phones are told to roll back from $id"
  exit 0
}

read -r -a words <<<"${SSH_ORIGINAL_COMMAND:-}"
case "${words[0]:-}" in
  publish-update)
    [ "${#words[@]}" -eq 1 ] || usage
    publish_update
    ;;
  promote-update)
    [ "${#words[@]}" -eq 2 ] || usage
    promote_update "${words[1]}"
    ;;
  withdraw-update)
    [ "${#words[@]}" -eq 2 ] || usage
    withdraw_update "${words[1]}"
    ;;
  roll-back-update)
    [ "${#words[@]}" -eq 2 ] || usage
    roll_back_update "${words[1]}"
    ;;
esac

commit="${SSH_ORIGINAL_COMMAND:-}"
[[ "$commit" =~ ^[0-9a-f]{40}$ ]] || usage

exec 9>"$ROOT/deploy.lock"
flock 9

incoming="$(mktemp -d "$RELEASES/.incoming.XXXXXX")"
trap 'rm -rf "$incoming"' EXIT
head -c "$MAX_BYTES" | tar -xzf - -C "$incoming" --no-same-owner --no-same-permissions
for required in RELEASE api/dist/main.mjs app/index.html; do
  [ -f "$incoming/$required" ] || fail "the release has no $required"
done
[ "$(cat "$incoming/RELEASE")" = "$commit" ] || fail "the release was built from another commit"
chmod -R a+rX,go-w "$incoming"

target="$RELEASES/$commit"
if [ "$(readlink "$ROOT/current" 2>/dev/null)" = "$target" ]; then
  say "$commit is already live"
  exit 0
fi
rm -rf "$target"
mv "$incoming" "$target"
trap '[ "$(readlink "$ROOT/current" 2>/dev/null)" = "$target" ] || rm -rf "$target"' EXIT

previous="$(readlink "$ROOT/current" 2>/dev/null || true)"

point_at() {
  ln -sfn "$1" "$ROOT/current.next"
  mv -T "$ROOT/current.next" "$ROOT/current"
}

healthy() {
  local body
  for _ in $(seq 30); do
    if body="$(curl -fsS --max-time 3 "$HEALTH" 2>/dev/null)" &&
      node -e 'const h = JSON.parse(process.argv[1]); process.exit(h.status === "ok" && h.version === process.argv[2] ? 0 : 1)' "$body" "$commit"; then
      return 0
    fi
    sleep 1
  done
  return 1
}

say "migrating the database"
node "$target/api/dist/main.mjs" migrate

say "starting $commit"
point_at "$target"
sudo -n /usr/bin/systemctl restart sikemux-api

if healthy; then
  say "$commit is live"
  find "$RELEASES" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -printf '%T@ %p\n' | sort -rn | tail -n +$((KEEP + 1)) |
    cut -d' ' -f2- | while read -r old; do
      [ "$old" = "$previous" ] || rm -rf "$old"
    done
  exit 0
fi

say "$commit did not become healthy; its last log lines:"
sudo -n /usr/bin/journalctl -u sikemux-api -n 50 --no-pager || true
if [ -n "$previous" ] && [ "$previous" != "$target" ]; then
  point_at "$previous"
  sudo -n /usr/bin/systemctl restart sikemux-api
  say "rolled back to $(basename "$previous")"
fi
exit 1
