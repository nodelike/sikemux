---
import { render } from "astro:content";
import type { TOCItemType } from "fumadocs-core/toc";
import { Docs } from "@/components/docs";
import { mdxComponents } from "@/components/mdx";
import Layout from "@/components/layout.astro";
import { markdownUrl, source } from "@/lib/source";

export function getStaticPaths() {
  return source.getPages().map((page) => ({
    params: { slug: page.slugs.length > 0 ? page.slugs.join("/") : undefined },
    props: { slugs: page.slugs },
  }));
}

const page = source.getPage(Astro.props.slugs)!;
const { entry, title, description } = page.data;
const { Content, headings } = await render(entry);
const toc: TOCItemType[] = headings.map((heading) => ({
  depth: heading.depth,
  title: heading.text,
  url: `#${heading.slug}`,
}));

const isLanding = page.slugs.length === 0;
const pageUrl = new URL(page.url, Astro.site).href;
const orgId = "https://sikemux.com/#organization";
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": orgId,
  name: "Sikemux",
  alternateName: "sikemux",
  url: "https://sikemux.com/",
  logo: "https://sikemux.com/apple-touch-icon.png",
  sameAs: [
    "https://github.com/nodelike/sikemux",
    "https://x.com/sikemux",
    "https://discord.gg/UKfmHpF9kX",
    "https://apps.apple.com/app/sikemux/id6819588876",
  ],
};
const structuredData: Record<string, unknown>[] = isLanding
  ? [
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://docs.sikemux.com/#website",
        name: "Sikemux docs",
        alternateName: ["Sikemux", "sikemux docs"],
        url: "https://docs.sikemux.com/",
        publisher: { "@id": orgId },
      },
      organization,
    ]
  : [
      {
        "@context": "https://schema.org",
        "@type": "TechArticle",
        headline: title,
        description,
        url: pageUrl,
        isPartOf: { "@type": "WebSite", name: "Sikemux docs", url: "https://docs.sikemux.com/" },
        publisher: organization,
      },
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "Sikemux", item: "https://sikemux.com/" },
          { "@type": "ListItem", position: 2, name: "Docs", item: "https://docs.sikemux.com/" },
          { "@type": "ListItem", position: 3, name: title, item: pageUrl },
        ],
      },
    ];
---

<Layout
  title={isLanding ? "Sikemux docs · own your software factory" : `${title} · Sikemux`}
  description={description}
  structuredData={structuredData}
>
  <Docs
    client:load
    tree={source.getPageTree()}
    pathname={Astro.url.pathname}
    params={Astro.params}
    title={title}
    description={description}
    toc={toc}
    markdownUrl={markdownUrl(page.slugs)}
    kind={page.slugs.length === 0 ? "landing" : "page"}
    editUrl={`https://github.com/nodelike/sikemux/edit/main/docs-site/src/content/docs/${page.path}`}
  >
    <Content components={mdxComponents} />
  </Docs>
</Layout>
