    "Pushes a delete to {remote}. The branch will be gone for everyone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envía una eliminación a {remote}. La rama desaparecerá para todos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "向 {remote} 推送删除。该分支将对所有人消失。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pusht ein Löschen nach {remote}. Der Branch ist dann für alle weg."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pousse une suppression vers {remote}. La branche disparaîtra pour tout le monde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{remote} に削除をプッシュします。ブランチは全員から見えなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{remote}에 삭제를 푸시합니다. 모든 사용자에게서 브랜치가 사라집니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Отправляет удаление в {remote}. Ветка исчезнет для всех."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envia uma exclusão para {remote}. O branch deixará de existir para todos."
          }
        }
      }
    },
    "Put every idle chat to sleep now, freeing its process.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dormir ahora todos los chats inactivos, liberando su proceso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "立即让所有空闲聊天休眠，释放其进程。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle inaktiven Chats jetzt schlafen legen und ihren Prozess freigeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mettre en veille tous les chats inactifs maintenant, ce qui libère leur processus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アイドル状態のチャットをすべて今すぐスリープさせ、プロセスを解放します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "모든 유휴 채팅을 지금 잠자기 상태로 전환하여 프로세스를 해제합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Усыпить все неактивные чаты сейчас и освободить их процессы."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pôr todos os chats inativos para dormir agora, liberando o processo deles."
          }
        }
      }
    },
