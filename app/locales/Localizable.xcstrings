          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sikemux perdeu contato com este host. Tente novamente em instantes."
          }
        }
      }
    },
    "Sikemux notifications are on": {
      "localizations": {
