    "Offered before every launch. Providers without a matching CLI control fall back to their own settings.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proposé avant chaque lancement. Les fournisseurs sans contrôle CLI correspondant utilisent leurs propres réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ofrece antes de cada inicio. Los proveedores sin un control de CLI equivalente usan sus propios ajustes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor jedem Start angeboten. Anbieter ohne passende CLI-Steuerung nutzen ihre eigenen Einstellungen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次启动前提供。没有匹配 CLI 控制项的提供商会回退到其自身设置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動のたびに表示されます。対応する CLI 制御がないプロバイダは独自の設定に従います。"
