    "Close the page, file, pane or tab in front, asking first if an agent is mid-turn": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer la page, le fichier, le panneau ou l'onglet au premier plan, en demandant d'abord si un agent est en plein tour"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar la página, archivo, panel o pestaña al frente, preguntando antes si un agente está a mitad de turno"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seite, Datei, Bereich oder Tab im Vordergrund schließen, mit Rückfrage, wenn ein Agent mitten im Zug ist"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭前方的页面、文件、窗格或标签页；如有智能体正在执行一轮，会先询问"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前面のページ、ファイル、ペイン、タブを閉じる。エージェントがターン中なら先に確認"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞에 있는 페이지, 파일, 패널 또는 탭 닫기. 에이전트가 작업 중이면 먼저 묻습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть страницу, файл, панель или вкладку на переднем плане, спросив, если агент в середине хода"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar a página, arquivo, área ou aba em primeiro plano, perguntando antes se um agente estiver no meio de um turno"
          }
        }
      }
    },
    "Close the project, host or terminal session in front, asking first if agents would stop": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer le projet, l'hôte ou la session de terminal au premier plan, en demandant d'abord si des agents s'arrêteraient"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar el proyecto, host o sesión de terminal al frente, preguntando antes si se detendrían agentes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Projekt, Host oder Terminal-Sitzung im Vordergrund schließen, mit Rückfrage, wenn Agents anhalten würden"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭前方的项目、主机或终端会话；如果会停止智能体，会先询问"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前面のプロジェクト、ホスト、ターミナルセッションを閉じる。エージェントが停止する場合は先に確認"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞에 있는 프로젝트, 호스트 또는 터미널 세션 닫기. 에이전트가 멈추게 되면 먼저 묻습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть проект, хост или сеанс терминала на переднем плане, спросив, если агенты остановятся"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar o projeto, host ou sessão de terminal em primeiro plano, perguntando antes se agentes forem parar"
          }
        }
      }
    },
