    "Add {which}: Shift alone only changes what a key types.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez {which} : Shift seul ne change que ce qu'une touche tape."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade {which}: Shift por sí sola solo cambia lo que escribe una tecla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{which} hinzufügen: Shift allein ändert nur, was eine Taste tippt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 {which}：仅按 Shift 只会改变按键输入的字符。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{which} を追加してください。Shift だけでは入力される文字が変わるだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{which} 추가: Shift만으로는 키가 입력하는 문자만 바뀝니다."
