    "This version, {current}, is older than Sikemux's servers work with now. Remote access and your account stay off until you update to {minimum} or later.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta versión, {current}, es más antigua de lo que admiten ahora los servidores de Sikemux. El acceso remoto y tu cuenta siguen desactivados hasta que actualices a {minimum} o posterior."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此版本 {current} 低于 Sikemux 服务器当前支持的版本。在你更新到 {minimum} 或更高版本前，远程访问和你的账户保持关闭。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Version, {current}, ist älter als das, womit die Server von Sikemux jetzt arbeiten. Fernzugriff und dein Account bleiben aus, bis du auf {minimum} oder neuer aktualisierst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette version, {current}, est plus ancienne que ce que les serveurs de Sikemux acceptent maintenant. L'accès à distance et votre compte restent désactivés jusqu'à la mise à jour vers {minimum} ou ultérieure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このバージョン {current} は、現在の Sikemux サーバが対応するバージョンより古いです。{minimum} 以降にアップデートするまで、リモートアクセスとアカウントはオフのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 버전({current})은 현재 Sikemux 서버가 지원하는 버전보다 오래되었습니다. {minimum} 이상으로 업데이트할 때까지 원격 접속과 계정이 꺼져 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Эта версия, {current}, старше той, с которой сейчас работают серверы Sikemux. Удалённый доступ и ваша учётная запись выключены, пока вы не обновитесь до {minimum} или новее."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta versão, {current}, é mais antiga do que os servidores do Sikemux aceitam agora. O acesso remoto e sua conta ficam desativados até você atualizar para {minimum} ou posterior."
          }
        }
      }
    },
