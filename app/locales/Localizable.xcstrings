    "Sign in to Sikemux to keep what you share from your phone here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à Sikemux pour garder ici ce que vous partagez depuis votre téléphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en Sikemux para guardar aquí lo que compartes desde tu teléfono."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich bei Sikemux an, um hier zu behalten, was du von deinem Telefon teilst."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录 Sikemux 以在此保存你从手机分享的内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンから共有したものをここに保持するには、Sikemux にサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰에서 공유한 항목을 여기에 보관하려면 Sikemux에 로그인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в Sikemux, чтобы сохранять здесь то, чем вы делитесь с телефона."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça login no Sikemux para guardar aqui o que você compartilha do celular."
          }
        }
      }
    },
