            "value": "Répondez ou déposez une capture d'écran · ⏎ envoie et ferme · ⇧⏎ la garde ouverte"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde o suelta una captura · ⏎ envía y cierra · ⇧⏎ la deja abierta"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antworte oder zieh einen Screenshot hinein · ⏎ sendet und schließt · ⇧⏎ lässt es offen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回答或放入截图 · ⏎ 发送并关闭 · ⇧⏎ 保持打开"
