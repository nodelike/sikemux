    "{alias} runs a release of Sikemux too old for this app. Updating runs its own update over your SSH, on the channel it follows, and restarts its core.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{alias} exécute une version de Sikemux trop ancienne pour cette app. Mettre à jour lance sa propre mise à jour via votre SSH, sur le canal qu'il suit, et redémarre son cœur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{alias} ejecuta una versión de Sikemux demasiado antigua para esta app. Al actualizar se ejecuta su propia actualización por tu SSH, en el canal que sigue, y se reinicia su núcleo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf {alias} läuft eine Sikemux-Version, die für diese App zu alt ist. Aktualisieren führt dort sein eigenes Update über dein SSH aus, im Kanal, dem es folgt, und startet seinen Core neu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{alias} 运行的 Sikemux 版本对此应用来说太旧。更新会通过你的 SSH 在其所跟随的频道上运行它自己的更新，并重启其核心。"
          }
        }
      }
    },
