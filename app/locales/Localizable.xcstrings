    "Turn snip mode on or off: each box dragged over the page on the desk in front goes to the chat as a picture": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer ou désactiver le mode capture : chaque cadre tracé sur la page du bureau au premier plan part dans le chat sous forme d'image"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar o desactivar el modo recorte: cada recuadro que arrastres sobre la página del escritorio al frente va al chat como imagen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausschnittmodus ein- oder ausschalten: Jeder Rahmen, den du über die Seite auf dem Schreibtisch im Vordergrund ziehst, geht als Bild an den Chat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启或关闭截取模式：在前方工作台页面上拖出的每个框都会作为图片发送到聊天"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り取りモードのオン/オフ：前面のデスクのページ上でドラッグした範囲が画像としてチャットに送られます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘라내기 모드 켜기/끄기: 앞에 있는 데스크의 페이지 위로 드래그한 각 상자가 그림으로 채팅에 들어갑니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить или выключить режим вырезки: каждая рамка, обведённая на странице стола на переднем плане, уходит в чат картинкой"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativar ou desativar o modo recorte: cada caixa arrastada sobre a página da mesa em primeiro plano vai para o chat como imagem"
          }
        }
      }
    },
