            "value": "Dieser Build aktualisiert sich nicht selbst. Lade jedes neue Release von GitHub."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本不会自动更新。请从 GitHub 下载每个新版本。"
          }
        }
      }
    },
    "This computer is not signed in": {
