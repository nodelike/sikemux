    "Otherwise a request offers Open in Sikemux instead of Deny and Allow.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si no, una solicitud ofrece Abrir en Sikemux en lugar de Denegar y Permitir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "否则，请求会显示“在 Sikemux 中打开”，而不是“拒绝”和“允许”。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sonst bietet eine Anfrage „In Sikemux öffnen“ statt „Ablehnen“ und „Erlauben“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sinon, une demande propose Ouvrir dans Sikemux au lieu de Refuser et Autoriser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "オフの場合、リクエストには「拒否」と「許可」の代わりに「Sikemux で開く」が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "그렇지 않으면 요청에 거부와 허용 대신 Sikemux에서 열기가 표시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Иначе в запросе вместо «Запретить» и «Разрешить» будет «Открыть в Sikemux»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Caso contrário, uma solicitação oferece Abrir no Sikemux em vez de Negar e Permitir."
          }
        }
      }
    },
