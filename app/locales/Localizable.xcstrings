    "What ↵ does mid-turn. {keys} does the other.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que fait ↵ en plein tour. {keys} fait l'autre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué hace ↵ a mitad del turno. {keys} hace lo otro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ↵ mitten im Zug tut. {keys} tut das andere."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一轮进行中 ↵ 的作用。{keys} 执行另一种。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターン中の ↵ の動作。{keys} でもう一方を実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "턴 진행 중 ↵의 동작입니다. {keys}는 다른 동작을 합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
