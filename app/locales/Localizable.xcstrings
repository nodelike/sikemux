          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专为编程智能体推出的月度套餐"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーディングエージェント向けの月額プラン"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코딩 에이전트용 월간 요금제"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ежемесячные тарифы для агентов программирования"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Planos mensais feitos para agentes de programação"
          }
        }
      }
    },
    "Monthly subscriptions made for coding agents. Once its key is saved here, a plan's models show in every chat's model picker, run by an agent that can use them. Keys stay in your Keychain.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des abonnements mensuels conçus pour les agents de code. Une fois sa clé enregistrée ici, les modèles d'un forfait apparaissent dans le sélecteur de modèle de chaque chat, exécutés par un agent qui peut les utiliser. Les clés restent dans votre Keychain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suscripciones mensuales pensadas para agentes de código. Cuando guardas aquí su clave, los modelos del plan aparecen en el selector de modelos de cada chat, ejecutados por un agente que puede usarlos. Las claves se quedan en tu Llavero."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Monatsabos für Coding-Agents. Sobald sein Schlüssel hier gesichert ist, erscheinen die Modelle eines Tarifs in der Modellauswahl jedes Chats, ausgeführt von einem Agent, der sie nutzen kann. Schlüssel bleiben in deiner Keychain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为编程智能体推出的月度订阅。在此保存密钥后，该套餐的模型会出现在每个聊天的模型选择器中，由能使用它们的智能体运行。密钥保存在你的 Keychain 中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーディングエージェント向けの月額サブスクリプション。キーをここに保存すると、そのプランのモデルがすべてのチャットのモデルピッカーに表示され、使用できるエージェントが実行します。キーは Keychain に保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코딩 에이전트용 월간 구독. 여기에 키를 저장하면 요금제의 모델이 모든 채팅의 모델 선택기에 표시되고, 해당 모델을 쓸 수 있는 에이전트가 실행합니다. 키는 키체인에 보관됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ежемесячные подписки для агентов программирования. Когда ключ сохранён здесь, модели тарифа появляются в выборе моделей каждого чата и работают через агента, который умеет их использовать. Ключи остаются в вашей Связке ключей."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assinaturas mensais feitas para agentes de código. Assim que a chave é salva aqui, os modelos do plano aparecem no seletor de modelos de todo chat, executados por um agente que pode usá-los. As chaves ficam no seu Keychain."
          }
        }
      }
    },
