          }
        }
      }
    },
    "Skills": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "技能"
          }
        }
      }
    },
    "Skills every agent Sikemux starts can use, in a terminal or a chat. They live only in Sikemux: the same agents run elsewhere never see them. Agents can make them too, with the skills tool. A new skill loads in the next session.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des skills que chaque agent démarré par Sikemux peut utiliser, dans un terminal ou un chat. Elles n'existent que dans Sikemux : les mêmes agents lancés ailleurs ne les voient jamais. Les agents peuvent aussi en créer, avec l'outil skills. Une nouvelle skill se charge à la session suivante."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills que puede usar cualquier agente que inicie Sikemux, en una terminal o en un chat. Solo existen en Sikemux: los mismos agentes ejecutados en otro sitio nunca las ven. Los agentes también pueden crearlas, con la herramienta de skills. Una skill nueva se carga en la siguiente sesión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills, die jeder von Sikemux gestartete Agent nutzen kann, im Terminal oder im Chat. Sie existieren nur in Sikemux: Dieselben Agents sehen sie anderswo nie. Agents können sie auch erstellen, mit dem Skills-Tool. Ein neuer Skill lädt in der nächsten Sitzung."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux 启动的每个智能体都能使用的技能，无论在终端还是聊天中。它们只存在于 Sikemux 中：在其他地方运行的同一智能体看不到它们。智能体也可以用技能工具创建技能。新技能在下一个会话中载入。"
          }
        }
      }
    },
    "Skills in each agent's global folder. Agents load these inside and outside Sikemux, and Sikemux leaves them alone unless you move one in.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les skills du dossier global de chaque agent. Les agents les chargent dans et hors de Sikemux, et Sikemux n'y touche pas sauf si vous en déplacez une dedans."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills en la carpeta global de cada agente. Los agentes las cargan dentro y fuera de Sikemux, y Sikemux no las toca salvo que muevas una aquí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills im globalen Ordner jedes Agents. Agents laden diese innerhalb und außerhalb von Sikemux, und Sikemux lässt sie in Ruhe, außer du verschiebst einen herein."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各智能体全局文件夹中的技能。智能体在 Sikemux 内外都会载入这些技能，除非你将某个移入，否则 Sikemux 不会改动它们。"
          }
        }
      }
    },
    "Sleep": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veille"
