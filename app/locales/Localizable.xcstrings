    "Apps on this computer, such as Claude Code and Codex in your own terminal, list, start, message and read your chats here. Only apps on this computer can sign in.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps de cet ordinateur, comme Claude Code et Codex dans votre propre terminal, listent, démarrent, écrivent à et lisent vos chats ici. Seules les apps de cet ordinateur peuvent se connecter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps de este ordenador, como Claude Code y Codex en tu propia terminal, listan, inician, envían mensajes y leen tus chats aquí. Solo las apps de este ordenador pueden iniciar sesión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps auf diesem Computer, etwa Claude Code und Codex in deinem eigenen Terminal, können hier deine Chats auflisten, starten, anschreiben und lesen. Nur Apps auf diesem Computer können sich anmelden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此电脑上的应用（例如你自己终端中的 Claude Code 和 Codex）可以在此列出、启动、发送消息和读取你的聊天。只有此电脑上的应用可以登录。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコンピュータ上のアプリ（自分のターミナルで動く Claude Code や Codex など）は、ここでチャットを一覧表示、開始、メッセージ送信、閲覧できます。サインインできるのはこのコンピュータ上のアプリのみです。"
          }
        }
      }
    },
