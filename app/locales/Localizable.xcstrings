            "value": "Jetzt zu aktualisieren stoppt sie und startet sie im selben Chat neu. Was sie gerade taten, stoppt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mettre à jour maintenant les arrête et les redémarre sur le même chat. Ce qu'ils faisaient s'arrête."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "今アップデートするとそれらを停止し、同じチャットで再起動します。実行中の作業は停止します。"
          }
        },
        "ko": {
          "stringUnit": {
