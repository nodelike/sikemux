          }
        }
      }
    },
    "They can run code from the project, such as its build scripts. Only allow them for projects you trust.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pueden ejecutar código del proyecto, como sus scripts de compilación. Permítelos solo en proyectos de confianza."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "它们可以运行项目中的代码，例如构建脚本。仅对你信任的项目允许。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sie können Code aus dem Projekt ausführen, etwa seine Build-Skripte. Erlaube sie nur für Projekte, denen du vertraust."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ils peuvent exécuter du code du projet, comme ses scripts de build. Ne les autorisez que pour les projets de confiance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ビルドスクリプトなど、プロジェクトのコードを実行できます。信頼できるプロジェクトでのみ許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "빌드 스크립트처럼 프로젝트의 코드를 실행할 수 있습니다. 신뢰하는 프로젝트에서만 허용하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Они могут выполнять код из проекта, например его скрипты сборки. Разрешайте их только для проектов, которым доверяете."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eles podem executar código do projeto, como os scripts de compilação. Só permita para projetos em que você confia."
          }
        }
      }
    },
    "They land their own work once its checks pass": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Integran su propio trabajo en cuanto pasan sus comprobaciones"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "检查通过后，它们自行合入工作"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sie landen ihre eigene Arbeit, sobald ihre Checks bestehen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ils intègrent leur propre travail une fois ses contrôles réussis"
