    "Sikemux is on {alias} but not signed in. Signing in runs sikemux login there over your SSH and adds it to your account.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux está en {alias}, pero sin sesión iniciada. Al iniciar sesión se ejecuta sikemux login allí a través de tu SSH y se añade a tu cuenta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{alias} 上有 Sikemux，但未登录。登录会通过你的 SSH 在那里运行 sikemux login，并将其添加到你的账户。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux ist auf {alias}, aber nicht angemeldet. Anmelden führt dort sikemux login über dein SSH aus und fügt es deinem Account hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux est sur {alias} mais n'est pas connecté. Se connecter y lance sikemux login via votre SSH et l'ajoute à votre compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux は {alias} にありますが、サインインしていません。サインインすると、SSH 経由でそこで sikemux login を実行し、アカウントに追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{alias}에 Sikemux가 있지만 로그인되어 있지 않습니다. 로그인하면 SSH를 통해 그곳에서 sikemux login을 실행하고 계정에 추가합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux есть на {alias}, но вход не выполнен. Вход выполнит там sikemux login через ваш SSH и добавит его в вашу учётную запись."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Sikemux está em {alias}, mas sem login. Fazer login executa sikemux login lá pelo seu SSH e o adiciona à sua conta."
          }
        }
