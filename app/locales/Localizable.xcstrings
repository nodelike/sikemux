    "One of your own skills has this name too.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'une de vos propres skills porte aussi ce nom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una de tus propias skills también tiene este nombre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einer deiner eigenen Skills hat auch diesen Namen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你自己的技能中也有一个同名技能。"
