    "Its address, command or name, as the menu shows": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son adresse, sa commande ou son nom, comme le menu l'affiche"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su dirección, comando o nombre, como lo muestra el menú"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Adresse, sein Befehl oder Name, wie das Menü es zeigt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其地址、命令或名称，与菜单中显示一致"
          }
        }
      }
    },
    "Its agents could start agents here, on this host's sign-ins.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses agents pourraient démarrer des agents ici, avec les connexions de cet hôte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus agentes podrían iniciar agentes aquí, con los inicios de sesión de este host."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Agents könnten hier Agents starten, mit den Anmeldungen dieses Hosts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它的智能体可以在此启动智能体，使用此主机的登录。"
          }
        }
      }
    },
    "Its agents could start agents here. Allow or decline it in Sikemux.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses agents pourraient démarrer des agents ici. Autorisez-le ou refusez-le dans Sikemux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus agentes podrían iniciar agentes aquí. Permítelo o recházalo en Sikemux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Agents könnten hier Agents starten. Erlaube oder lehne es in Sikemux ab."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它的智能体可以在此启动智能体。在 Sikemux 中允许或拒绝它。"
          }
        }
      }
    },
    "Its core (pid {pid}) is still running but stopped responding. Restarting it ends its terminals; chats pick up where they were.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son cœur (pid {pid}) tourne encore mais ne répond plus. Le redémarrer ferme ses terminaux ; les chats reprennent où ils en étaient."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su núcleo (pid {pid}) sigue en marcha pero dejó de responder. Al reiniciarlo se cierran sus terminales; los chats siguen donde estaban."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sein Core (PID {pid}) läuft noch, reagiert aber nicht mehr. Ein Neustart beendet seine Terminals; Chats machen dort weiter, wo sie waren."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其核心（pid {pid}）仍在运行，但已停止响应。重启会结束其终端；聊天会从中断处继续。"
          }
        }
      }
    },
    "Its folder moves to the Trash.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son dossier part à la Corbeille."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su carpeta va a la Papelera."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sein Ordner wird in den Papierkorb gelegt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其文件夹将移到废纸篓。"
          }
        }
      }
    },
    "Its name, such as acme.dev on Vercel": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son nom, comme acme.dev sur Vercel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su nombre, como acme.dev en Vercel"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sein Name, etwa acme.dev auf Vercel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其名称，例如 Vercel 上的 acme.dev"
          }
        }
      }
    },
    "Its projects stay open and show under All.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses projets restent ouverts et s'affichent sous Tout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus proyectos siguen abiertos y aparecen en Todo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Projekte bleiben offen und erscheinen unter „Alle“."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其项目保持打开，并显示在“全部”下。"
          }
        }
      }
    },
    "Its terminals and agents stopped with it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses terminaux et agents se sont arrêtés avec lui."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus terminales y agentes se detuvieron con él."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Terminals und Agents wurden mit ihm gestoppt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其终端和智能体已随之停止。"
          }
        }
      }
    },
    "Its unsaved changes are lost.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses modifications non enregistrées sont perdues."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus cambios sin guardar se pierden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine ungesicherten Änderungen gehen verloren."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其未保存的更改将丢失。"
          }
        }
      }
    },
    "Its update did not finish.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa mise à jour ne s'est pas terminée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su actualización no terminó."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sein Update wurde nicht abgeschlossen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其更新未完成。"
          }
        }
      }
    },
    "Jump to latest message": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aller au dernier message"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ir al último mensaje"
          }
