    "Sikemux keeps trying to reach it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux continue d'essayer de l'atteindre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux sigue intentando llegar a él."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux versucht weiter, es zu erreichen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux 会持续尝试连接它。"
          }
        }
      }
    },
    "Sikemux keeps trying.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux continue d'essayer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux sigue intentándolo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux versucht es weiter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux 会持续尝试。"
          }
        }
      }
    },
    "Sikemux keeps your sign-in in the macOS Keychain.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux garde votre connexion dans le Keychain macOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux guarda tu inicio de sesión en el Llavero de macOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux bewahrt deine Anmeldung im macOS-Schlüsselbund auf."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux 将你的登录信息保存在 macOS 钥匙串中。"
          }
        }
      }
    },
    "Sikemux keeps your sign-in where only Sikemux can read it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux garde votre connexion là où seul Sikemux peut la lire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux guarda tu inicio de sesión donde solo Sikemux puede leerlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux bewahrt deine Anmeldung dort auf, wo nur Sikemux sie lesen kann."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux 将你的登录信息保存在只有 Sikemux 能读取的地方。"
          }
        }
      }
    },
    "Sikemux lost touch with this host. Try again in a moment.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux a perdu le contact avec cet hôte. Réessayez dans un instant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux perdió el contacto con este host. Vuelve a intentarlo en un momento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux hat den Kontakt zu diesem Host verloren. Versuch es gleich noch einmal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux 与此主机失去联系。请稍后再试。"
          }
        }
      }
    },
    "Sikemux notifications are on": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications de Sikemux sont activées"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones de Sikemux están activadas"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux-Mitteilungen sind an"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux 通知已开启"
          }
        }
      }
    },
    "Sikemux opened the sign-in page in your default browser.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux a ouvert la page de connexion dans votre navigateur par défaut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux abrió la página de inicio de sesión en tu navegador predeterminado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux hat die Anmeldeseite in deinem Standardbrowser geöffnet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux 已在你的默认浏览器中打开登录页面。"
          }
        }
      }
    },
    "Sikemux runs it on each commit, and agents run it on a card's change when its pull request has no CI.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux l'exécute à chaque commit, et les agents l'exécutent sur la modification d'une carte quand sa pull request n'a pas de CI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux lo ejecuta en cada commit, y los agentes lo ejecutan sobre el cambio de una tarjeta cuando su pull request no tiene CI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux führt es bei jedem Commit aus, und Agents führen es bei der Änderung einer Karte aus, wenn ihr Pull Request keine CI hat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux 会在每次提交时运行它；当卡片的拉取请求没有 CI 时，智能体会对该卡片的更改运行它。"
          }
        }
      }
    },
    "Sikemux runs its commands without asking until the file changes.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux exécute ses commandes sans demander jusqu'à ce que le fichier change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux ejecuta sus comandos sin preguntar hasta que el archivo cambie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux führt seine Befehle ohne Nachfrage aus, bis sich die Datei ändert."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在文件更改之前，Sikemux 会直接运行其命令，不再询问。"
          }
        }
      }
    },
    "Sikemux sends your last message again then. Click to not send it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux renverra alors votre dernier message. Cliquez pour ne pas l'envoyer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux volverá a enviar tu último mensaje entonces. Haz clic para no enviarlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux sendet deine letzte Nachricht dann erneut. Klicke, um sie nicht zu senden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "届时 Sikemux 会重新发送你的上一条消息。点击可取消发送。"
          }
        }
      }
    },
    "Sikemux signal deck": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Panneau de signaux Sikemux"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel de señales de Sikemux"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
