    "Their unsaved changes are lost.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leurs modifications non enregistrées sont perdues."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus cambios sin guardar se pierden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre ungesicherten Änderungen gehen verloren."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它们未保存的更改将丢失。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されていない変更は失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장되지 않은 변경 사항이 사라집니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Их несохранённые изменения будут потеряны."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações não salvas deles são perdidas."
          }
        }
      }
    },
