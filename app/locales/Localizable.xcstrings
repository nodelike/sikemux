          }
        }
      }
    },
    "Sikemux asks before it runs any of its commands.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux demande avant d'exécuter l'une de ses commandes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux pregunta antes de ejecutar cualquiera de sus comandos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux fragt, bevor es einen seiner Befehle ausführt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux 运行其任何命令前都会先询问。"
          }
        }
      }
    },
    "Sikemux could not sign in: {error}": {
      "localizations": {
        "fr": {
