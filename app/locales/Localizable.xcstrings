          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta algo? Diga a qualquer agente, ou adicione aqui."
          }
        }
      }
    },
    "Something other than Sikemux changed this host's list of devices, so it stopped trusting it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose d'autre que Sikemux a modifié la liste des appareils de cet hôte, il a donc cessé de lui faire confiance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo distinto de Sikemux cambió la lista de dispositivos de este host, así que dejó de confiar en ella."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas anderes als Sikemux hat die Geräteliste dieses Hosts geändert, daher vertraut er ihr nicht mehr."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux 以外的程序更改了此主机的设备列表，因此它不再信任该列表。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux 以外のものがこのホストのデバイスリストを変更したため、信頼を停止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux가 아닌 다른 무언가가 이 호스트의 기기 목록을 변경해서 더 이상 신뢰하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что-то помимо Sikemux изменило список устройств этого хоста, поэтому он перестал ему доверять."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo além do Sikemux alterou a lista de dispositivos deste host, então ele deixou de confiar nela."
          }
        }
      }
    },
    "Something other than Sikemux changed this host's list of devices, so it stopped trusting it. It named {names} and {last}.": {
