          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} crea una copia de trabajo nueva desde su remoto, o desde {from} cuando no puede llegar al remoto, con los cambios sin commit de allí como un commit encima."
          }
        }
      }
    },
    "{label} makes a new checkout of it from its remote, or from {from} when it cannot reach the remote. Only what is committed goes over; uncommitted changes stay there.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} en crée un nouveau checkout depuis son remote, ou depuis {from} quand il ne peut pas atteindre le remote. Seul ce qui est commité est transféré ; les modifications non commitées restent là-bas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} crea una copia de trabajo nueva desde su remoto, o desde {from} cuando no puede llegar al remoto. Solo se lleva lo que tiene commit; los cambios sin commit se quedan allí."
