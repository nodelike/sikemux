    "Only the Command Line Tools are selected, and simulators need Xcode. Install Xcode, or choose it with xcode-select.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo están seleccionadas las Command Line Tools y los simuladores necesitan Xcode. Instala Xcode o elígelo con xcode-select."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅选择了 Command Line Tools，而模拟器需要 Xcode。请安装 Xcode，或用 xcode-select 选择它。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nur die Command Line Tools sind ausgewählt, und Simulatoren brauchen Xcode. Installiere Xcode oder wähle es mit xcode-select."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seuls les Command Line Tools sont sélectionnés, et les simulateurs ont besoin de Xcode. Installez Xcode, ou choisissez-le avec xcode-select."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Command Line Tools のみが選択されていますが、シミュレータには Xcode が必要です。Xcode をインストールするか、xcode-select で選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Command Line Tools만 선택되어 있는데 시뮬레이터에는 Xcode가 필요합니다. Xcode를 설치하거나 xcode-select로 선택하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выбраны только Command Line Tools, а симуляторам нужен Xcode. Установите Xcode или выберите его с помощью xcode-select."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Só as Command Line Tools estão selecionadas, e os simuladores precisam do Xcode. Instale o Xcode ou escolha-o com xcode-select."
          }
        }
      }
