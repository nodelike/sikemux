    "Try a shorter term or adjust the case, pattern, and file filters above.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prueba con un término más corto o ajusta los filtros de mayúsculas, patrón y archivos de arriba."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "尝试更短的词，或调整上方的大小写、模式和文件过滤条件。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Versuche einen kürzeren Begriff oder passe oben Groß-/Kleinschreibung, Muster und Dateifilter an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Essayez un terme plus court ou ajustez la casse, le motif et les filtres de fichiers ci-dessus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "短い語句を試すか、上の大文字小文字、パターン、ファイルフィルタを調整してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "더 짧은 검색어를 사용하거나 위의 대소문자, 패턴, 파일 필터를 조정하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Попробуйте более короткий запрос или измените регистр, шаблон и фильтры файлов выше."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tente um termo mais curto ou ajuste os filtros de maiúsculas, padrão e arquivos acima."
          }
        }
      }
    },
