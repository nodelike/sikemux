    "Your phone finds this host through it. Sign in with Google, GitHub or your email, in your browser.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre téléphone trouve cet hôte par ce biais. Connectez-vous avec Google, GitHub ou votre e-mail, dans votre navigateur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu teléfono encuentra este host a través de ella. Inicia sesión con Google, GitHub o tu correo, en tu navegador."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Telefon findet diesen Host darüber. Melde dich mit Google, GitHub oder deiner E-Mail in deinem Browser an."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的手机通过它找到此主机。在浏览器中用 Google、GitHub 或你的电子邮件登录。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンはこれを介してこのホストを見つけます。ブラウザで Google、GitHub、またはメールでサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰은 이를 통해 이 호스트를 찾습니다. 브라우저에서 Google, GitHub 또는 이메일로 로그인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Через неё ваш телефон находит этот хост. Войдите через Google, GitHub или по электронной почте в браузере."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu celular encontra este host por meio dela. Faça login com Google, GitHub ou seu e-mail, no navegador."
          }
        }
      }
    },
