    "Compact fits more sessions while keeping every state symbol visible.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compact affiche plus de sessions tout en gardant chaque symbole d'état visible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo compacto muestra más sesiones y mantiene visibles todos los símbolos de estado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompakt zeigt mehr Sitzungen und lässt jedes Statussymbol sichtbar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "紧凑模式可容纳更多会话，同时保留所有状态符号。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンパクトでは、すべての状態記号を表示したまま、より多くのセッションを表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "간결하게는 모든 상태 기호를 유지하면서 더 많은 세션을 표시합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компактный режим вмещает больше сеансов и сохраняет все значки состояния."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo compacto mostra mais sessões e mantém visíveis todos os símbolos de estado."
          }
        }
      }
    },
