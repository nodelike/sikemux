    "Updating now stops it and starts it again on the same chat. Whatever it was doing stops.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre à jour maintenant l'arrête et le redémarre sur le même chat. Ce qu'il faisait s'arrête."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al actualizar ahora se detiene y vuelve a empezar en el mismo chat. Lo que estuviera haciendo se detiene."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt zu aktualisieren stoppt ihn und startet ihn im selben Chat neu. Was er gerade tat, stoppt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在更新会停止它，并在同一聊天上重新启动。它正在做的事会中止。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今アップデートすると停止し、同じチャットで再起動します。実行中の作業は停止します。"
          }
        }
      }
    },
    "Updating now stops them and starts them again on the same chat. Whatever they were doing stops.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre à jour maintenant les arrête et les redémarre sur le même chat. Ce qu'ils faisaient s'arrête."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al actualizar ahora se detienen y vuelven a empezar en el mismo chat. Lo que estuvieran haciendo se detiene."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt zu aktualisieren stoppt sie und startet sie im selben Chat neu. Was sie gerade taten, stoppt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在更新会停止它们，并在同一聊天上重新启动。它们正在做的事会中止。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今アップデートするとそれらを停止し、同じチャットで再起動します。実行中の作業は停止します。"
          }
        }
      }
    },
