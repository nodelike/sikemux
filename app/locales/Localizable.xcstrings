          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ {provider} меняют админы {org}."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os admins de {org} alteram a chave de {provider}."
          }
        }
      }
    },
    "{org}'s plan has lapsed, so its keys are paused and no chat can pick them. Nothing was deleted: they come back when an owner renews.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'abonnement de {org} a expiré, ses clés sont donc suspendues et aucun chat ne peut les choisir. Rien n'a été supprimé : elles reviennent quand un propriétaire renouvelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan de {org} ha caducado, así que sus claves están en pausa y ningún chat puede elegirlas. No se eliminó nada: vuelven cuando un propietario renueve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tarif von {org} ist abgelaufen, daher sind seine Schlüssel pausiert und kein Chat kann sie wählen. Nichts wurde gelöscht: Die Schlüssel kommen zurück, wenn ein Inhaber verlängert."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{org} 的套餐已失效，因此它的密钥已暂停，任何聊天都无法选用。没有删除任何内容：所有者续订后即可恢复。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{org} のプランが失効したため、キーは一時停止され、チャットでは選べません。削除されたものはなく、オーナーが更新すると元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{org}의 요금제가 만료되어 키가 일시 정지되었고 어떤 채팅도 사용할 수 없습니다. 삭제된 것은 없으며, 소유자가 갱신하면 다시 사용할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тариф {org} истёк, поэтому его ключи приостановлены и ни один чат не может их выбрать. Ничего не удалено: они вернутся, когда владелец продлит тариф."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano de {org} venceu, então as chaves estão pausadas e nenhum chat pode escolhê-las. Nada foi excluído: elas voltam quando um proprietário renovar."
          }
        }
      }
    },
