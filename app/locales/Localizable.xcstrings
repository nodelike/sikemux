    "Its projects stay open and show under All.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sus proyectos siguen abiertos y aparecen en Todo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "其项目保持打开，并显示在“全部”下。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seine Projekte bleiben offen und erscheinen unter „Alle“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ses projets restent ouverts et s'affichent sous Tout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "プロジェクトは開いたままで、「すべて」の下に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
