        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sprachhelfer hat gestoppt. Halte die Taste erneut, um ihn neu zu starten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音辅助程序已停止。再次按住该键以重新启动。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声ヘルパーが停止しました。もう一度キーを長押しすると再起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 도우미가 중지되었습니다. 다시 시작하려면 키를 다시 길게 누르세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голосовой помощник остановился. Снова удерживайте клавишу, чтобы перезапустить его."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O auxiliar de voz parou. Segure a tecla de novo para reiniciá-lo."
          }
        }
      }
    },
    "The window closed.": {
