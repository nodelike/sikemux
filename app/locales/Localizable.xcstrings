    "Models served on this host by Ollama or LM Studio. They need no key, and nothing leaves this host.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des modèles servis sur cet hôte par Ollama ou LM Studio. Ils ne demandent aucune clé, et rien ne quitte cet hôte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelos servidos en este host por Ollama o LM Studio. No necesitan clave y nada sale de este host."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelle, die auf diesem Host von Ollama oder LM Studio bereitgestellt werden. Sie brauchen keinen Schlüssel, und nichts verlässt diesen Host."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由 Ollama 或 LM Studio 在此主机上提供的模型。无需密钥，任何内容都不会离开此主机。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このホストで Ollama または LM Studio が提供するモデル。キーは不要で、何もこのホストの外に出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 호스트에서 Ollama나 LM Studio로 제공하는 모델. 키가 필요 없으며 어떤 데이터도 이 호스트를 벗어나지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модели, обслуживаемые на этом хосте через Ollama или LM Studio. Ключ не нужен, и ничто не покидает этот хост."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelos servidos neste host pelo Ollama ou LM Studio. Não precisam de chave, e nada sai deste host."
          }
        }
      }
    },
