    "Moves HEAD to this commit and discards all later changes from the index and working tree.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mueve HEAD a este commit y descarta todos los cambios posteriores del índice y del árbol de trabajo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将 HEAD 移到此提交，并从索引和工作树中丢弃之后的所有更改。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Setzt HEAD auf diesen Commit und verwirft alle späteren Änderungen aus Index und Arbeitsverzeichnis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Déplace HEAD vers ce commit et abandonne toutes les modifications ultérieures de l'index et de la copie de travail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HEAD をこのコミットに移動し、以降の変更をすべてインデックスと作業ツリーから破棄します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HEAD를 이 커밋으로 옮기고 이후의 모든 변경 사항을 인덱스와 작업 트리에서 버립니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перемещает HEAD на этот коммит и отбрасывает все последующие изменения из индекса и рабочего дерева."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Move o HEAD para este commit e descarta todas as alterações posteriores do índice e da árvore de trabalho."
          }
        }
      }
    },
    "Moves HEAD to this commit and keeps all later changes in the working tree.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mueve HEAD a este commit y conserva todos los cambios posteriores en el árbol de trabajo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将 HEAD 移到此提交，并在工作树中保留之后的所有更改。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Setzt HEAD auf diesen Commit und behält alle späteren Änderungen im Arbeitsverzeichnis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Déplace HEAD vers ce commit et garde toutes les modifications ultérieures dans la copie de travail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HEAD をこのコミットに移動し、以降の変更をすべて作業ツリーに保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HEAD를 이 커밋으로 옮기고 이후의 모든 변경 사항을 작업 트리에 유지합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перемещает HEAD на этот коммит и сохраняет все последующие изменения в рабочем дереве."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Move o HEAD para este commit e mantém todas as alterações posteriores na árvore de trabalho."
          }
        }
      }
    },
    "Moves HEAD to this commit and keeps all later changes staged.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mueve HEAD a este commit y deja todos los cambios posteriores preparados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将 HEAD 移到此提交，并将之后的所有更改保持为已暂存。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Setzt HEAD auf diesen Commit und behält alle späteren Änderungen gestagt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Déplace HEAD vers ce commit et garde toutes les modifications ultérieures indexées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HEAD をこのコミットに移動し、以降の変更をすべてステージ済みのまま保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HEAD를 이 커밋으로 옮기고 이후의 모든 변경 사항을 스테이징된 상태로 유지합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перемещает HEAD на этот коммит и оставляет все последующие изменения проиндексированными."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Move o HEAD para este commit e mantém todas as alterações posteriores preparadas."
          }
        }
      }
    },
    "Moves it out of {folder}, so {agent} outside Sikemux no longer has it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lo saca de {folder}, así que {agent} fuera de Sikemux ya no lo tiene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将其移出 {folder}，Sikemux 之外的 {agent} 将不再拥有它。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verschiebt es aus {folder}, sodass {agent} außerhalb von Sikemux es nicht mehr hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le sort de {folder}, pour que {agent} hors de Sikemux ne l'ait plus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{folder} から移動するため、Sikemux 外の {agent} からは使えなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{folder}에서 옮기므로 Sikemux 밖의 {agent}에서는 더 이상 사용할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перемещает его из {folder}, поэтому {agent} вне Sikemux больше не сможет его использовать."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tira de {folder}, então {agent} fora do Sikemux não o terá mais."
          }
        }
      }
    },
