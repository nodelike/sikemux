    "Auto mode — {agent}'s reviewer approves safe actions and asks you the rest.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode auto — le relecteur de {agent} approuve les actions sûres et vous demande le reste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo automático: el revisor de {agent} aprueba las acciones seguras y te pregunta el resto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-Modus – der Prüfer von {agent} genehmigt sichere Aktionen und fragt dich den Rest."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动模式 — {agent} 的审阅者批准安全操作，其余询问你。"
