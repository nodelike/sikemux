    "Every file goes back to what is staged or committed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque fichier revient à son état indexé ou commité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los archivos vuelven a lo que está preparado o con commit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Datei kehrt zum gestagten oder committeten Stand zurück."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个文件都将恢复到已暂存或已提交的状态。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのファイルがステージ済みまたはコミット済みの状態に戻ります。"
          }
        }
      }
    },
    "Every hour": {
