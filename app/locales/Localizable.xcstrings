    "Must match a running app’s name. A trailing .app is fine.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Debe coincidir con el nombre de una app en ejecución. Se admite un .app al final."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "必须与正在运行的应用名称一致。可以带结尾的 .app。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Muss dem Namen einer laufenden App entsprechen. Ein angehängtes .app ist okay."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Doit correspondre au nom d'une app en cours d'exécution. Un .app final est accepté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "実行中のアプリの名前と一致する必要があります。末尾の .app はあってもかまいません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "실행 중인 앱의 이름과 일치해야 합니다. 끝에 .app을 붙여도 됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Должно совпадать с именем запущенного приложения. Окончание .app допускается."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deve corresponder ao nome de um app em execução. Um .app no final é aceito."
          }
        }
      }
    },
