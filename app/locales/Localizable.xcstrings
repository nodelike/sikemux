    "This build does not update itself. Download each new release from GitHub.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce build ne se met pas à jour tout seul. Téléchargez chaque nouvelle version depuis GitHub."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilación no se actualiza sola. Descarga cada nueva versión desde GitHub."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Build aktualisiert sich nicht selbst. Lade jedes neue Release von GitHub."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本不会自动更新。请从 GitHub 下载每个新版本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドは自動アップデートしません。新しいリリースは GitHub からダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드는 자동으로 업데이트되지 않습니다. 새 릴리스는 GitHub에서 다운로드하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта сборка не обновляется сама. Загружайте каждый новый выпуск с GitHub."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilação não se atualiza sozinha. Baixe cada nova versão no GitHub."
          }
        }
      }
    },
    "This computer is not signed in": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet ordinateur n'est pas connecté"
          }
        },
        "es": {
