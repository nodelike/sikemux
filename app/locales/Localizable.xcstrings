          "stringUnit": {
            "state": "translated",
            "value": "El revisor propio del agente aprueba las acciones seguras y te pregunta las arriesgadas. Los agentes sin revisor se ejecutan como Normal."
          }
        },
        "de": {
          "stringUnit": {
