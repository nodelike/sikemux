    "Dictation is on. The speech model downloads once, about 600 MB, then click the microphone again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dictée est activée. Le modèle vocal se télécharge une fois, environ 600 Mo, puis cliquez à nouveau sur le micro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dictado está activado. El modelo de voz se descarga una vez, unos 600 MB; después vuelve a hacer clic en el micrófono."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktat ist an. Das Sprachmodell wird einmal geladen, etwa 600 MB; klicke danach erneut auf das Mikrofon."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "听写已开启。语音模型只需下载一次，约 600 MB，之后再次点击麦克风。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力がオンです。音声モデル（約 600 MB）を一度だけダウンロードしたら、もう一度マイクをクリックしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기가 켜졌습니다. 음성 모델을 한 번 다운로드한 후(약 600 MB) 마이크를 다시 클릭하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктовка включена. Речевая модель загружается один раз, около 600 МБ, затем снова нажмите на микрофон."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ditado está ativado. O modelo de fala é baixado uma vez, cerca de 600 MB; depois clique no microfone novamente."
          }
        }
      }
    },
    "Dirty worktrees will be refused.": {
      "localizations": {
        "fr": {
          "stringUnit": {
