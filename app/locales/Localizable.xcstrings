    "Something missing? Tell any agent, or add it here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il manque quelque chose ? Dites-le à n'importe quel agent, ou ajoutez-le ici."
