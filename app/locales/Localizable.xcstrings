    "When the project folder holds several repositories, its Git pane, the branch in the top bar, the diff pane and new agent worktrees use this one.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand le dossier du projet contient plusieurs dépôts, son panneau Git, la branche de la barre supérieure, le panneau de diff et les worktrees des nouveaux agents utilisent celui-ci."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando la carpeta del proyecto contiene varios repositorios, su panel de Git, la rama de la barra superior, el panel de diff y los worktrees de agentes nuevos usan este."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der Projektordner mehrere Repositorys enthält, nutzen sein Git-Bereich, der Branch in der oberen Leiste, der Diff-Bereich und neue Agent-Worktrees dieses."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当项目文件夹包含多个仓库时，其 Git 窗格、顶栏中的分支、差异窗格和新智能体工作树都使用此仓库。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトフォルダに複数のリポジトリがある場合、Git ペイン、トップバーのブランチ、差分ペイン、新しいエージェントのワークツリーはこのリポジトリを使用します。"
          }
        }
      }
    },
