    "{name} asks to {writes}. It may do so whenever it is open, until its mod.json asks for more. Settings, Mods takes this back.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{name} pide {writes}. Puede hacerlo siempre que esté abierto, hasta que su mod.json pida más. Ajustes, Mods lo revoca."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{name} 请求{writes}。在其 mod.json 请求更多权限之前，它打开时随时可以这样做。可在“设置 → 模组”中收回。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{name} möchte {writes}. Es darf das tun, solange es offen ist, bis seine mod.json mehr verlangt. Unter Einstellungen › Mods lässt sich das zurücknehmen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{name} demande à {writes}. Il peut le faire à tout moment quand il est ouvert, jusqu'à ce que son mod.json en demande davantage. Réglages, Mods permet de le révoquer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{name} が {writes} を求めています。開いている間はいつでも実行でき、mod.json がさらに求めるまで有効です。「設定」の「Mod」で取り消せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{name}이(가) {writes} 권한을 요청합니다. mod.json에서 더 많은 권한을 요청할 때까지 열려 있는 동안 언제든 그렇게 할 수 있습니다. 설정 > 모드에서 철회할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{name} просит {writes}. Он может делать это всякий раз, когда открыт, пока его mod.json не запросит большего. Отозвать можно в Настройки → Моды."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{name} pede para {writes}. Ele pode fazer isso sempre que estiver aberto, até que o mod.json dele peça mais. Configurações › Mods revoga isso."
          }
        }
      }
    },
