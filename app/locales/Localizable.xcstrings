        }
      }
    },
    "Start language servers for {folder}? They can run code from this project, such as its build scripts and installed tools. Only allow this for projects you trust.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Iniciar servidores de lenguaje para {folder}? Pueden ejecutar código de este proyecto, como sus scripts de compilación y herramientas instaladas. Permítelo solo en proyectos de confianza."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "为 {folder} 启动语言服务器？它们可以运行此项目中的代码，例如构建脚本和已安装的工具。仅对你信任的项目允许。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sprachserver für {folder} starten? Sie können Code aus diesem Projekt ausführen, etwa seine Build-Skripte und installierten Tools. Erlaube das nur für Projekte, denen du vertraust."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Démarrer les serveurs de langage pour {folder} ? Ils peuvent exécuter du code de ce projet, comme ses scripts de build et ses outils installés. N'autorisez ceci que pour les projets de confiance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{folder} の言語サーバを開始しますか？言語サーバはビルドスクリプトやインストール済みのツールなど、このプロジェクトのコードを実行できます。信頼できるプロジェクトでのみ許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{folder}의 언어 서버를 시작하시겠습니까? 빌드 스크립트나 설치된 도구처럼 이 프로젝트의 코드를 실행할 수 있습니다. 신뢰하는 프로젝트에서만 허용하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запустить языковые серверы для {folder}? Они могут выполнять код из этого проекта, например его скрипты сборки и установленные инструменты. Разрешайте это только для проектов, которым доверяете."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Iniciar servidores de linguagem para {folder}? Eles podem executar código deste projeto, como os scripts de compilação e as ferramentas instaladas. Só permita isso em projetos em que você confia."
          }
        }
      }
    },
