    "There is no repository in this folder or the folders directly inside it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No hay ningún repositorio en esta carpeta ni en las carpetas que contiene directamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此文件夹及其直接子文件夹中都没有仓库。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In diesem Ordner oder den Ordnern direkt darin gibt es kein Repository."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il n'y a aucun dépôt dans ce dossier ni dans les dossiers qu'il contient directement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このフォルダにも、その直下のフォルダにもリポジトリはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 폴더나 바로 안에 있는 폴더에 저장소가 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "В этой папке и в папках непосредственно внутри неё нет репозитория."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
