          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Его проекты остаются открытыми и показываются в разделе «Все»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os projetos continuam abertos e aparecem em Todos."
          }
        }
      }
    },
    "Its terminals and agents stopped with it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sus terminales y agentes se detuvieron con él."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "其终端和代理已随之停止。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seine Terminals und Agents wurden mit ihm gestoppt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ses terminaux et agents se sont arrêtés avec lui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ターミナルとエージェントも一緒に停止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
