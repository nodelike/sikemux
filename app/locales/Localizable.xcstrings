            "state": "translated",
            "value": "O Sikemux não tem permissão para ler {path}"
          }
        }
      }
    },
    "Sikemux keeps trying to reach it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux continue d'essayer de l'atteindre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux sigue intentando llegar a él."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux versucht weiter, es zu erreichen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux 会持续尝试连接它。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
