    "1 new file is deleted and the rest go back to what is staged or committed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se elimina 1 archivo nuevo y el resto vuelve a lo que está preparado o confirmado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 个新文件将被删除，其余恢复到已暂存或已提交的状态。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 neue Datei wird gelöscht, der Rest kehrt zum gestagten oder committeten Stand zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 nouveau fichier est supprimé et les autres reviennent à leur état indexé ou commité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "新しいファイル 1 件が削除され、残りはステージ済みまたはコミット済みの状態に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "새 파일 1개가 삭제되고 나머지는 스테이징되거나 커밋된 상태로 되돌아갑니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 новый файл будет удалён, а остальные вернутся к проиндексированному или закоммиченному состоянию."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 arquivo novo é excluído e o resto volta ao que está preparado ou no commit."
          }
        }
      }
    },
