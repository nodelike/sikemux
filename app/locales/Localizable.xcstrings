    "Sign-in stopped. Its output is on the right.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion arrêtée. Sa sortie est à droite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión se detuvo. Su salida está a la derecha."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldung gestoppt. Ihre Ausgabe steht rechts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录已停止。其输出在右侧。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインが停止しました。出力は右側にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인이 중지되었습니다. 출력은 오른쪽에 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход остановлен. Его вывод справа."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O login parou. A saída está à direita."
          }
        }
      }
    },
    "Sign-ins on this host move into the account's vault, sealed so the accounts server cannot read them, and every host on the account can use them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les connexions de cet hôte vont dans le coffre du compte, scellées pour que le serveur de comptes ne puisse pas les lire, et chaque hôte du compte peut les utiliser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los inicios de sesión de este host pasan a la bóveda de la cuenta, sellados para que el servidor de cuentas no pueda leerlos, y todos los hosts de la cuenta pueden usarlos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldungen auf diesem Host wandern in den Tresor des Accounts, versiegelt, sodass der Account-Server sie nicht lesen kann, und jeder Host des Accounts kann sie nutzen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此主机上的登录信息会移入账户保险库并加密密封，账户服务器无法读取，账户中的每台主机都可以使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このホストのサインインはアカウントの保管庫に移され、アカウントサーバが読めないよう封印されます。アカウントのどのホストでも使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 호스트의 로그인 정보는 계정 보관함으로 옮겨지며, 계정 서버가 읽을 수 없도록 봉인됩니다. 계정의 모든 호스트가 사용할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Входы на этом хосте переносятся в хранилище учётной записи и запечатываются так, что сервер учётных записей не может их прочитать, и ими может пользоваться любой хост учётной записи."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os logins deste host vão para o cofre da conta, selados para que o servidor de contas não consiga lê-los, e todos os hosts da conta podem usá-los."
          }
        }
      }
    },
