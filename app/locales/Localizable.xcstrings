          "stringUnit": {
            "state": "translated",
            "value": "Installez un agent ou connectez-vous à un agent pour continuer. {agent} est gratuit, sans compte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala o inicia sesión en un agente para continuar. {agent} es gratis y sin cuenta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere einen Agent oder melde dich bei einem an, um fortzufahren. {agent} ist kostenlos, ohne Account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装或登录一个智能体以继续。{agent} 免费且无需账户。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続けるには、エージェントを1つインストールするかサインインしてください。{agent} は無料でアカウント不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하려면 에이전트 하나를 설치하거나 로그인하세요. {agent}은(는) 무료이며 계정이 필요 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы продолжить, установите агента или войдите в него. {agent} бесплатен и не требует учётной записи."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale ou faça login em um agente para continuar. O {agent} é grátis e sem conta."
          }
        }
      }
    },
