    "Resting waits a moment, so passing the pointer across the menu bar does not open it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Al detenerse espera un momento, así que pasar el puntero por la barra de menús no la abre."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "停留时会稍等片刻，因此指针划过菜单栏时不会打开它。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verweilen wartet kurz, damit das Überfahren der Menüleiste sie nicht öffnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le survol attend un instant, pour que passer le pointeur sur la barre des menus ne l'ouvre pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ポインタを止めると少し待ってから開くので、メニューバーを横切っただけでは開きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "포인터를 멈추면 잠시 기다리므로, 메뉴 막대를 지나가기만 해서는 열리지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Задержка указателя ждёт немного, поэтому островок не открывается, если просто провести через строку меню."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ao parar, espera um instante, então passar o ponteiro pela barra de menus não a abre."
          }
        }
      }
    },
