    "Sign in to your account on another Sikemux host to link it, then send projects there.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inicia sesión en tu cuenta en otro host de Sikemux para enlazarlo y luego envía proyectos allí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在另一台 Sikemux 主机上登录你的账户以关联它，然后将项目发送到那里。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Melde dich auf einem anderen Sikemux-Host bei deinem Account an, um ihn zu verknüpfen, und sende dann Projekte dorthin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connectez-vous à votre compte sur un autre hôte Sikemux pour le lier, puis envoyez-y des projets."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "別の Sikemux ホストでアカウントにサインインしてリンクし、プロジェクトをそこに送ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "다른 Sikemux 호스트에서 계정에 로그인하여 연결한 다음 프로젝트를 그곳으로 보내세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Войдите в свою учётную запись на другом хосте Sikemux, чтобы связать его, и отправляйте туда проекты."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Entre na sua conta em outro host do Sikemux para vinculá-lo e depois envie projetos para lá."
          }
        }
      }
    },
