          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna app ha iniciado sesión todavía. Cuando una lo haga, Sikemux te preguntará si dejarla entrar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch hat sich keine App angemeldet. Wenn eine es tut, fragt Sikemux dich, ob sie hereindarf."
          }
        },
        "zh-Hans": {
