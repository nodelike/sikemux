        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La isla crece un momento sin abrirse."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "岛会短暂变大但不打开。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Insel wächst kurz, ohne sich zu öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'îlot grandit un instant sans s'ouvrir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アイランドが開かずに一瞬大きくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
