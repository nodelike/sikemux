        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Entwurf hat sich während der Erzeugung geändert. Er wurde behalten; erzeuge erneut, wenn du so weit bist."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
