        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "更新期间工作中的代理会继续运行，但这个代理仍在启动或正处于请求中。它就绪后更新会自动安装。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arbeitende Agents laufen während eines Updates weiter, aber dieser startet noch oder ist mitten in einer Anfrage. Das Update installiert sich von selbst, sobald er bereit ist."
