          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist zu groß, um sie von ihrem Host zu holen."
          }
        }
      }
    },
    "This folder": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
