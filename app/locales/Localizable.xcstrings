    "Read from package.json, Cargo, Maven, Gradle and the rest; change those files to change these.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lu depuis package.json, Cargo, Maven, Gradle et les autres ; modifiez ces fichiers pour modifier ceci."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leído de package.json, Cargo, Maven, Gradle y los demás; cambia esos archivos para cambiar estos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus package.json, Cargo, Maven, Gradle und den übrigen gelesen; ändere diese Dateien, um diese hier zu ändern."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 package.json、Cargo、Maven、Gradle 等文件读取；修改这些文件即可更改此处。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "package.json、Cargo、Maven、Gradle などから読み取ります。変更するにはそれらのファイルを変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "package.json, Cargo, Maven, Gradle 등에서 읽습니다. 바꾸려면 해당 파일을 변경하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитано из package.json, Cargo, Maven, Gradle и других; чтобы изменить это, измените те файлы."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lido de package.json, Cargo, Maven, Gradle e o resto; altere esses arquivos para alterar estes."
          }
        }
      }
    },
