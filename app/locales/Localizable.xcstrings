        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置所有已用完的额度。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使い切ったすべての上限をリセットします。"
          }
        }
      }
    },
