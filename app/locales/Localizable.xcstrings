    },
    "Something missing? Tell any agent, or add it here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il manque quelque chose ? Dites-le à n'importe quel agent, ou ajoutez-le ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Falta algo? Díselo a cualquier agente, o añádelo aquí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlt etwas? Sag es einem Agent oder füge es hier hinzu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少什么？告诉任意智能体，或在此添加。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "足りないものがありますか？エージェントに伝えるか、ここで追加してください。"
          }
        }
      }
    },
    "Something other than Sikemux changed this host's list of devices, so it stopped trusting it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose d'autre que Sikemux a modifié la liste des appareils de cet hôte, il a donc cessé de lui faire confiance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo distinto de Sikemux cambió la lista de dispositivos de este host, así que dejó de confiar en ella."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas anderes als Sikemux hat die Geräteliste dieses Hosts geändert, daher vertraut er ihr nicht mehr."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux 以外的程序更改了此主机的设备列表，因此它不再信任该列表。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux 以外のものがこのホストのデバイスリストを変更したため、信頼を停止しました。"
          }
        }
      }
    },
    "Something other than Sikemux changed this host's list of devices, so it stopped trusting it. It named {names} and {last}.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose d'autre que Sikemux a modifié la liste des appareils de cet hôte, il a donc cessé de lui faire confiance. Elle nommait {names} et {last}."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo distinto de Sikemux cambió la lista de dispositivos de este host, así que dejó de confiar en ella. Nombraba {names} y {last}."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas anderes als Sikemux hat die Geräteliste dieses Hosts geändert, daher vertraut er ihr nicht mehr. Sie nannte {names} und {last}."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux 以外的程序更改了此主机的设备列表，因此它不再信任该列表。其中列出了 {names} 和 {last}。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux 以外のものがこのホストのデバイスリストを変更したため、信頼を停止しました。{names} と {last} が記載されていました。"
          }
        }
      }
    },
