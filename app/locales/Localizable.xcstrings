      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos propres skills"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus propias habilidades"
          }
        },
        "de": {
          "stringUnit": {
