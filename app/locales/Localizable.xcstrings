    "Watch them work, answer what they ask and start new chats from anywhere.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Míralos trabajar, responde lo que preguntan e inicia chats nuevos desde cualquier lugar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "随时随地观看它们工作、回答它们的问题并开始新聊天。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sieh ihnen bei der Arbeit zu, beantworte ihre Fragen und starte neue Chats von überall."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Regardez-les travailler, répondez à leurs questions et démarrez de nouveaux chats de n'importe où."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "どこからでも作業を見守り、質問に答え、新しいチャットを開始できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "어디서나 작업을 지켜보고, 질문에 답하고, 새 채팅을 시작하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Следите за их работой, отвечайте на вопросы и начинайте новые чаты откуда угодно."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Acompanhe o trabalho deles, responda o que perguntam e inicie novos chats de qualquer lugar."
          }
        }
      }
    },
