    "{label} makes a new checkout of it from its remote, or from {from} when it cannot reach the remote, with the uncommitted changes there as a commit on top.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} en crée un nouveau checkout depuis son remote, ou depuis {from} quand il ne peut pas atteindre le remote, avec les modifications non commitées dans un commit par-dessus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} crea una copia de trabajo nueva desde su remoto, o desde {from} cuando no puede llegar al remoto, con los cambios sin commit de allí como un commit encima."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} erstellt einen neuen Checkout davon aus seinem Remote oder aus {from}, wenn es das Remote nicht erreicht, mit den dortigen nicht committeten Änderungen als Commit obendrauf."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} 会从其远程创建一个新的检出（无法访问远程时从 {from} 创建），并将那里未提交的更改作为顶部的一个提交。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} はリモートから、またはリモートに接続できない場合は {from} から新しいチェックアウトを作成し、そこにあるコミットされていない変更を最上位のコミットとして含めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{label}은(는) 리모트에서, 또는 리모트에 연결할 수 없으면 {from}에서 새로 체크아웃하고, 커밋되지 않은 변경 사항은 맨 위에 커밋으로 추가합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} создаёт новую копию из его remote или из {from}, если remote недоступен, а незакоммиченные изменения добавляются коммитом сверху."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} faz um novo checkout dele a partir do remoto, ou de {from} quando não consegue acessar o remoto, com as alterações sem commit de lá como um commit por cima."
          }
        }
      }
    },
    "{label} makes a new checkout of it from its remote, or from {from} when it cannot reach the remote. Only what is committed goes over; uncommitted changes stay there.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} en crée un nouveau checkout depuis son remote, ou depuis {from} quand il ne peut pas atteindre le remote. Seul ce qui est commité est transféré ; les modifications non commitées restent là-bas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} crea una copia de trabajo nueva desde su remoto, o desde {from} cuando no puede llegar al remoto. Solo se lleva lo que tiene commit; los cambios sin commit se quedan allí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} erstellt einen neuen Checkout davon aus seinem Remote oder aus {from}, wenn es das Remote nicht erreicht. Nur Committetes geht mit; nicht committete Änderungen bleiben dort."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} 会从其远程创建一个新的检出（无法访问远程时从 {from} 创建）。只迁移已提交的内容；未提交的更改留在原处。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} はリモートから、またはリモートに接続できない場合は {from} から新しいチェックアウトを作成します。コミット済みのものだけが移動し、コミットされていない変更は元の場所に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{label}은(는) 리모트에서, 또는 리모트에 연결할 수 없으면 {from}에서 새로 체크아웃합니다. 커밋된 내용만 옮겨지며 커밋되지 않은 변경 사항은 그대로 남습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} создаёт новую копию из его remote или из {from}, если remote недоступен. Переносится только закоммиченное; незакоммиченные изменения остаются там."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} faz um novo checkout dele a partir do remoto, ou de {from} quando não consegue acessar o remoto. Só o que tem commit vai junto; as alterações sem commit ficam lá."
          }
        }
      }
    },
    "{label} needs {bin}. Install it to enable go-to-definition and references.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} a besoin de {bin}. Installez-le pour activer l'accès aux définitions et aux références."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} necesita {bin}. Instálalo para activar ir a la definición y las referencias."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} braucht {bin}. Installiere es, um „Gehe zu Definition“ und Verweise zu aktivieren."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} 需要 {bin}。安装它以启用跳转到定义和引用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} には {bin} が必要です。定義へ移動と参照を有効にするにはインストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{label}에는 {bin}이(가) 필요합니다. 정의로 이동 및 참조를 사용하려면 설치하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} нужен {bin}. Установите его, чтобы включить переход к определению и поиск ссылок."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} precisa de {bin}. Instale-o para ativar ir para a definição e referências."
          }
        }
      }
    },
    "{label} needs {bin}. Install the {bin} package with your system's package manager to enable go-to-definition and references.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} a besoin de {bin}. Installez le paquet {bin} avec le gestionnaire de paquets de votre système pour activer l'accès aux définitions et aux références."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} necesita {bin}. Instala el paquete {bin} con el gestor de paquetes de tu sistema para activar ir a la definición y las referencias."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} braucht {bin}. Installiere das Paket {bin} mit dem Paketmanager deines Systems, um „Gehe zu Definition“ und Verweise zu aktivieren."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} 需要 {bin}。用系统的包管理器安装 {bin} 包以启用跳转到定义和引用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} には {bin} が必要です。定義へ移動と参照を有効にするには、システムのパッケージマネージャで {bin} パッケージをインストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{label}에는 {bin}이(가) 필요합니다. 정의로 이동 및 참조를 사용하려면 시스템 패키지 관리자로 {bin} 패키지를 설치하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} нужен {bin}. Установите пакет {bin} системным менеджером пакетов, чтобы включить переход к определению и поиск ссылок."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} precisa de {bin}. Instale o pacote {bin} com o gerenciador de pacotes do seu sistema para ativar ir para a definição e referências."
          }
        }
      }
    },
    "{label} still reads as signed out. Try again, or check the output above.": {
      "localizations": {
