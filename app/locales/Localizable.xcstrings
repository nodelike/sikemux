    "Another agent or project still uses this worktree. Close it before removing the worktree.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre agent ou projet utilise encore ce worktree. Fermez-le avant de supprimer le worktree."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro agente o proyecto todavía usa este worktree. Ciérralo antes de eliminar el worktree."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Agent oder ein anderes Projekt nutzt diesen Worktree noch. Schließe ihn, bevor du den Worktree entfernst."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍有其他智能体或项目在使用此工作树。移除工作树前请先关闭它。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のエージェントまたはプロジェクトがまだこのワークツリーを使用しています。ワークツリーを削除する前に閉じてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 에이전트나 프로젝트가 아직 이 워크트리를 사용하고 있습니다. 워크트리를 제거하기 전에 닫으세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это рабочее дерево ещё использует другой агент или проект. Закройте его, прежде чем удалять рабочее дерево."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro agente ou projeto ainda usa esta worktree. Feche-a antes de remover a worktree."
          }
        }
      }
    },
