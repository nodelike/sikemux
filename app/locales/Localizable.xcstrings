          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "エージェントが対応を求めたときに通知"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "에이전트가 확인을 기다리면 알림"
          }
        },
        "ru": {
          "stringUnit": {
