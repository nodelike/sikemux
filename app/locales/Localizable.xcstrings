    "An agent gets its own checkout, so its edits stay off your branch until you merge them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un agente recibe su propia copia de trabajo, así que sus cambios quedan fuera de tu rama hasta que los fusiones."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "代理拥有自己的检出，因此在你合并之前，它的编辑不会影响你的分支。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Agent bekommt seinen eigenen Checkout, damit seine Änderungen von deinem Branch fernbleiben, bis du sie mergst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un agent obtient sa propre copie de travail, donc ses modifications restent hors de votre branche jusqu'à ce que vous les fusionniez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "エージェントは専用のチェックアウトを持つため、マージするまでその編集はあなたのブランチに入りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "에이전트는 자체 체크아웃을 받으므로 병합하기 전까지 편집 내용이 내 브랜치에 들어가지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Агент получает собственную копию репозитория, поэтому его правки не попадают в вашу ветку, пока вы их не сольёте."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um agente recebe o próprio checkout, então as edições dele ficam fora do seu branch até você mesclá-las."
          }
        }
      }
    },
