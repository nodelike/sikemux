          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kompakt zeigt mehr Sitzungen und lässt jedes Statussymbol sichtbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Compact affiche plus de sessions tout en gardant chaque symbole d'état visible."
