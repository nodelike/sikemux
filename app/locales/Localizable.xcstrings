    "Allow Sikemux under Screen Recording in System Settings, then reopen it to take SnapShots": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite Sikemux en Grabación de pantalla en Ajustes del Sistema y vuelve a abrirlo para hacer SnapShots"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在系统设置的“录屏”中允许 Sikemux，然后重新打开它以截取快照"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erlaube Sikemux unter „Bildschirmaufnahme“ in den Systemeinstellungen und öffne es dann erneut, um SnapShots zu machen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autorisez Sikemux sous Enregistrement de l'écran dans Réglages Système, puis rouvrez-le pour prendre des SnapShots"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SnapShot を撮るには、システム設定の「画面収録」で Sikemux を許可してから再度開いてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "시스템 설정의 화면 기록에서 Sikemux를 허용한 다음 다시 열어 SnapShot을 찍으세요"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Разрешите Sikemux в разделе «Запись экрана» в Системных настройках, затем откройте приложение снова, чтобы делать снимки SnapShots"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permita o Sikemux em Gravação de Tela nos Ajustes do Sistema e abra-o novamente para fazer SnapShots"
          }
        }
      }
    },
