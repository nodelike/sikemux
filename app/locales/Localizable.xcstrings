        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタブの前に前面にあったタブへ戻る（プロジェクトやホストをまたぎます）。ブラウザページではページ内で戻る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전에 앞에 있던 탭으로 돌아갑니다(어느 프로젝트나 호스트든). 브라우저 페이지에서는 페이지에서 뒤로 이동합니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
