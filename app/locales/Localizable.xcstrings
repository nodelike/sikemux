          "stringUnit": {
            "state": "translated",
            "value": "S'exécute hors sandbox dans le répertoire de la session active, avec SIKEMUX_SESSION_* et SIKEMUX_PROJECT définis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ejecuta sin sandbox en la carpeta de la sesión activa, con SIKEMUX_SESSION_* y SIKEMUX_PROJECT definidos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft ohne Sandbox im Ordner der aktiven Sitzung, mit gesetztem SIKEMUX_SESSION_* und SIKEMUX_PROJECT."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在活动会话的目录中以非沙盒方式运行，并设置 SIKEMUX_SESSION_* 和 SIKEMUX_PROJECT。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティブなセッションのディレクトリでサンドボックスなしで実行され、SIKEMUX_SESSION_* と SIKEMUX_PROJECT が設定されます。"
          }
        }
      }
    },
