        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Und {count} weitere, nicht aufgeführt, solange die Liste voll ist. Zähle einige als Produktion, um Platz zu schaffen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另有 {count} 项，列表已满故未列出。将部分计为生产环境以腾出空间。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほか {count} 件。リストがいっぱいのため表示されていません。いくつかを本番として数えると空きができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록이 가득 차서 {count}개는 표시되지 않습니다. 일부를 프로덕션으로 지정하면 자리가 생깁니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "И ещё {count}, не показаны, пока список заполнен. Отметьте часть как продакшен, чтобы освободить место."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "E mais {count}, não listados enquanto a lista está cheia. Conte alguns como produção para abrir espaço."
          }
        }
      }
    },
