    "Not open on this host yet. It opens once one of your hosts that has it, or a host of one of {org}'s owners or admins, is online.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore ouvert sur cet hôte. Il s'ouvre dès qu'un de vos hôtes qui l'a, ou un hôte d'un propriétaire ou admin de {org}, est en ligne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no está abierto en este host. Se abre cuando se conecta uno de tus hosts que lo tenga, o un host de algún propietario o admin de {org}."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Host noch nicht offen. Es öffnet sich, sobald einer deiner Hosts, der es hat, oder ein Host eines Inhabers oder Admins von {org} online ist."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此主机上尚未打开。你的某台已有它的主机，或 {org} 所有者或管理员的某台主机上线后即可打开。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このホストではまだ開けません。それを持つあなたのホスト、または {org} のオーナーか管理者のホストがオンラインになると開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 호스트에서는 아직 열리지 않았습니다. 이를 가진 내 호스트나 {org}의 소유자 또는 관리자의 호스트가 온라인이 되면 열립니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока не открыто на этом хосте. Откроется, когда в сети окажется один из ваших хостов, где оно есть, или хост владельца или администратора {org}."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não aberto neste host. Abre quando um dos seus hosts que o tem, ou um host de um dos proprietários ou administradores de {org}, estiver online."
          }
        }
      }
    },
