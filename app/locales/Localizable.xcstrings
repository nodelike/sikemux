    },
    "{alias} runs Sikemux, on your account or another one.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{alias} exécute Sikemux, sur votre compte ou un autre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{alias} ejecuta Sikemux, en tu cuenta o en otra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf {alias} läuft Sikemux, auf deinem Account oder einem anderen."
          }
        }
      }
    },
    "{alias} runs a release of Sikemux too old for this app. Updating runs its own update over your SSH, on the channel it follows, and restarts its core.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{alias} exécute une version de Sikemux trop ancienne pour cette app. Mettre à jour lance sa propre mise à jour via votre SSH, sur le canal qu'il suit, et redémarre son cœur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{alias} ejecuta una versión de Sikemux demasiado antigua para esta app. Al actualizar se ejecuta su propia actualización por tu SSH, en el canal que sigue, y se reinicia su núcleo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf {alias} läuft eine Sikemux-Version, die für diese App zu alt ist. Aktualisieren führt dort sein eigenes Update über dein SSH aus, im Kanal, dem es folgt, und startet seinen Core neu."
          }
        }
      }
    },
    "{alias} was added to your account as {name}": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{alias} a été ajouté à votre compte sous le nom {name}"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{alias} se añadió a tu cuenta como {name}"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{alias} wurde deinem Account als {name} hinzugefügt"
          }
        }
