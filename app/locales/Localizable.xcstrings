    "Mix gives each agent its own shape from the pack.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mélange donne à chaque agent sa propre forme du pack."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezcla le da a cada agente su propia forma del paquete."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mischen gibt jedem Agent seine eigene Form aus dem Paket."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“混合”会从包中为每个智能体分配各自的形状。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミックスでは、各エージェントにパックから個別の形状が割り当てられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "섞기는 각 에이전트에 팩의 고유한 모양을 줍니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Смесь» даёт каждому агенту свою форму из набора."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Misturar dá a cada agente uma forma própria do pacote."
          }
        }
      }
    },
