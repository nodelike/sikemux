    "{label} makes a new checkout of it from its remote, or from {from} when it cannot reach the remote, with the uncommitted changes there as a commit on top.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} en crée un nouveau checkout depuis son remote, ou depuis {from} quand il ne peut pas atteindre le remote, avec les modifications non commitées dans un commit par-dessus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} crea una copia de trabajo nueva desde su remoto, o desde {from} cuando no puede llegar al remoto, con los cambios sin commit de allí como un commit encima."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} erstellt einen neuen Checkout davon aus seinem Remote oder aus {from}, wenn es das Remote nicht erreicht, mit den dortigen nicht committeten Änderungen als Commit obendrauf."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} 会从其远程创建一个新的检出（无法访问远程时从 {from} 创建），并将那里未提交的更改作为顶部的一个提交。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} はリモートから、またはリモートに接続できない場合は {from} から新しいチェックアウトを作成し、そこにあるコミットされていない変更を最上位のコミットとして含めます。"
          }
        }
      }
    },
    "{label} makes a new checkout of it from its remote, or from {from} when it cannot reach the remote. Only what is committed goes over; uncommitted changes stay there.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} en crée un nouveau checkout depuis son remote, ou depuis {from} quand il ne peut pas atteindre le remote. Seul ce qui est commité est transféré ; les modifications non commitées restent là-bas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} crea una copia de trabajo nueva desde su remoto, o desde {from} cuando no puede llegar al remoto. Solo se lleva lo que tiene commit; los cambios sin commit se quedan allí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} erstellt einen neuen Checkout davon aus seinem Remote oder aus {from}, wenn es das Remote nicht erreicht. Nur Committetes geht mit; nicht committete Änderungen bleiben dort."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} 会从其远程创建一个新的检出（无法访问远程时从 {from} 创建）。只迁移已提交的内容；未提交的更改留在原处。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} はリモートから、またはリモートに接続できない場合は {from} から新しいチェックアウトを作成します。コミット済みのものだけが移動し、コミットされていない変更は元の場所に残ります。"
          }
        }
      }
    },
    "{label} needs {bin}. Install it to enable go-to-definition and references.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} a besoin de {bin}. Installez-le pour activer l'accès aux définitions et aux références."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
