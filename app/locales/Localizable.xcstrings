    "Copied {name} to {label}, with the uncommitted changes as a commit on top.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} copié vers {label}, avec les modifications non commitées dans un commit par-dessus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se copió {name} a {label}, con los cambios sin commit como un commit encima."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} nach {label} kopiert, mit den nicht committeten Änderungen als Commit obendrauf."
          }
