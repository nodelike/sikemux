        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts gefunden. Sag einem Agent, wohin das Projekt ausgeliefert wird, oder füge es hier hinzu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到。告诉任意智能体项目发布到哪里，或在此添加。"
