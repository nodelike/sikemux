    "Enjoying Sikemux? A star on GitHub helps others find it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux vous plaît ? Une étoile sur GitHub aide d’autres personnes à le trouver."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Te gusta Sikemux? Una estrella en GitHub ayuda a que otros lo encuentren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gefällt dir Sikemux? Ein Stern auf GitHub hilft anderen, es zu finden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "喜欢 Sikemux 吗？在 GitHub 上点个星，能帮别人找到它。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux を気に入りましたか？GitHub のスターが、ほかの人が見つける助けになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux가 마음에 드시나요? GitHub 별은 다른 사람들이 찾는 데 도움이 됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нравится Sikemux? Звезда на GitHub помогает другим его найти."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gostando do Sikemux? Uma estrela no GitHub ajuda outras pessoas a encontrá-lo."
          }
        }
      }
    },
    "Enter a word, symbol, or pattern above. Expand Replace to edit matching text.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un mot, un symbole ou un motif ci-dessus. Développez Remplacer pour modifier le texte correspondant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe una palabra, un símbolo o un patrón arriba. Despliega Reemplazar para editar el texto coincidente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib oben ein Wort, Symbol oder Muster ein. Klappe „Ersetzen“ auf, um passenden Text zu bearbeiten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在上方输入单词、符号或模式。展开“替换”以编辑匹配的文本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上に単語、記号、またはパターンを入力してください。「置換」を展開すると一致したテキストを編集できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위에 단어, 기호 또는 패턴을 입력하세요. 일치하는 텍스트를 편집하려면 바꾸기를 펼치세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите слово, символ или шаблон выше. Разверните «Заменить», чтобы изменить найденный текст."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite uma palavra, símbolo ou padrão acima. Expanda Substituir para editar o texto correspondente."
          }
        }
      }
    },
