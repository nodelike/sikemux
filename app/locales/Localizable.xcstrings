    "Enter a word, symbol, or pattern above. Expand Replace to edit matching text.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escribe una palabra, un símbolo o un patrón arriba. Despliega Reemplazar para editar el texto coincidente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在上方输入单词、符号或模式。展开“替换”以编辑匹配的文本。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gib oben ein Wort, Symbol oder Muster ein. Klappe „Ersetzen“ auf, um passenden Text zu bearbeiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saisissez un mot, un symbole ou un motif ci-dessus. Développez Remplacer pour modifier le texte correspondant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "上に単語、記号、またはパターンを入力してください。「置換」を展開すると一致したテキストを編集できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "위에 단어, 기호 또는 패턴을 입력하세요. 일치하는 텍스트를 편집하려면 바꾸기를 펼치세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Введите слово, символ или шаблон выше. Разверните «Заменить», чтобы изменить найденный текст."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Digite uma palavra, símbolo ou padrão acima. Expanda Substituir para editar o texto correspondente."
          }
        }
      }
    },
