    "Duplicate active terminal": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dupliquer le terminal actif"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicar la terminal activa"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktives Terminal duplizieren"
          }
