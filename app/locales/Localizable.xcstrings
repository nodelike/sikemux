            "state": "translated",
            "value": "Opaque à 1.00, translucide en dessous."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sólido en 1.00, translúcido por debajo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deckend bei 1.00, darunter durchscheinend."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1.00 时为不透明，低于此值为半透明。"
