    "Every other host on the account loses this sign-in. It leaves the vault and stays on this host alone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les autres hôtes du compte perdent cette connexion. Elle quitte le coffre et reste sur cet hôte seul."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los demás hosts de la cuenta pierden este inicio de sesión. Sale de la bóveda y se queda solo en este host."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder andere Host des Accounts verliert diese Anmeldung. Sie verlässt den Tresor und bleibt nur auf diesem Host."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户中的其他主机都会失去此登录。它将离开保险库，只保留在此主机上。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントの他のホストはすべてこのサインインを失います。保管庫から外れ、このホストだけに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정의 다른 모든 호스트가 이 로그인을 잃습니다. 보관함에서 빠지고 이 호스트에만 남습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все остальные хосты учётной записи потеряют этот вход. Он покинет хранилище и останется только на этом хосте."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os outros hosts da conta perdem este login. Ele sai do cofre e fica só neste host."
          }
        }
      }
    },
