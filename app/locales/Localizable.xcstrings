    "Kept from your own words when you said them. Only you change these.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tomado de tus propias palabras cuando las dijiste. Solo tú los cambias."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "取自你说过的话。只有你能更改这些。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aus deinen eigenen Worten übernommen, als du sie gesagt hast. Nur du änderst diese."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiré de vos propres mots quand vous les avez dits. Vous seul pouvez les modifier."
