    },
    "It has commits that are not in the branch it started from. Deleting it loses any that were not pushed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiene commits que no están en la rama de la que partió. Al eliminarla se pierden los que no se enviaron."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "它有不在其起始分支中的提交。删除后，任何未推送的提交都将丢失。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Er hat Commits, die nicht im Ausgangsbranch sind. Beim Löschen gehen alle verloren, die nicht gepusht wurden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elle contient des commits absents de la branche d'origine. La supprimer perd ceux qui n'ont pas été poussés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "開始元のブランチにないコミットがあります。削除すると、プッシュされていないコミットは失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "시작한 브랜치에 없는 커밋이 있습니다. 삭제하면 푸시되지 않은 커밋이 사라집니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "В ней есть коммиты, которых нет в ветке, от которой она начиналась. При удалении все неотправленные будут потеряны."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ele tem commits que não estão no branch de onde começou. Excluí-lo perde os que não foram enviados."
          }
        }
      }
    },
    "It has not been online since this computer last heard of it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No ha estado en línea desde la última vez que este ordenador supo de él."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "自此电脑上次获知它以来，它一直未上线。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es war nicht online, seit dieser Computer zuletzt davon gehört hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il n'a pas été en ligne depuis la dernière fois que cet ordinateur a eu de ses nouvelles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このコンピュータが最後に確認して以来、オンラインになっていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 컴퓨터가 마지막으로 확인한 이후 온라인 상태였던 적이 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Он не был в сети с тех пор, как этот компьютер последний раз получал о нём сведения."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não ficou online desde a última vez que este computador soube dele."
          }
        }
      }
    },
    "It is not signed in yet.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aún no ha iniciado sesión."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "它尚未登录。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es ist noch nicht angemeldet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il n'est pas encore connecté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "まだサインインしていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "아직 로그인되지 않았습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
