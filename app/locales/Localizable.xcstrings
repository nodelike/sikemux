          "stringUnit": {
            "state": "translated",
            "value": "手順は新しいチェックアウトでこの順に実行されます。"
          }
        }
      }
    },
    "The teams you're in. Their model keys and skills show beside your own.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les équipes dont vous faites partie. Leurs clés de modèle et skills s'affichent à côté des vôtres."
