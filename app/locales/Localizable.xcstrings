    "The grain, as every theme draws it unless it names another.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le grain, tel que chaque thème le dessine, sauf s'il en nomme un autre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El grano, tal como lo dibuja cada tema salvo que indique otro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Körnung, wie jedes Theme sie zeichnet, sofern es keine andere nennt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "颗粒效果，每个主题默认这样绘制，除非另行指定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各テーマが別の指定をしない限り使う粒状感。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
