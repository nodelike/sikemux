    "Deletes the local branch only. Use force delete if Git refuses because the branch is not merged.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elimina solo la rama local. Usa la eliminación forzada si Git se niega porque la rama no está fusionada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅删除本地分支。如果 Git 因分支未合并而拒绝，请使用强制删除。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Löscht nur den lokalen Branch. Nutze erzwungenes Löschen, wenn Git ablehnt, weil der Branch nicht gemergt ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Supprime uniquement la branche locale. Forcez la suppression si Git refuse parce que la branche n'est pas fusionnée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ローカルブランチのみを削除します。ブランチがマージされていないために Git が拒否する場合は、強制削除を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "로컬 브랜치만 삭제합니다. 브랜치가 병합되지 않아 Git이 거부하면 강제 삭제를 사용하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Удаляет только локальную ветку. Используйте принудительное удаление, если Git отказывает, потому что ветка не слита."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Exclui só o branch local. Use a exclusão forçada se o Git recusar porque o branch não foi mesclado."
          }
        }
      }
    },
