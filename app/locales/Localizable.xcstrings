    "The file is new and will be deleted. This can't be undone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier est nouveau et sera supprimé. Action irréversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo es nuevo y se eliminará. No se puede deshacer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ist neu und wird gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文件是新文件，将被删除。此操作无法撤销。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは新規のため削除されます。この操作は元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 파일이므로 삭제됩니다. 실행 취소할 수 없습니다."
          }
        },
        "ru": {
