    "Enjoying Sikemux? A star on GitHub helps others find it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux vous plaît ? Une étoile sur GitHub aide d’autres personnes à le trouver."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Te gusta Sikemux? Una estrella en GitHub ayuda a que otros lo encuentren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gefällt dir Sikemux? Ein Stern auf GitHub hilft anderen, es zu finden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "喜欢 Sikemux 吗？在 GitHub 上点个星，能帮别人找到它。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux を気に入りましたか？GitHub のスターが、ほかの人が見つける助けになります。"
          }
        }
      }
    },
    "Enter a word, symbol, or pattern above. Expand Replace to edit matching text.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un mot, un symbole ou un motif ci-dessus. Développez Remplacer pour modifier le texte correspondant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe una palabra, un símbolo o un patrón arriba. Despliega Reemplazar para editar el texto coincidente."
