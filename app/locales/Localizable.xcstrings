    "Keys {org}'s admins added. A chat runs on one only when it's picked; it never stands in for your own. You're a member.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clés ajoutées par les admins de {org}. Un chat n'en utilise une que si elle est choisie ; elle ne remplace jamais la vôtre. Vous êtes membre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claves que añadieron los admins de {org}. Un chat solo se ejecuta con una si se elige; nunca sustituye a la tuya. Eres miembro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüssel, die die Admins von {org} hinzugefügt haben. Ein Chat läuft nur auf einem, wenn er gewählt wird; er ersetzt nie deinen eigenen. Du bist Mitglied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{org} 的管理员添加的密钥。聊天只在你选中时才使用其中之一，绝不会代替你自己的密钥。你是成员。"
          }
        }
      }
    },
