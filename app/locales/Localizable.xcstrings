    },
    "Until you confirm, a change to any of them waits for your yes.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que vous n'avez pas confirmé, une modification de l'un d'eux attend votre oui."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta que lo confirmes, un cambio en cualquiera de ellos espera tu sí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis du bestätigst, wartet eine Änderung an einem davon auf dein Ja."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你确认之前，对其中任一项的更改都需等你同意。"
          }
        }
      }
    },
    "Until you confirm, a change to any place found waits for your yes.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que vous n'avez pas confirmé, une modification de tout emplacement trouvé attend votre oui."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta que lo confirmes, un cambio en cualquier lugar encontrado espera tu sí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis du bestätigst, wartet eine Änderung an jedem gefundenen Ort auf dein Ja."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你确认之前，对所找到的任一位置的更改都需等你同意。"
          }
        }
      }
    },
    "Until you confirm, a change to either waits for your yes.": {
