    "Every agent on {project} follows these. Kept by Sikemux, never in the repository.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les agents de {project} les suivent. Conservé par Sikemux, jamais dans le dépôt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los agentes de {project} siguen estas reglas. Las guarda Sikemux, nunca el repositorio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Agent in {project} befolgt diese. Von Sikemux verwahrt, nie im Repository."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{project} 上的每个智能体都遵循这些规则。由 Sikemux 保管，从不放入仓库。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{project} のすべてのエージェントがこれに従います。Sikemux が保管し、リポジトリには入りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{project}의 모든 에이전트가 따릅니다. Sikemux가 보관하며 저장소에는 들어가지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти правила соблюдают все агенты в {project}. Хранятся в Sikemux, не в репозитории."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os agentes em {project} seguem estas. Guardadas pelo Sikemux, nunca no repositório."
          }
        }
      }
    },
    "Every agent on {project} follows these. Teammates at {org} get them too, except the ones marked Only you.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les agents de {project} les suivent. Les coéquipiers de {org} les reçoivent aussi, sauf ceux marqués Vous seul."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los agentes de {project} siguen estas reglas. Los compañeros de {org} también las reciben, salvo las marcadas como Solo tú."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Agent in {project} befolgt diese. Teammates bei {org} bekommen sie auch, außer die mit „Nur du“ markierten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{project} 上的每个智能体都遵循这些规则。{org} 的队友也会得到，标为“仅你”的除外。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{project} のすべてのエージェントがこれに従います。{org} のチームメイトにも適用されますが、「あなただけ」の印があるものは除きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{project}의 모든 에이전트가 따릅니다. {org}의 팀원에게도 적용되며, 나만으로 표시된 항목은 제외됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти правила соблюдают все агенты в {project}. Коллеги из {org} тоже их получают, кроме отмеченных «Только вам»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os agentes em {project} seguem estas. Colegas de equipe em {org} também as recebem, exceto as marcadas como Só você."
          }
        }
      }
    },
