    "Into a worktree": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans un worktree"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un worktree"
          }
        },
        "de": {
          "stringUnit": {
