        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "あなたが話したときの言葉から保持しています。変更できるのはあなただけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
