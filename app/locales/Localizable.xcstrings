          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ainda não está conectado."
          }
        }
      }
    },
    "It is signed in to your Sikemux account. Allow or decline it in Sikemux.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ha iniciado sesión en tu cuenta de Sikemux. Permítelo o recházalo en Sikemux."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "它已登录你的 Sikemux 账户。在 Sikemux 中允许或拒绝它。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es ist bei deinem Sikemux-Account angemeldet. Erlaube oder lehne es in Sikemux ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il est connecté à votre compte Sikemux. Autorisez-le ou refusez-le dans Sikemux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux アカウントにサインインしています。Sikemux で許可または拒否してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux 계정에 로그인되어 있습니다. Sikemux에서 허용하거나 거절하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Он вошёл в вашу учётную запись Sikemux. Разрешите или отклоните его в Sikemux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Está conectado à sua conta do Sikemux. Permita ou recuse no Sikemux."
          }
        }
      }
    },
    "It is signed out of your account and taken off every host at once. To use it again, sign it in again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se cierra su sesión en tu cuenta y se quita de todos los hosts a la vez. Para volver a usarlo, inicia sesión otra vez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "它将退出你的账户，并立即从所有主机上移除。要再次使用，请重新登录。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es wird von deinem Account abgemeldet und sofort von jedem Host entfernt. Um es wieder zu nutzen, melde es erneut an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il est déconnecté de votre compte et retiré de tous les hôtes à la fois. Pour l'utiliser à nouveau, reconnectez-le."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アカウントからサインアウトされ、すべてのホストからすぐに削除されます。再度使用するには、もう一度サインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "계정에서 로그아웃되고 모든 호스트에서 즉시 제거됩니다. 다시 사용하려면 다시 로그인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Он выходит из вашей учётной записи и сразу удаляется со всех хостов. Чтобы снова его использовать, войдите заново."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "É desconectado da sua conta e removido de todos os hosts de uma vez. Para usá-lo de novo, faça login nele novamente."
          }
        }
      }
    },
    "It is signing in from this computer. Allow or decline it in Sikemux.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Está iniciando sesión desde este ordenador. Permítelo o recházalo en Sikemux."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "它正从此电脑登录。在 Sikemux 中允许或拒绝它。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es meldet sich von diesem Computer aus an. Erlaube oder lehne es in Sikemux ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il se connecte depuis cet ordinateur. Autorisez-le ou refusez-le dans Sikemux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このコンピュータからサインイン中です。Sikemux で許可または拒否してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 컴퓨터에서 로그인하는 중입니다. Sikemux에서 허용하거나 거절하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Он входит с этого компьютера. Разрешите или отклоните его в Sikemux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Está fazendo login a partir deste computador. Permita ou recuse no Sikemux."
          }
        }
      }
    },
    "It keeps running after Sikemux quits, as your agents do.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sigue ejecutándose después de cerrar Sikemux, igual que tus agentes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "它会在 Sikemux 退出后继续运行，就像你的代理一样。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es läuft weiter, wenn Sikemux beendet wird, wie deine Agents."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il continue de tourner après la fermeture de Sikemux, comme vos agents."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "エージェントと同様に、Sikemux を終了しても動作し続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "에이전트처럼 Sikemux를 종료한 후에도 계속 실행됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Он продолжает работать после выхода из Sikemux, как и ваши агенты."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Continua rodando depois que o Sikemux fecha, como seus agentes."
          }
        }
      }
    },
    "It may be off, asleep or offline, or its core stopped.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puede que esté apagado, en reposo o sin conexión, o que su núcleo se haya detenido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "它可能已关机、睡眠或离线，或其核心已停止。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es ist vielleicht aus, im Ruhezustand oder offline, oder sein Core wurde gestoppt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il est peut-être éteint, en veille ou hors ligne, ou son cœur s'est arrêté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "電源が切れているか、スリープ中かオフラインか、コアが停止している可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "꺼져 있거나, 잠자기 중이거나, 오프라인이거나, 코어가 중지되었을 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Возможно, он выключен, спит или не в сети либо его ядро остановилось."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pode estar desligado, em repouso ou offline, ou o núcleo dele parou."
          }
        }
      }
    },
    "It may be offline, or a firewall blocks it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puede que esté sin conexión o que un cortafuegos lo bloquee."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "它可能已离线，或被防火墙阻止。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es ist vielleicht offline, oder eine Firewall blockiert es."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il est peut-être hors ligne, ou un pare-feu le bloque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "オフラインか、ファイアウォールでブロックされている可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "오프라인이거나 방화벽이 차단하고 있을 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Возможно, он не в сети или его блокирует брандмауэр."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pode estar offline, ou um firewall o bloqueia."
          }
        }
      }
    },
    "It shows everything the agent read and ran, including the contents of files and any secrets in them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Muestra todo lo que el agente leyó y ejecutó, incluido el contenido de los archivos y cualquier secreto que contengan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "它会显示代理读取和运行的全部内容，包括文件内容及其中的任何机密。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es zeigt alles, was der Agent gelesen und ausgeführt hat, einschließlich Dateiinhalten und darin enthaltener Secrets."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il montre tout ce que l'agent a lu et exécuté, y compris le contenu des fichiers et les secrets qu'ils contiennent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "エージェントが読み取り、実行したすべてのもの（ファイルの内容やそこに含まれるシークレットを含む）が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "에이전트가 읽고 실행한 모든 것을 보여 주며, 파일 내용과 그 안의 시크릿도 포함됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Здесь показано всё, что агент читал и запускал, включая содержимое файлов и любые секреты в них."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mostra tudo o que o agente leu e executou, incluindo o conteúdo dos arquivos e quaisquer segredos neles."
          }
        }
      }
    },
    "It shows in the device menu while Wireless debugging is on.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aparece en el menú de dispositivos mientras la depuración inalámbrica está activada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无线调试开启时，它会显示在设备菜单中。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es erscheint im Gerätemenü, solange kabelloses Debugging an ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il apparaît dans le menu des appareils tant que le débogage sans fil est activé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ワイヤレス デバッグがオンの間、デバイスメニューに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "무선 디버깅이 켜져 있는 동안 기기 메뉴에 표시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Он показывается в меню устройств, пока включена отладка по Wi-Fi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aparece no menu de dispositivos enquanto a Depuração por Wi-Fi está ativada."
          }
        }
      }
    },
    "It stays on your account and keeps reaching your other hosts. It reaches this one again only when you allow it, with no more access than it has now.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se queda en tu cuenta y sigue accediendo a tus otros hosts. Vuelve a acceder a este solo cuando lo permitas, sin más acceso del que tiene ahora."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "它仍在你的账户上，并继续访问你的其他主机。只有在你允许后它才会再次访问此主机，且权限不超过现在。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es bleibt auf deinem Account und erreicht weiter deine anderen Hosts. Diesen erreicht es erst wieder, wenn du es erlaubst, mit nicht mehr Zugriff als jetzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il reste sur votre compte et continue d'atteindre vos autres hôtes. Il n'atteint à nouveau celui-ci que si vous l'autorisez, sans plus d'accès qu'il n'en a maintenant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アカウントに残り、ほかのホストには引き続き接続できます。このホストに再び接続できるのはあなたが許可したときのみで、アクセス権は現在のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "계정에 그대로 남아 다른 호스트에는 계속 연결됩니다. 이 호스트에는 내가 허용할 때만 다시 연결되며, 지금보다 더 많은 권한을 갖지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Он остаётся в вашей учётной записи и по-прежнему подключается к другим вашим хостам. К этому он подключится снова, только когда вы разрешите, и без большего доступа, чем сейчас."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Continua na sua conta e segue acessando seus outros hosts. Só volta a acessar este quando você permitir, sem mais acesso do que tem agora."
          }
        }
      }
    },
    "It stops what it is running now.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Detiene lo que está ejecutando ahora."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "它会停止当前正在运行的内容。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es stoppt, was es gerade ausführt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il arrête ce qu'il exécute en ce moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "現在実行中のものを停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "지금 실행 중인 작업을 중지합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Текущая работа будет остановлена."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para o que está executando agora."
          }
        }
      }
    },
    "It was not brought back": {
