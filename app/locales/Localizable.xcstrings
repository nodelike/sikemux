            "state": "translated",
            "value": "Wie stark sich die Oberfläche bewegt, in jedem Theme."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个主题中界面的动效幅度。"
          }
        }
      }
    },
    "How strongly the backdrop shows. 1.00 is its own strength.": {
      "localizations": {
