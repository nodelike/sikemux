    "Update to v{to} undone: {reason}. Back on v{from}; running terminals stopped, chats picked up again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mise à jour vers v{to} annulée : {reason}. De retour sur v{from} ; les terminaux en cours se sont arrêtés, les chats ont repris."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se deshizo la actualización a v{to}: {reason}. De vuelta en v{from}; las terminales en ejecución se detuvieron y los chats continuaron."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Update auf v{to} rückgängig gemacht: {reason}. Zurück auf v{from}; laufende Terminals gestoppt, Chats wieder aufgenommen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新到 v{to} 已撤销：{reason}。已回到 v{from}；运行中的终端已停止，聊天已继续。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "v{to} へのアップデートを元に戻しました：{reason}。v{from} に戻り、実行中のターミナルは停止し、チャットは再開されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "v{to} 업데이트가 취소됨: {reason}. v{from}(으)로 복귀했으며, 실행 중이던 터미널은 중지되고 채팅은 다시 이어집니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновление до v{to} отменено: {reason}. Снова v{from}; запущенные терминалы остановлены, чаты продолжены."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualização para v{to} desfeita: {reason}. De volta à v{from}; os terminais em execução foram parados e os chats retomados."
          }
        }
      }
    },
