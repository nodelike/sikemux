      }
    },
    "Sikemux will not overwrite {path}. Move the existing file yourself, then refresh.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux n'écrasera pas {path}. Déplacez vous-même le fichier existant, puis actualisez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux no sobrescribirá {path}. Mueve tú el archivo existente y luego actualiza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux überschreibt {path} nicht. Verschiebe die vorhandene Datei selbst und aktualisiere dann."
          }
        },
        "zh-Hans": {
          "stringUnit": {
