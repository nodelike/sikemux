    "Moves HEAD to this commit and discards all later changes from the index and working tree.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mueve HEAD a este commit y descarta todos los cambios posteriores del índice y del árbol de trabajo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将 HEAD 移到此提交，并从索引和工作树中丢弃之后的所有更改。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Setzt HEAD auf diesen Commit und verwirft alle späteren Änderungen aus Index und Arbeitsverzeichnis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Déplace HEAD vers ce commit et abandonne toutes les modifications ultérieures de l'index et de la copie de travail."
