    "{name} asks to reach {origins}, and nowhere else. It may do so whenever it is open, until its mod.json asks for more. Settings, Mods takes this back.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} demande à accéder à {origins}, et nulle part ailleurs. Il peut le faire à tout moment quand il est ouvert, jusqu'à ce que son mod.json en demande davantage. Réglages, Mods permet de le révoquer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} pide llegar a {origins}, y a ningún otro sitio. Puede hacerlo siempre que esté abierto, hasta que su mod.json pida más. Ajustes, Mods lo revoca."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} möchte {origins} erreichen und sonst nichts. Es darf das tun, solange es offen ist, bis seine mod.json mehr verlangt. Unter Einstellungen › Mods lässt sich das zurücknehmen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} 请求访问 {origins}，仅此而已。在其 mod.json 请求更多权限之前，它打开时随时可以这样做。可在“设置 → 模组”中收回。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} が {origins} への接続だけを求めています。開いている間はいつでも接続でき、mod.json がさらに求めるまで有効です。「設定」の「Mod」で取り消せます。"
          }
        }
      }
    },
    "{name} asks to {writes}, and to reach {origins} and nowhere else. It may do so whenever it is open, until its mod.json asks for more. Settings, Mods takes this back.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} demande à {writes}, et à accéder à {origins} et nulle part ailleurs. Il peut le faire à tout moment quand il est ouvert, jusqu'à ce que son mod.json en demande davantage. Réglages, Mods permet de le révoquer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} pide {writes}, y llegar a {origins} y a ningún otro sitio. Puede hacerlo siempre que esté abierto, hasta que su mod.json pida más. Ajustes, Mods lo revoca."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} möchte {writes} und {origins} erreichen, sonst nichts. Es darf das tun, solange es offen ist, bis seine mod.json mehr verlangt. Unter Einstellungen › Mods lässt sich das zurücknehmen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} 请求{writes}，并访问 {origins}，仅此而已。在其 mod.json 请求更多权限之前，它打开时随时可以这样做。可在“设置 → 模组”中收回。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} が {writes} と、{origins} への接続だけを求めています。開いている間はいつでも実行でき、mod.json がさらに求めるまで有効です。「設定」の「Mod」で取り消せます。"
          }
        }
      }
    },
