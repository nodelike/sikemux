    "Set as AWS_PROFILE for every agent, unless your own shell sets one.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Défini comme AWS_PROFILE pour chaque agent, sauf si votre propre shell en définit un."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se define como AWS_PROFILE para todos los agentes, salvo que tu propia shell defina uno."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für jeden Agent als AWS_PROFILE gesetzt, sofern deine eigene Shell keines setzt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为每个智能体设置为 AWS_PROFILE，除非你自己的 Shell 已设置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのシェルで設定されていない限り、すべてのエージェントの AWS_PROFILE として設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 셸에서 설정하지 않는 한 모든 에이전트의 AWS_PROFILE로 설정됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задаётся как AWS_PROFILE для каждого агента, если ваша оболочка не задаёт свой."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Definido como AWS_PROFILE para todos os agentes, a menos que seu próprio shell defina um."
          }
        }
      }
    },
    "Set as upstream": {
      "localizations": {
        "fr": {
          "stringUnit": {
