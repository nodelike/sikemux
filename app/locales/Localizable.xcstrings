    "Hand Sikemux's logs, secrets taken out, to Claude Code or Codex in a new terminal to find what is wrong": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confier les journaux de Sikemux, secrets retirés, à Claude Code ou Codex dans un nouveau terminal pour trouver ce qui ne va pas"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasar los registros de Sikemux, sin secretos, a Claude Code o Codex en una terminal nueva para averiguar qué falla"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux-Logs ohne Secrets an Claude Code oder Codex in einem neuen Terminal übergeben, um den Fehler zu finden"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将去除机密后的 Sikemux 日志交给新终端中的 Claude Code 或 Codex，找出问题所在"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シークレットを除いた Sikemux のログを新しいターミナルの Claude Code または Codex に渡して、問題を調べる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "민감한 정보를 뺀 Sikemux 로그를 새 터미널의 Claude Code나 Codex에 넘겨 문제를 찾기"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передать журналы Sikemux, без секретов, Claude Code или Codex в новом терминале, чтобы найти проблему"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entregar os logs do Sikemux, sem segredos, ao Claude Code ou Codex em um novo terminal para descobrir o que está errado"
          }
        }
      }
    },
    "Hand off always works in a git worktree of its own.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La passation se fait toujours dans un worktree git dédié."
          }
