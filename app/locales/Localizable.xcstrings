    "Teammates can't ask about this project": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coéquipiers ne peuvent pas poser de questions sur ce projet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los compañeros no pueden preguntar por este proyecto"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teammates können zu diesem Projekt nichts fragen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "队友无法询问此项目"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チームメイトはこのプロジェクトについて問い合わせできません"
          }
        }
      }
    },
    "Teammates read the tasks; their agents can ask yours about one. Nobody else's project is shared by this.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coéquipiers lisent les tâches ; leurs agents peuvent interroger les vôtres à leur sujet. Ceci ne partage le projet de personne d'autre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los compañeros leen las tareas; sus agentes pueden preguntar a los tuyos por una. Esto no comparte el proyecto de nadie más."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teammates lesen die Aufgaben; ihre Agents können deine dazu fragen. Kein anderes Projekt wird dadurch geteilt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "队友可阅读任务；他们的智能体可就某项任务询问你的智能体。这不会共享其他任何人的项目。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チームメイトはタスクを読めます。そのエージェントは、あなたのエージェントにタスクについて問い合わせできます。これで他のプロジェクトが共有されることはありません。"
          }
        }
      }
    },
