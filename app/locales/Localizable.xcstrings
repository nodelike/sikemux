    "Panes show the background Omarchy is showing, and change when it does.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los paneles muestran el fondo que muestra Omarchy y cambian cuando este cambia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "窗格显示 Omarchy 正在显示的背景，并随之变化。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bereiche zeigen den Hintergrund, den Omarchy zeigt, und wechseln mit ihm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les panneaux affichent l'arrière-plan d'Omarchy et changent avec lui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ペインに Omarchy が表示している背景を表示し、変わると追従します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "패널에 Omarchy가 표시하는 배경이 보이며, 배경이 바뀌면 함께 바뀝니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Панели показывают фон, который показывает Omarchy, и меняются вместе с ним."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os painéis mostram o fundo que o Omarchy está mostrando e mudam quando ele muda."
          }
        }
      }
    },
    "Parakeet by NVIDIA, run on the Neural Engine. About 600 MB, downloaded when you turn dictation on.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Parakeet de NVIDIA, ejecutado en el Neural Engine. Unos 600 MB, que se descargan al activar el dictado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "NVIDIA 的 Parakeet，在神经网络引擎上运行。约 600 MB，开启听写时下载。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Parakeet von NVIDIA, läuft auf der Neural Engine. Etwa 600 MB, geladen, wenn du das Diktat einschaltest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Parakeet de NVIDIA, exécuté sur le Neural Engine. Environ 600 Mo, téléchargé quand vous activez la dictée."
