            "value": "与主题边框同色的均匀圆点。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマの境界線の色で均等に並ぶドット。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마의 테두리 색으로 그린 균일한 점."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
