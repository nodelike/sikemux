    },
    "No agent or terminal had focus, so the dictation was copied to the clipboard.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun agent ni terminal n'était actif, la dictée a donc été copiée dans le presse-papiers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún agente ni terminal tenía el foco, así que el dictado se copió al portapapeles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Agent oder Terminal hatte den Fokus, daher wurde das Diktat in die Zwischenablage kopiert."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有智能体或终端处于焦点，因此听写内容已拷贝到剪贴板。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカスされたエージェントやターミナルがなかったため、音声入力の内容はクリップボードにコピーされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스된 에이전트나 터미널이 없어서 받아쓴 내용을 클립보드에 복사했습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни агент, ни терминал не были в фокусе, поэтому диктовка скопирована в буфер обмена."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum agente ou terminal estava em foco, então o ditado foi copiado para a área de transferência."
          }
        }
      }
    },
