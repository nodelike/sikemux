    "Unstaged changes to this file will be lost. This can't be undone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications non indexées de ce fichier seront perdues. Action irréversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios no preparados de este archivo se perderán. No se puede deshacer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht gestagte Änderungen an dieser Datei gehen verloren. Das kann nicht rückgängig gemacht werden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件未暂存的更改将丢失。此操作无法撤销。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルのステージされていない変更は失われます。この操作は元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일의 스테이징되지 않은 변경 사항이 사라집니다. 실행 취소할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неиндексированные изменения этого файла будут потеряны. Это нельзя отменить."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações não preparadas deste arquivo serão perdidas. Isso não pode ser desfeito."
          }
        }
      }
    },
