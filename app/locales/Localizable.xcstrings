            "state": "translated",
            "value": "Assistant Simulator"
          }
        }
      }
    },
    "Simulators": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulateurs"
          }
        }
      }
    },
    "Skills": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills"
          }
        }
      }
    },
    "Skills every agent Sikemux starts can use, in a terminal or a chat. They live only in Sikemux: the same agents run elsewhere never see them. Agents can make them too, with the skills tool. A new skill loads in the next session.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des skills que chaque agent démarré par Sikemux peut utiliser, dans un terminal ou un chat. Elles n'existent que dans Sikemux : les mêmes agents lancés ailleurs ne les voient jamais. Les agents peuvent aussi en créer, avec l'outil skills. Une nouvelle skill se charge à la session suivante."
          }
        }
      }
    },
    "Skills in each agent's global folder. Agents load these inside and outside Sikemux, and Sikemux leaves them alone unless you move one in.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les skills du dossier global de chaque agent. Les agents les chargent dans et hors de Sikemux, et Sikemux n'y touche pas sauf si vous en déplacez une dedans."
          }
        }
      }
    },
