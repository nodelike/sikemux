    },
    "It comes out of sikemux.json; commit that to remove it for the team.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se quita de sikemux.json; haz commit de eso para quitarlo para el equipo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将从 sikemux.json 中移除；提交后即为团队移除。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es wird aus sikemux.json entfernt; committe das, um es für das Team zu entfernen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il est retiré de sikemux.json ; commitez ce fichier pour le retirer pour l'équipe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "sikemux.json から削除されます。チームから削除するにはそれをコミットしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "sikemux.json에서 제거됩니다. 팀에서도 제거하려면 커밋하세요."
          }
        },
        "ru": {
          "stringUnit": {
