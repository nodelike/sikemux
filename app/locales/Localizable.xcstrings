    "{host} is out of reach, so this waits until it is back.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{host} est injoignable, ceci attend donc son retour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{host} está fuera de alcance, así que esto espera hasta que vuelva."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{host} ist nicht erreichbar, daher wartet das, bis er zurück ist."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{host} 无法访问，因此需等它恢复。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{host} に接続できないため、復帰するまで待機します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{host}에 연결할 수 없어서 다시 연결될 때까지 기다립니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{host} недоступен, поэтому это ждёт его возвращения."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "{host} está fora de alcance, então isto aguarda até ele voltar."
          }
        }
      }
    },
    "{host} is out of reach. Showing what it last said; changes wait until it is back.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{host} est injoignable. Affichage de ce qu'il a dit en dernier ; les modifications attendent son retour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{host} está fuera de alcance. Se muestra lo último que dijo; los cambios esperan hasta que vuelva."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{host} ist nicht erreichbar. Es wird gezeigt, was er zuletzt gesagt hat; Änderungen warten, bis er zurück ist."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{host} 无法访问。显示其最后的状态；更改会等它恢复后进行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{host} に接続できません。最後の状態を表示しています。変更は復帰するまで待機します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{host}에 연결할 수 없습니다. 마지막으로 받은 내용을 표시하며, 변경 사항은 다시 연결될 때까지 기다립니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{host} недоступен. Показано то, что он сообщил последним; изменения ждут его возвращения."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "{host} está fora de alcance. Mostrando o que ele disse por último; as mudanças aguardam até ele voltar."
          }
        }
      }
    },
