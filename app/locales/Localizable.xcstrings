        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "NVIDIA の Parakeet。Neural Engine で動作します。約 600 MB で、音声入力をオンにしたときにダウンロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
