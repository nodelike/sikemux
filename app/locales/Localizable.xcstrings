    "Scales labels and controls without loosening the layout.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met à l'échelle libellés et commandes sans desserrer la mise en page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escala etiquetas y controles sin alterar el diseño."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaliert Beschriftungen und Steuerelemente, ohne das Layout aufzulockern."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩放标签和控件，而不放松布局。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウトを広げずに、ラベルとコントロールを拡大縮小します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이아웃을 느슨하게 하지 않고 레이블과 컨트롤의 크기를 조절합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Масштабирует подписи и элементы управления, не растягивая макет."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta a escala de rótulos e controles sem afrouxar o layout."
          }
        }
      }
    },
