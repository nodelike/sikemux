        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠진 것이 있나요? 에이전트에게 알려 주거나 여기에 추가하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
