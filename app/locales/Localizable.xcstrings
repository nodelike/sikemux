    "{level}, since you said so in chat with {name} on {day}": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{level}, puisque vous l'avez dit dans le chat avec {name} le {day}"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{level}, porque lo dijiste en un chat con {name} el {day}"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{level}, weil du es im Chat mit {name} am {day} gesagt hast"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{level}，因为你在 {day}与 {name} 的聊天中这样说过"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{level}（{day} に {name} とのチャットであなたがそう指示したため）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{level}, {day}에 {name}과(와)의 채팅에서 그렇게 말했기 때문"
          }
        },
