        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Teams, in denen du bist. Ihre Modellschlüssel und Skills erscheinen neben deinen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
