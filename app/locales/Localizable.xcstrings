    "Refills your whole {what} now, from {used}% used back to 0%.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recharge entièrement votre {what} maintenant, de {used} % utilisé à 0 %."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recarga todo tu {what} ahora, del {used}% usado de vuelta al 0%."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füllt dein ganzes {what} jetzt auf, von {used}% genutzt zurück auf 0%."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即补满你的全部{what}，从已用 {used}% 恢复到 0%。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{what} 全体を今すぐ補充し、使用率を {used}% から 0% に戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 전체 {what}을(를) 채웁니다. 사용량 {used}%에서 0%로 돌아갑니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полностью восполняет {what} сейчас: с {used}% до 0%."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recarrega todo o seu {what} agora, de {used}% usado de volta para 0%."
          }
        }
      }
    },
    "Refills your {name} allowance and gives back what {name} used of your week.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recharge votre allocation {name} et vous rend ce que {name} a utilisé de votre semaine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recarga tu cupo de {name} y te devuelve lo que {name} usó de tu semana."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füllt dein {name}-Kontingent auf und gibt zurück, was {name} von deiner Woche genutzt hat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "补满你的 {name} 额度，并返还 {name} 本周用掉的量。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} の割り当てを補充し、今週 {name} が使用した分を戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} 허용량을 채우고 이번 주에 {name}이(가) 사용한 양을 돌려줍니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восполняет лимит {name} и возвращает то, что {name} израсходовал из вашей недели."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recarrega sua cota de {name} e devolve o que {name} usou da sua semana."
          }
        }
      }
    },
