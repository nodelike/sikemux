    "Add {install_dir} to your shell’s PATH. Sikemux never edits shell startup files.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez {install_dir} au PATH de votre shell. Sikemux ne modifie jamais les fichiers de démarrage du shell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade {install_dir} al PATH de tu shell. Sikemux nunca edita los archivos de inicio de la shell."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge {install_dir} zum PATH deiner Shell hinzu. Sikemux bearbeitet nie Shell-Startdateien."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 {install_dir} 添加到 Shell 的 PATH。Sikemux 从不编辑 Shell 启动文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{install_dir} をシェルの PATH に追加してください。Sikemux がシェルの起動ファイルを編集することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{install_dir}을(를) 셸의 PATH에 추가하세요. Sikemux는 셸 시작 파일을 수정하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте {install_dir} в PATH своей оболочки. Sikemux никогда не изменяет файлы запуска оболочки."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione {install_dir} ao PATH do seu shell. O Sikemux nunca edita arquivos de inicialização do shell."
          }
        }
      }
    },
