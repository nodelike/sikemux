    "Every device and host on your account stops reaching it at once. To add it again, sign it in again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todos los dispositivos y hosts de tu cuenta dejan de acceder a él al instante. Para volver a añadirlo, inicia sesión de nuevo en él."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你账户上的每台设备和主机都会立即无法访问它。要再次添加，请重新登录。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jedes Gerät und jeder Host auf deinem Account erreicht es sofort nicht mehr. Um es wieder hinzuzufügen, melde es erneut an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tous les appareils et hôtes de votre compte cessent aussitôt de l'atteindre. Pour l'ajouter à nouveau, reconnectez-le."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アカウント上のすべてのデバイスとホストがすぐに接続できなくなります。再度追加するには、もう一度サインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "계정의 모든 기기와 호스트가 즉시 접근할 수 없게 됩니다. 다시 추가하려면 다시 로그인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Все устройства и хосты в вашей учётной записи сразу теряют к нему доступ. Чтобы добавить его снова, войдите в нём заново."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todos os dispositivos e hosts da sua conta deixam de acessá-lo imediatamente. Para adicioná-lo de novo, faça login nele novamente."
          }
        }
      }
