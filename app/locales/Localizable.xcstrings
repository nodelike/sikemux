    "Sikemux runs it on each commit, and agents run it on a card's change when its pull request has no CI.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux lo ejecuta en cada commit, y los agentes lo ejecutan sobre el cambio de una tarjeta cuando su pull request no tiene CI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux 会在每次提交时运行它；当卡片的拉取请求没有 CI 时，代理会对该卡片的更改运行它。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux führt es bei jedem Commit aus, und Agents führen es bei der Änderung einer Karte aus, wenn ihr Pull Request keine CI hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux l'exécute à chaque commit, et les agents l'exécutent sur la modification d'une carte quand sa pull request n'a pas de CI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux はコミットごとにこれを実行し、プルリクエストに CI がない場合はエージェントがカードの変更に対して実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux는 커밋할 때마다 실행하며, 풀 리퀘스트에 CI가 없으면 에이전트가 카드의 변경 사항에 대해 실행합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux запускает её при каждом коммите, а агенты — на изменении карточки, если у её pull request нет CI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Sikemux o executa a cada commit, e os agentes o executam na mudança de um cartão quando o pull request dele não tem CI."
          }
        }
      }
    },
