          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede leer el formato de esta imagen del panel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Format dieses Bereichsbilds kann nicht gelesen werden."
