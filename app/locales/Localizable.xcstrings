    "Draws the phone's bezel and side buttons around its screen, as Simulator does. Without it the screen gets a little more room.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dibuja el marco y los botones laterales del teléfono alrededor de su pantalla, como hace Simulator. Sin él, la pantalla tiene un poco más de espacio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "像 Simulator 一样在屏幕周围绘制手机边框和侧边按钮。关闭后屏幕会多一点空间。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeichnet Rahmen und Seitentasten des Telefons um seinen Bildschirm, wie Simulator. Ohne bekommt der Bildschirm etwas mehr Platz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dessine le cadre et les boutons latéraux du téléphone autour de son écran, comme Simulator. Sans lui, l'écran a un peu plus de place."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Simulator と同様に、画面の周りに本体の枠とサイドボタンを描画します。オフにすると画面が少し広くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Simulator처럼 화면 주위에 휴대폰 베젤과 측면 버튼을 그립니다. 끄면 화면이 조금 더 넓어집니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Рисует рамку телефона и боковые кнопки вокруг экрана, как Simulator. Без неё экрану достаётся немного больше места."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desenha a moldura e os botões laterais do celular em volta da tela, como o Simulator faz. Sem ela, a tela ganha um pouco mais de espaço."
          }
        }
      }
    },
