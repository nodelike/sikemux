      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun trouvé. Dites à n'importe quel agent où le projet est livré, ou ajoutez-le ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ninguno. Dile a cualquier agente dónde se publica el proyecto, o añádelo aquí."
