    "Sikemux isn't allowed to read {path}": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux no tiene permiso para leer {path}"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux 无权读取 {path}"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux darf {path} nicht lesen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux n'est pas autorisé à lire {path}"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux には {path} の読み取りが許可されていません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux에 {path}을(를) 읽을 권한이 없음"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У Sikemux нет доступа на чтение {path}"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Sikemux não tem permissão para ler {path}"
          }
        }
      }
    },
    "Sikemux keeps your sign-in in the macOS Keychain.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux guarda tu inicio de sesión en el Llavero de macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux 将你的登录信息保存在 macOS 钥匙串中。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux bewahrt deine Anmeldung im macOS-Schlüsselbund auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux garde votre connexion dans le trousseau macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux はサインイン情報を macOS のキーチェーンに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux는 로그인 정보를 macOS 키체인에 보관합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux хранит ваш вход в Связке ключей macOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Sikemux guarda seu login no Keychain do macOS."
          }
        }
      }
    },
    "Sikemux keeps your sign-in where only Sikemux can read it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux guarda tu inicio de sesión donde solo Sikemux puede leerlo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux 将你的登录信息保存在只有 Sikemux 能读取的地方。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux bewahrt deine Anmeldung dort auf, wo nur Sikemux sie lesen kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux garde votre connexion là où seul Sikemux peut la lire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux はサインイン情報を Sikemux だけが読める場所に保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux는 로그인 정보를 Sikemux만 읽을 수 있는 곳에 보관합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux хранит ваш вход там, где его может прочитать только Sikemux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Sikemux guarda seu login onde só o Sikemux pode lê-lo."
          }
        }
      }
    },
    "Sikemux runs it on each commit, and agents run it on a card's change when its pull request has no CI.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux lo ejecuta en cada commit, y los agentes lo ejecutan sobre el cambio de una tarjeta cuando su pull request no tiene CI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux 会在每次提交时运行它；当卡片的拉取请求没有 CI 时，代理会对该卡片的更改运行它。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux führt es bei jedem Commit aus, und Agents führen es bei der Änderung einer Karte aus, wenn ihr Pull Request keine CI hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux l'exécute à chaque commit, et les agents l'exécutent sur la modification d'une carte quand sa pull request n'a pas de CI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux はコミットごとにこれを実行し、プルリクエストに CI がない場合はエージェントがカードの変更に対して実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux는 커밋할 때마다 실행하며, 풀 리퀘스트에 CI가 없으면 에이전트가 카드의 변경 사항에 대해 실행합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux запускает её при каждом коммите, а агенты — на изменении карточки, если у её pull request нет CI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Sikemux o executa a cada commit, e os agentes o executam na mudança de um cartão quando o pull request dele não tem CI."
          }
        }
      }
    },
    "Sikemux runs its commands without asking until the file changes.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux ejecuta sus comandos sin preguntar hasta que el archivo cambie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在文件更改之前，Sikemux 会直接运行其命令，不再询问。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux führt seine Befehle ohne Nachfrage aus, bis sich die Datei ändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux exécute ses commandes sans demander jusqu'à ce que le fichier change."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ファイルが変更されるまで、Sikemux は確認せずにコマンドを実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "파일이 변경될 때까지 Sikemux가 묻지 않고 명령을 실행합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux запускает его команды без запроса, пока файл не изменится."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Sikemux executa os comandos dele sem perguntar até o arquivo mudar."
          }
        }
      }
    },
    "Sikemux sends your last message again then. Click to not send it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux volverá a enviar tu último mensaje entonces. Haz clic para no enviarlo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "届时 Sikemux 会重新发送你的上一条消息。点按可取消发送。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux sendet deine letzte Nachricht dann erneut. Klicke, um sie nicht zu senden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sikemux renverra alors votre dernier message. Cliquez pour ne pas l'envoyer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "そのとき Sikemux が最後のメッセージを再送します。クリックすると送信しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "그때 Sikemux가 마지막 메시지를 다시 보냅니다. 보내지 않으려면 클릭하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Тогда Sikemux снова отправит ваше последнее сообщение. Нажмите, чтобы не отправлять."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Sikemux reenvia sua última mensagem nesse momento. Clique para não enviá-la."
          }
        }
      }
    },
