    "Resumable tabs come back asleep and start only when selected.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les onglets reprenables reviennent en veille et ne démarrent qu'une fois sélectionnés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas reanudables vuelven dormidas y solo se inician al seleccionarlas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsetzbare Tabs kommen schlafend zurück und starten erst, wenn sie ausgewählt werden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可恢复的标签页会以休眠状态回来，仅在选中时启动。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再開可能なタブはスリープ状態で戻り、選択したときにだけ起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재개할 수 있는 탭은 잠자기 상태로 돌아오며 선택할 때만 시작됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возобновляемые вкладки возвращаются в спящем режиме и запускаются только при выборе."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abas retomáveis voltam dormindo e só iniciam quando selecionadas."
          }
        }
      }
    },
