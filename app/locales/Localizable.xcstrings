    "Compact fits more sessions while keeping every state symbol visible.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El modo compacto muestra más sesiones y mantiene visibles todos los símbolos de estado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "紧凑模式可容纳更多会话，同时保留所有状态符号。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kompakt zeigt mehr Sitzungen und lässt jedes Statussymbol sichtbar."
          }
        },
        "fr": {
          "stringUnit": {
