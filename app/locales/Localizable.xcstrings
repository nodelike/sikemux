    "Spent now, it gives {time} back before the limit refills by itself.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisée maintenant, elle rend {time} avant que la limite ne se recharge d'elle-même."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se gasta ahora, devuelve {time} antes de que el límite se recargue solo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt verbraucht, gibt es {time} zurück, bevor sich das Limit von selbst auffüllt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在用掉，可比额度自动重置提前 {time} 补回。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今使うと、上限が自然に補充されるより {time} 早く戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 쓰면 한도가 저절로 채워지기 전에 {time}만큼 돌려받습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если использовать сейчас, вернёт {time} раньше, чем лимит восполнится сам."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se gasto agora, devolve {time} antes de o limite recarregar sozinho."
          }
        }
      }
    },
