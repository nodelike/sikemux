        }
      }
    },
    "A terminal tab, a split, a popup, a background toast, or this pane.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un onglet de terminal, une division, une fenêtre surgissante, une notification en arrière-plan ou ce panneau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
