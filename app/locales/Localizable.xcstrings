    "Sikemux is on {alias} but its core is stopped. Starting runs sikemux start there.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux est sur {alias} mais son cœur est arrêté. Démarrer y lance sikemux start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux está en {alias}, pero su núcleo está detenido. Al iniciarlo se ejecuta sikemux start allí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux ist auf {alias}, aber sein Core ist gestoppt. Starten führt dort sikemux start aus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{alias} 上有 Sikemux，但其核心已停止。启动会在那里运行 sikemux start。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux は {alias} にありますが、コアが停止しています。開始すると、そこで sikemux start を実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{alias}에 Sikemux가 있지만 코어가 중지되어 있습니다. 시작하면 그곳에서 sikemux start를 실행합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux есть на {alias}, но его ядро остановлено. Запуск выполнит там sikemux start."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sikemux está em {alias}, mas o núcleo está parado. Iniciar executa sikemux start lá."
          }
        }
      }
    },
    "Sikemux is on {alias} but not signed in. Signing in runs sikemux login there over your SSH and adds it to your account.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux est sur {alias} mais n'est pas connecté. Se connecter y lance sikemux login via votre SSH et l'ajoute à votre compte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux está en {alias}, pero sin sesión iniciada. Al iniciar sesión se ejecuta sikemux login allí a través de tu SSH y se añade a tu cuenta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux ist auf {alias}, aber nicht angemeldet. Anmelden führt dort sikemux login über dein SSH aus und fügt es deinem Account hinzu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{alias} 上有 Sikemux，但未登录。登录会通过你的 SSH 在那里运行 sikemux login，并将其添加到你的账户。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux は {alias} にありますが、サインインしていません。サインインすると、SSH 経由でそこで sikemux login を実行し、アカウントに追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{alias}에 Sikemux가 있지만 로그인되어 있지 않습니다. 로그인하면 SSH를 통해 그곳에서 sikemux login을 실행하고 계정에 추가합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux есть на {alias}, но вход не выполнен. Вход выполнит там sikemux login через ваш SSH и добавит его в вашу учётную запись."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sikemux está em {alias}, mas sem login. Fazer login executa sikemux login lá pelo seu SSH e o adiciona à sua conta."
