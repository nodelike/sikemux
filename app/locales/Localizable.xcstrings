          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es ging nicht nach {label}: {error}"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il n'est pas allé vers {label} : {error}"
          }
        },
        "ja": {
