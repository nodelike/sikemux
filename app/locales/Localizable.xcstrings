          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux 信号面板"
          }
        }
      }
    },
    "Sikemux tried once.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux a essayé une fois."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux lo intentó una vez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux hat es einmal versucht."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux 尝试了一次。"
          }
        }
      }
    },
    "Sikemux tried {tries} times.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux a essayé {tries} fois."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux lo intentó {tries} veces."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux hat es {tries}-mal versucht."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux 尝试了 {tries} 次。"
          }
        }
      }
    },
    "Sikemux will not overwrite {path}. Move the existing file yourself, then refresh.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux n'écrasera pas {path}. Déplacez vous-même le fichier existant, puis actualisez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux no sobrescribirá {path}. Mueve tú el archivo existente y luego actualiza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux überschreibt {path} nicht. Verschiebe die vorhandene Datei selbst und aktualisiere dann."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux 不会覆盖 {path}。请自行移走现有文件，然后刷新。"
          }
        }
      }
    },
    "Simulator": {
      "localizations": {
        "fr": {
          "stringUnit": {
