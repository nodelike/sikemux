    "Sign-in stopped. Its output is on the right.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion arrêtée. Sa sortie est à droite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión se detuvo. Su salida está a la derecha."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldung gestoppt. Ihre Ausgabe steht rechts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录已停止。其输出在右侧。"
          }
        }
      }
    },
    "Sign-ins on this host move into the account's vault, sealed so the accounts server cannot read them, and every host on the account can use them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les connexions de cet hôte vont dans le coffre du compte, scellées pour que le serveur de comptes ne puisse pas les lire, et chaque hôte du compte peut les utiliser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los inicios de sesión de este host pasan a la bóveda de la cuenta, sellados para que el servidor de cuentas no pueda leerlos, y todos los hosts de la cuenta pueden usarlos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldungen auf diesem Host wandern in den Tresor des Accounts, versiegelt, sodass der Account-Server sie nicht lesen kann, und jeder Host des Accounts kann sie nutzen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此主机上的登录信息会移入账户保险库并加密密封，账户服务器无法读取，账户中的每台主机都可以使用。"
          }
        }
      }
    },
