          "stringUnit": {
            "state": "needs_review",
            "value": "프로젝트는 열린 상태로 모두 아래에 표시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Его проекты остаются открытыми и показываются в разделе «Все»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os projetos continuam abertos e aparecem em Todos."
          }
        }
      }
    },
    "Its unsaved changes are lost.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sus cambios sin guardar se pierden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "其未保存的更改将丢失。"
          }
        },
