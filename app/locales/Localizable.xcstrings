        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即休眠"
          }
        }
      }
    },
    "Smaller text in the focused editor or chat, or in every terminal": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte plus petit dans l'éditeur ou le chat actif, ou dans tous les terminaux"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto más pequeño en el editor o chat enfocado, o en todas las terminales"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleinerer Text im fokussierten Editor oder Chat oder in allen Terminals"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩小聚焦的编辑器或聊天中的文字，或所有终端中的文字"
          }
        }
      }
    },
    "Smart": {
      "localizations": {
        "fr": {
