        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que envían los agentes y nada puede ubicar aparece aquí después de ejecutarse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was Agents verschicken und nichts zuordnen kann, erscheint hier, nachdem es gelaufen ist."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体发出但无处安放的内容，运行后会显示在这里。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが送り出したもので配置先がないものは、実行後にここに表示されます。"
          }
