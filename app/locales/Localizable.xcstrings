            "value": "Deine eigenen Skills"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你自己的技能"
          }
        }
      }
    },
    "Your phone finds this host through it. Sign in with Google, GitHub or your email, in your browser.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre téléphone trouve cet hôte par ce biais. Connectez-vous avec Google, GitHub ou votre e-mail, dans votre navigateur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu teléfono encuentra este host a través de ella. Inicia sesión con Google, GitHub o tu correo, en tu navegador."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Telefon findet diesen Host darüber. Melde dich mit Google, GitHub oder deiner E-Mail in deinem Browser an."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的手机通过它找到此主机。在浏览器中用 Google、GitHub 或你的电子邮件登录。"
          }
        }
      }
    },
    "Your processes": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos processus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus procesos"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Prozesse"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的进程"
          }
        }
      }
    },
    "Your terminals and agents kept running while Sikemux was closed. Use Quit and Stop Everything ({keys}) to stop them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos terminaux et agents ont continué de tourner pendant que Sikemux était fermé. Utilisez Quitter et tout arrêter ({keys}) pour les arrêter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus terminales y agentes siguieron en marcha mientras Sikemux estaba cerrado. Usa Salir y detener todo ({keys}) para detenerlos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Terminals und Agents liefen weiter, während Sikemux geschlossen war. Nutze „Beenden und alles stoppen“ ({keys}), um sie zu stoppen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux 关闭期间，你的终端和智能体仍在运行。使用“退出并停止全部”（{keys}）来停止它们。"
          }
        }
      }
    },
    "Your theme, shortcuts, chat and agent choices, skills and themes follow you to every linked host.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre thème, vos raccourcis, vos choix de chat et d'agent, vos skills et vos thèmes vous suivent sur chaque hôte lié."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu tema, atajos, elecciones de chat y agente, habilidades y temas te siguen a todos los hosts enlazados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Theme, Tastenkürzel, Chat- und Agent-Auswahl, Skills und Themes folgen dir auf jeden verknüpften Host."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的主题、快捷键、聊天和智能体选择、技能会跟随你到每台已关联的主机。"
          }
        }
      }
    },
