    "Sikemux forgets this App on every computer that has it. It stays on GitHub until you delete it there.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux oublie cette App sur chaque ordinateur qui l'a. Elle reste sur GitHub jusqu'à ce que vous l'y supprimiez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux olvida esta App en todos los ordenadores que la tienen. Sigue en GitHub hasta que la elimines allí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux vergisst diese App auf jedem Computer, der sie hat. Auf GitHub bleibt sie, bis du sie dort löschst."
          }
        }
      }
    },
    "Sikemux here": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux ici"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux aquí"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux hier"
          }
        }
      }
    },
    "Sikemux is not answering": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux ne répond pas"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux no responde"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux antwortet nicht"
          }
        }
      }
    },
    "Sikemux is on {alias} but its core is stopped. Starting runs sikemux start there.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux est sur {alias} mais son cœur est arrêté. Démarrer y lance sikemux start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux está en {alias}, pero su núcleo está detenido. Al iniciarlo se ejecuta sikemux start allí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux ist auf {alias}, aber sein Core ist gestoppt. Starten führt dort sikemux start aus."
          }
        }
      }
    },
    "Sikemux is on {alias} but not signed in. Signing in runs sikemux login there over your SSH and adds it to your account.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux est sur {alias} mais n'est pas connecté. Se connecter y lance sikemux login via votre SSH et l'ajoute à votre compte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux está en {alias}, pero sin sesión iniciada. Al iniciar sesión se ejecuta sikemux login allí a través de tu SSH y se añade a tu cuenta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux ist auf {alias}, aber nicht angemeldet. Anmelden führt dort sikemux login über dein SSH aus und fügt es deinem Account hinzu."
          }
        }
      }
    },
    "Sikemux is stopped": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux est arrêté"
          }
