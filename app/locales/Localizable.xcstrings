          "stringUnit": {
            "state": "translated",
            "value": "このリポジトリにはまだブランチがありません。"
          }
        }
      }
    },
    "This repository has no remote yet": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dépôt n'a pas encore de remote"
