    "Others' tasks are read only.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches des autres sont en lecture seule."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas de otros son de solo lectura."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben anderer sind schreibgeschützt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "他人的任务为只读。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他の人のタスクは読み取り専用です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사람의 작업은 읽기 전용입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чужие задачи только для чтения."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas dos outros são somente leitura."
          }
        }
      }
    },
    "Others' tasks are read only; your agents can ask about them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches des autres sont en lecture seule ; vos agents peuvent poser des questions dessus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas de otros son de solo lectura; tus agentes pueden preguntar por ellas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben anderer sind schreibgeschützt; deine Agents können danach fragen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "他人的任务为只读；你的智能体可以询问相关内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他の人のタスクは読み取り専用です。あなたのエージェントは内容を問い合わせできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사람의 작업은 읽기 전용이며, 내 에이전트가 문의할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чужие задачи только для чтения; ваши агенты могут спрашивать о них."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas dos outros são somente leitura; seus agentes podem perguntar sobre elas."
          }
        }
      }
    },
    "Otherwise a request offers Open in Sikemux instead of Deny and Allow.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinon, une demande propose Ouvrir dans Sikemux au lieu de Refuser et Autoriser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no, una solicitud ofrece Abrir en Sikemux en lugar de Denegar y Permitir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonst bietet eine Anfrage „In Sikemux öffnen“ statt „Ablehnen“ und „Erlauben“."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "否则，请求会显示“在 Sikemux 中打开”，而不是“拒绝”和“允许”。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフの場合、リクエストには「拒否」と「許可」の代わりに「Sikemux で開く」が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그렇지 않으면 요청에 거부와 허용 대신 Sikemux에서 열기가 표시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Иначе в запросе вместо «Запретить» и «Разрешить» будет «Открыть в Sikemux»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caso contrário, uma solicitação oferece Abrir no Sikemux em vez de Negar e Permitir."
          }
        }
      }
    },
