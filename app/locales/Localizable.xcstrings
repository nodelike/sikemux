    "Panes show the background Omarchy is showing, and change when it does.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los paneles muestran el fondo que muestra Omarchy y cambian cuando este cambia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "窗格显示 Omarchy 正在显示的背景，并随之变化。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bereiche zeigen den Hintergrund, den Omarchy zeigt, und wechseln mit ihm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les panneaux affichent l'arrière-plan d'Omarchy et changent avec lui."
