          }
        }
      }
    },
    "Some agents can't be carried over yet. Within two minutes the update goes on and starts them again on their sessions. Open to see them or update now.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains agents ne peuvent pas encore être repris. Dans deux minutes, la mise à jour continue et les redémarre sur leurs sessions. Ouvrez pour les voir ou mettez à jour maintenant."
          }
        }
      }
    },
    "Something happened outside #{id}": {
      "localizations": {
        "fr": {
