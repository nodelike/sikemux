    "For a host you also use for work. Each new sign-in stays out of the vault until you move it in.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour un hôte que vous utilisez aussi pour le travail. Chaque nouvelle connexion reste hors du coffre jusqu'à ce que vous l'y mettiez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para un host que también usas para trabajar. Cada inicio de sesión nuevo queda fuera de la bóveda hasta que lo pases a ella."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für einen Host, den du auch für die Arbeit nutzt. Jede neue Anmeldung bleibt außerhalb des Tresors, bis du sie hineinlegst."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于你也用来工作的主机。每个新登录在你移入保险库前都不会进入其中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仕事にも使うホスト向け。新しいサインインは、あなたが移すまで保管庫に入りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업무에도 쓰는 호스트용입니다. 새 로그인은 직접 옮기기 전까지 보관함에 들어가지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для хоста, который вы используете и для работы. Каждый новый вход остаётся вне хранилища, пока вы не перенесёте его туда."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para um host que você também usa no trabalho. Cada novo login fica fora do cofre até você movê-lo para dentro."
          }
        }
      }
    },
    "For the team": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour l'équipe"
          }
        },
        "es": {
          "stringUnit": {
