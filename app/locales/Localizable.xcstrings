    "Say what it sends.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites ce qu'il envoie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica qué envía."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag, was es sendet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说明它发送什么。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信する内容を説明してください。"
          }
        },
        "ko": {
          "stringUnit": {
