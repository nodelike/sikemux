        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux ist auf dem Kanal {channel} aktuell."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux 已是 {channel} 渠道的最新版本。"
          }
        }
      }
    },
    "Sikemux isn't allowed to read {path}": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux n'est pas autorisé à lire {path}"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux no tiene permiso para leer {path}"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux darf {path} nicht lesen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux 无权读取 {path}"
          }
        }
      }
