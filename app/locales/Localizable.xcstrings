    "How Sikemux tells you an agent needs you or a goal moved": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment Sikemux vous signale qu'un agent a besoin de vous ou qu'un objectif a bougé"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo te avisa Sikemux de que un agente te necesita o de que un objetivo avanzó"
          }
        },
