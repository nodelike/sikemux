        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Панель, созданная вами или агентом"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um painel que você ou um agente criou"
          }
        }
      }
    },
    "A picture shared by every pane, dithered in place of the grain.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una imagen compartida por todos los paneles, tramada en lugar del grano."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "所有面板共用的一张图片，以抖动方式代替颗粒。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Bild für alle Bereiche, gerastert statt der Körnung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une image partagée par tous les panneaux, tramée à la place du grain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "すべてのパネルで共有する画像。粒子の代わりにディザ処理されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "모든 패널이 함께 쓰는 이미지로, 그레인 대신 디더링됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Изображение для всех панелей, растрированное вместо зерна."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma imagem compartilhada por todos os painéis, pontilhada no lugar do grão."
          }
        }
      }
    },
    "A redacted operational snapshot. Terminal text, environment values, credentials, and API secrets are never included.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una instantánea operativa censurada. Nunca incluye texto de terminal, valores de entorno, credenciales ni secretos de API."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "经过脱敏的运行快照。绝不包含终端文本、环境变量值、凭据和 API 密钥。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein geschwärzter Betriebs-Snapshot. Terminaltext, Umgebungswerte, Anmeldedaten und API-Secrets sind nie enthalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un instantané opérationnel expurgé. Le texte des terminaux, les valeurs d'environnement, les identifiants et les secrets d'API n'y figurent jamais."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "機密情報を除いた動作スナップショット。ターミナルのテキスト、環境変数の値、認証情報、API シークレットは含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "민감한 정보를 가린 운영 스냅샷. 터미널 텍스트, 환경 변수 값, 자격 증명, API 시크릿은 포함되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Обезличенный снимок работы. Текст терминала, значения переменных окружения, учётные данные и секреты API никогда не включаются."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um retrato operacional ocultado. Texto do terminal, valores de ambiente, credenciais e segredos de API nunca são incluídos."
          }
        }
      }
    },
    "A short notification when slices land, a goal finishes or its ETA slips, and never for what you're looking at. What needs you always notifies.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un aviso breve cuando llegan partes del trabajo, termina un objetivo o se retrasa su ETA, y nunca de lo que estás mirando. Lo que te necesita siempre avisa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "切片完成、目标完成或其 ETA 推迟时发送简短通知，但不会针对你正在查看的内容。需要你处理的事项总会通知。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine kurze Mitteilung, wenn Teile ankommen, ein Ziel fertig wird oder seine ETA sich verschiebt – nie für das, was du gerade ansiehst. Was dich braucht, meldet sich immer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une courte notification quand des tranches arrivent, qu'un objectif se termine ou que son ETA glisse, jamais pour ce que vous regardez. Ce qui a besoin de vous notifie toujours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "スライスが完了したとき、ゴールが完了したとき、またはその ETA が遅れたときに短い通知を送ります。表示中のものについては通知しません。対応が必要なものは常に通知します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "작업 조각이 완료되거나, 목표가 끝나거나, ETA가 늦어지면 짧게 알립니다. 보고 있는 항목은 알리지 않습니다. 확인이 필요한 항목은 항상 알립니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Короткое уведомление, когда готовы части работы, цель выполнена или её ETA сдвигается, но не о том, что вы сейчас смотрите. О том, что требует вас, уведомление приходит всегда."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um aviso curto quando partes do trabalho chegam, uma meta termina ou seu ETA atrasa, e nunca sobre o que você está vendo. O que precisa de você sempre avisa."
          }
        }
      }
    },
    "A sign-in lasts 30 days. Removing an app cuts it off at once.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un inicio de sesión dura 30 días. Quitar una app la desconecta al instante."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "登录有效期为 30 天。移除应用会立即使其失效。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Anmeldung gilt 30 Tage. Das Entfernen einer App trennt sie sofort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une connexion dure 30 jours. Retirer une app la coupe aussitôt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "サインインは 30 日間有効です。アプリを削除するとすぐに切断されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "로그인은 30일 동안 유지됩니다. 앱을 제거하면 즉시 끊깁니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вход действует 30 дней. Удаление приложения сразу отключает его."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um login dura 30 dias. Remover um app o desconecta imediatamente."
          }
        }
      }
    },
    "A terminal tab in this project, another login on this host, or a new terminal under Terminals": {
