    "{added} new files are deleted and the rest go back to what is staged or committed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{added} nouveaux fichiers sont supprimés et les autres reviennent à leur état indexé ou commité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminan {added} archivos nuevos y el resto vuelve a lo que está preparado o con commit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{added} neue Dateien werden gelöscht, der Rest kehrt zum gestagten oder committeten Stand zurück."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{added} 个新文件将被删除，其余恢复到已暂存或已提交的状态。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいファイル {added} 件が削除され、残りはステージ済みまたはコミット済みの状態に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 파일 {added}개가 삭제되고 나머지는 스테이징되거나 커밋된 상태로 되돌아갑니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые файлы ({added}) будут удалены, а остальные вернутся к проиндексированному или закоммиченному состоянию."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "{added} arquivos novos são excluídos e o resto volta ao que está preparado ou no commit."
          }
        }
      }
    },
    "{agents} and {last} chats can run on it from the model picker.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les chats {agents} et {last} peuvent s'exécuter dessus depuis le sélecteur de modèle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los chats de {agents} y {last} pueden ejecutarse en él desde el selector de modelos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{agents}- und {last}-Chats können es über die Modellauswahl nutzen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{agents} 和 {last} 聊天可从模型选择器中在其上运行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{agents} と {last} のチャットは、モデルピッカーからこれで実行できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{agents} 및 {last} 채팅이 모델 선택기에서 이를 사용할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чаты {agents} и {last} могут работать на нём через выбор модели."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats de {agents} e {last} podem rodar nele pelo seletor de modelos."
          }
        }
      }
    },
