    "Every other host on the account loses this sign-in. It leaves the vault and stays on this host alone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les autres hôtes du compte perdent cette connexion. Elle quitte le coffre et reste sur cet hôte seul."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los demás hosts de la cuenta pierden este inicio de sesión. Sale de la bóveda y se queda solo en este host."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
