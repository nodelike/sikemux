            "value": "Sur {host}"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En {host}"
          }
        }
      }
    },
    "Once": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez"
          }
        }
      }
    },
    "Once a day, sends a random install ID and a one-way hash of your account with the app version, update channel and system version, and the day before's totals: tokens by agent and model, turns, sessions, commits and how often each feature was used. When Sikemux crashes, sends where in its code and what it had just logged, with no paths. Never your files, prompts, commands or projects.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois par jour, envoie un identifiant d'installation aléatoire et une empreinte à sens unique de votre compte avec la version de l'app, le canal de mise à jour et la version du système, ainsi que les totaux de la veille : tokens par agent et par modèle, tours, sessions, commits et fréquence d'utilisation de chaque fonction. Quand Sikemux plante, envoie l'endroit du code concerné et ce qu'il venait de journaliser, sans chemins. Jamais vos fichiers, prompts, commandes ou projets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez al día, envía un ID de instalación aleatorio y un hash unidireccional de tu cuenta con la versión de la app, el canal de actualización y la versión del sistema, y los totales del día anterior: tokens por agente y modelo, turnos, sesiones, commits y cuánto se usó cada función. Cuando Sikemux falla, envía en qué parte de su código y lo último que había registrado, sin rutas. Nunca tus archivos, prompts, comandos ni proyectos."
          }
        }
      }
    },
    "One at a time": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un à la fois"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno a la vez"
          }
        }
      }
    },
    "One level less": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un niveau de moins"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nivel menos"
          }
        }
      }
    },
    "One level more": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un niveau de plus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nivel más"
          }
        }
      }
    },
    "One of your own skills has this name too.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'une de vos propres skills porte aussi ce nom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una de tus propias skills también tiene este nombre."
          }
        }
      }
    },
    "One palette for the chrome, the editor and the terminal": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une palette pour l'interface, l'éditeur et le terminal"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una paleta para la interfaz, el editor y la terminal"
          }
        }
      }
    },
    "Only allow a sign-in you just started. Remove an app any time in Settings → Other apps.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'autorisez qu'une connexion que vous venez de lancer. Retirez une app à tout moment dans Réglages → Autres apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite solo un inicio de sesión que acabes de empezar. Quita una app cuando quieras en Ajustes → Otras apps."
          }
        }
      }
    },
    "Only allow phones you own. Remove one any time on the Devices page.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'autorisez que les téléphones qui vous appartiennent. Retirez-en un à tout moment sur la page Appareils."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite solo teléfonos que sean tuyos. Quita uno cuando quieras en la página Dispositivos."
          }
        }
      }
    },
    "Only confirmed native session IDs are written to disk. Startup commands and terminal output never are.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les identifiants de session natifs confirmés sont écrits sur le disque. Jamais les commandes de démarrage ni la sortie du terminal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se guardan en disco los ID de sesión nativos confirmados. Los comandos de inicio y la salida de la terminal, nunca."
          }
        }
      }
    },
    "Only me": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moi seul"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo yo"
          }
        }
      }
    },
    "Only one agent holds it; the rest wait in line and are woken on their turn.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul agent la détient ; les autres font la queue et sont réveillés à leur tour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un agente lo tiene; los demás esperan en fila y se despiertan cuando les toca."
          }
        }
      }
    },
    "Only the Command Line Tools are selected, and simulators need Xcode. Install Xcode, or choose it with xcode-select.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les Command Line Tools sont sélectionnés, et les simulateurs ont besoin de Xcode. Installez Xcode, ou choisissez-le avec xcode-select."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo están seleccionadas las Command Line Tools y los simuladores necesitan Xcode. Instala Xcode o elígelo con xcode-select."
