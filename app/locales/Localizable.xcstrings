        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est retiré de sikemux.json ; commitez ce fichier pour le retirer pour l'équipe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quita de sikemux.json; haz commit de eso para quitarlo para el equipo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird aus sikemux.json entfernt; committe das, um es für das Team zu entfernen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将从 sikemux.json 中移除；提交后即为团队移除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "sikemux.json から削除されます。チームから削除するにはそれをコミットしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "sikemux.json에서 제거됩니다. 팀에서도 제거하려면 커밋하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляется из sikemux.json; закоммитьте его, чтобы убрать это для команды."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele sai de sikemux.json; faça commit disso para removê-lo para a equipe."
          }
        }
      }
    },
    "It did not go to {label}: {error}": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'est pas allé vers {label} : {error}"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No llegó a {label}: {error}"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ging nicht nach {label}: {error}"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能发送到 {label}：{error}"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{label} には移動しませんでした：{error}"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{label}(으)로 보내지 못함: {error}"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не перенесено на {label}: {error}"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi para {label}: {error}"
          }
        }
      }
    },
    "It gets its address once added; each request to it fires the trigger.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il reçoit son adresse dès son ajout ; chaque requête qui l'atteint le déclenche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtiene su dirección al añadirlo; cada solicitud que recibe activa el disparador."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es bekommt seine Adresse, sobald es hinzugefügt ist; jede Anfrage daran löst den Trigger aus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加后它会获得地址；每次对该地址的请求都会触发该触发器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加するとアドレスが発行されます。そこへのリクエストごとにトリガーが発火します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가하면 주소가 생기며, 이 주소로 요청이 올 때마다 트리거가 실행됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрес появится после добавления; каждый запрос по нему запускает триггер."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele recebe seu endereço depois de adicionado; cada requisição a ele dispara o gatilho."
          }
        }
      }
    },
    "It has commits that are not in the branch it started from. Deleting it loses any that were not pushed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle contient des commits absents de la branche d'origine. La supprimer perd ceux qui n'ont pas été poussés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene commits que no están en la rama de la que partió. Al eliminarla se pierden los que no se enviaron."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er hat Commits, die nicht im Ausgangsbranch sind. Beim Löschen gehen alle verloren, die nicht gepusht wurden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它有不在其起始分支中的提交。删除后，任何未推送的提交都将丢失。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始元のブランチにないコミットがあります。削除すると、プッシュされていないコミットは失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작한 브랜치에 없는 커밋이 있습니다. 삭제하면 푸시되지 않은 커밋이 사라집니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В ней есть коммиты, которых нет в ветке, от которой она начиналась. При удалении все незапушенные будут потеряны."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele tem commits que não estão no branch de onde começou. Excluí-lo perde os que não foram enviados."
          }
        }
      }
    },
    "It has not been online since this computer last heard of it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'a pas été en ligne depuis la dernière fois que cet ordinateur a eu de ses nouvelles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No ha estado en línea desde la última vez que este ordenador supo de él."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es war nicht online, seit dieser Computer zuletzt davon gehört hat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自此电脑上次获知它以来，它一直未上线。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコンピュータが最後に確認して以来、オンラインになっていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 컴퓨터가 마지막으로 확인한 이후 온라인 상태였던 적이 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он не был в сети с тех пор, как этот компьютер последний раз получал о нём сведения."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não ficou online desde a última vez que este computador soube dele."
          }
        }
      }
    },
    "It is not signed in yet.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'est pas encore connecté."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no ha iniciado sesión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist noch nicht angemeldet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它尚未登录。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだサインインしていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 로그인되지 않았습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход ещё не выполнен."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não está conectado."
          }
        }
      }
    },
    "It is signed in to your Sikemux account. Allow or decline it in Sikemux.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est connecté à votre compte Sikemux. Autorisez-le ou refusez-le dans Sikemux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha iniciado sesión en tu cuenta de Sikemux. Permítelo o recházalo en Sikemux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist bei deinem Sikemux-Account angemeldet. Erlaube oder lehne es in Sikemux ab."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它已登录你的 Sikemux 账户。在 Sikemux 中允许或拒绝它。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux アカウントにサインインしています。Sikemux で許可または拒否してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikemux 계정에 로그인되어 있습니다. Sikemux에서 허용하거나 거절하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он вошёл в вашу учётную запись Sikemux. Разрешите или отклоните его в Sikemux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Está conectado à sua conta do Sikemux. Permita ou recuse no Sikemux."
          }
        }
      }
    },
    "It is signed out of your account and taken off every host at once. To use it again, sign it in again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est déconnecté de votre compte et retiré de tous les hôtes à la fois. Pour l'utiliser à nouveau, reconnectez-le."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cierra su sesión en tu cuenta y se quita de todos los hosts a la vez. Para volver a usarlo, inicia sesión otra vez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird von deinem Account abgemeldet und sofort von jedem Host entfernt. Um es wieder zu nutzen, melde es erneut an."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它将退出你的账户，并立即从所有主机上移除。要再次使用，请重新登录。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントからサインアウトされ、すべてのホストからすぐに削除されます。再度使用するには、もう一度サインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정에서 로그아웃되고 모든 호스트에서 즉시 제거됩니다. 다시 사용하려면 다시 로그인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он выходит из вашей учётной записи и сразу удаляется со всех хостов. Чтобы снова его использовать, войдите заново."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É desconectado da sua conta e removido de todos os hosts de uma vez. Para usá-lo de novo, faça login nele novamente."
          }
        }
      }
    },
    "It is signing in from this computer. Allow or decline it in Sikemux.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il se connecte depuis cet ordinateur. Autorisez-le ou refusez-le dans Sikemux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está iniciando sesión desde este ordenador. Permítelo o recházalo en Sikemux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es meldet sich von diesem Computer aus an. Erlaube oder lehne es in Sikemux ab."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它正从此电脑登录。在 Sikemux 中允许或拒绝它。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコンピュータからサインイン中です。Sikemux で許可または拒否してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 컴퓨터에서 로그인하는 중입니다. Sikemux에서 허용하거나 거절하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он входит с этого компьютера. Разрешите или отклоните его в Sikemux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Está fazendo login a partir deste computador. Permita ou recuse no Sikemux."
          }
        }
      }
    },
    "It keeps running after Sikemux quits, as your agents do.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il continue de tourner après la fermeture de Sikemux, comme vos agents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue ejecutándose después de cerrar Sikemux, igual que tus agentes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es läuft weiter, wenn Sikemux beendet wird, wie deine Agents."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会在 Sikemux 退出后继续运行，就像你的智能体一样。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントと同様に、Sikemux を終了しても動作し続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트처럼 Sikemux를 종료한 후에도 계속 실행됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он продолжает работать после выхода из Sikemux, как и ваши агенты."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua rodando depois que o Sikemux fecha, como seus agentes."
          }
        }
      }
    },
    "It may be off, asleep or offline, or its core stopped.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est peut-être éteint, en veille ou hors ligne, ou son cœur s'est arrêté."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que esté apagado, en reposo o sin conexión, o que su núcleo se haya detenido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist vielleicht aus, im Ruhezustand oder offline, oder sein Core wurde gestoppt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它可能已关机、睡眠或离线，或其核心已停止。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電源が切れているか、スリープ中かオフラインか、コアが停止している可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꺼져 있거나, 잠자기 중이거나, 오프라인이거나, 코어가 중지되었을 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возможно, он выключен, спит или не в сети либо его ядро остановилось."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode estar desligado, em repouso ou offline, ou o núcleo dele parou."
          }
        }
      }
    },
    "It may be offline, or a firewall blocks it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est peut-être hors ligne, ou un pare-feu le bloque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que esté sin conexión o que un cortafuegos lo bloquee."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist vielleicht offline, oder eine Firewall blockiert es."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它可能已离线，或被防火墙阻止。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインか、ファイアウォールでブロックされている可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인이거나 방화벽이 차단하고 있을 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возможно, он не в сети или его блокирует брандмауэр."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode estar offline, ou um firewall o bloqueia."
          }
        }
      }
    },
    "It restarts once you leave the keys for 10 minutes; terminals and chats carry over.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il redémarre quand vous n'avez pas touché au clavier depuis 10 minutes ; terminaux et chats sont conservés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reinicia cuando llevas 10 minutos sin tocar el teclado; las terminales y los chats continúan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es startet neu, sobald du 10 Minuten nicht getippt hast; Terminals und Chats bleiben erhalten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你 10 分钟没碰键盘后它会重启；终端和聊天会保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "10 分間キー操作がないと再起動します。ターミナルとチャットは引き継がれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "10분간 키 입력이 없으면 다시 시작됩니다. 터미널과 채팅은 유지됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезапустится, когда вы 10 минут не трогаете клавиатуру; терминалы и чаты сохраняются."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicia quando você ficar 10 minutos sem tocar nas teclas; terminais e chats continuam."
          }
        }
      }
    },
    "It shows everything the agent read and ran, including the contents of files and any secrets in them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il montre tout ce que l'agent a lu et exécuté, y compris le contenu des fichiers et les secrets qu'ils contiennent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra todo lo que el agente leyó y ejecutó, incluido el contenido de los archivos y cualquier secreto que contengan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es zeigt alles, was der Agent gelesen und ausgeführt hat, einschließlich Dateiinhalten und darin enthaltener Secrets."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会显示智能体读取和运行的全部内容，包括文件内容及其中的任何机密。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが読み取り、実行したすべてのもの（ファイルの内容やそこに含まれるシークレットを含む）が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 읽고 실행한 모든 것을 보여 주며, 파일 내용과 그 안의 시크릿도 포함됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь показано всё, что агент читал и запускал, включая содержимое файлов и любые секреты в них."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra tudo o que o agente leu e executou, incluindo o conteúdo dos arquivos e quaisquer segredos neles."
          }
        }
      }
    },
    "It shows in the device menu while Wireless debugging is on.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il apparaît dans le menu des appareils tant que le débogage sans fil est activé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece en el menú de dispositivos mientras la depuración inalámbrica está activada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es erscheint im Gerätemenü, solange kabelloses Debugging an ist."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无线调试开启时，它会显示在设备菜单中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワイヤレス デバッグがオンの間、デバイスメニューに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무선 디버깅이 켜져 있는 동안 기기 메뉴에 표시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он показывается в меню устройств, пока включена отладка по Wi-Fi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece no menu de dispositivos enquanto a Depuração por Wi-Fi está ativada."
          }
        }
      }
    },
    "It stays on your account and keeps reaching your other hosts. It reaches this one again only when you allow it, with no more access than it has now.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il reste sur votre compte et continue d'atteindre vos autres hôtes. Il n'atteint à nouveau celui-ci que si vous l'autorisez, sans plus d'accès qu'il n'en a maintenant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se queda en tu cuenta y sigue accediendo a tus otros hosts. Vuelve a acceder a este solo cuando lo permitas, sin más acceso del que tiene ahora."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es bleibt auf deinem Account und erreicht weiter deine anderen Hosts. Diesen erreicht es erst wieder, wenn du es erlaubst, mit nicht mehr Zugriff als jetzt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它仍在你的账户上，并继续访问你的其他主机。只有在你允许后它才会再次访问此主机，且权限不超过现在。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントに残り、ほかのホストには引き続き接続できます。このホストに再び接続できるのはあなたが許可したときのみで、アクセス権は現在のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정에 그대로 남아 다른 호스트에는 계속 연결됩니다. 이 호스트에는 내가 허용할 때만 다시 연결되며, 지금보다 더 많은 권한을 갖지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он остаётся в вашей учётной записи и по-прежнему подключается к другим вашим хостам. К этому он подключится снова, только когда вы разрешите, и без большего доступа, чем сейчас."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua na sua conta e segue acessando seus outros hosts. Só volta a acessar este quando você permitir, sem mais acesso do que tem agora."
          }
        }
      }
    },
    "It stops what it is running now.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il arrête ce qu'il exécute en ce moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detiene lo que está ejecutando ahora."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es stoppt, was es gerade ausführt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会停止当前正在运行的内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在実行中のものを停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 실행 중인 작업을 중지합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущая работа будет остановлена."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o que está executando agora."
          }
        }
      }
    },
