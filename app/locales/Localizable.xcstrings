    "Your draft changed during generation. It was kept; generate again when ready.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre brouillon a changé pendant la génération. Il a été conservé ; générez à nouveau quand vous serez prêt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu borrador cambió durante la generación. Se conservó; vuelve a generar cuando quieras."
