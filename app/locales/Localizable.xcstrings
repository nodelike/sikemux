    "This deletes the local branch even if it has commits that are not merged anywhere else.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esto elimina la rama local aunque tenga commits que no estén fusionados en ningún otro sitio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "即使本地分支有未合并到其他任何地方的提交，也会将其删除。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das löscht den lokalen Branch, auch wenn er Commits hat, die nirgendwo sonst gemergt sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ceci supprime la branche locale même si elle a des commits qui ne sont fusionnés nulle part ailleurs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ほかのどこにもマージされていないコミットがあっても、ローカルブランチを削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
