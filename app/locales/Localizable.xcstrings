        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Островок ненадолго увеличивается, не открываясь."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A ilha cresce por um instante sem abrir."
          }
        }
      }
    },
