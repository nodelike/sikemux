        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取此窗格图片的格式。"
          }
        }
      }
    },
    "This permanently deletes the stash entry.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci supprime définitivement l'entrée du stash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina para siempre la entrada del stash."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das löscht den Stash-Eintrag endgültig."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会永久删除该储藏条目。"
          }
        }
      }
    },
    "This project folder is a repository itself, so its Git views use it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier de projet est lui-même un dépôt, ses vues Git l'utilisent donc."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carpeta de proyecto es en sí un repositorio, así que sus vistas de Git la usan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Projektordner ist selbst ein Repository, daher nutzen seine Git-Ansichten ihn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此项目文件夹本身就是仓库，因此 Git 视图使用它。"
          }
        }
      }
    },
    "This project has no remote on a code host": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce projet n'a pas de remote sur un hébergeur de code"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este proyecto no tiene ningún remoto en un host de código"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Projekt hat kein Remote auf einem Code-Host"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此项目在代码托管平台上没有远程"
          }
        }
      }
    },
    "This repository has no branches yet.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dépôt n'a pas encore de branches."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este repositorio aún no tiene ramas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Repository hat noch keine Branches."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此仓库尚无分支。"
          }
        }
      }
    },
    "This repository has no remote yet": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dépôt n'a pas encore de remote"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este repositorio aún no tiene remoto"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Repository hat noch kein Remote"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此仓库尚无远程"
          }
        }
      }
    },
    "This repository is on no code host Sikemux is signed in to.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dépôt n'est sur aucun hébergeur de code auquel Sikemux est connecté."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este repositorio no está en ningún host de código en el que Sikemux haya iniciado sesión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Repository liegt auf keinem Code-Host, bei dem Sikemux angemeldet ist."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此仓库不在 Sikemux 已登录的任何代码托管平台上。"
          }
        }
      }
    },
    "This runs on {name}": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci s'exécute sur {name}"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto se ejecuta en {name}"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das läuft auf {name}"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此项在 {name} 上运行"
          }
        }
      }
    },
    "This tab needs a newer Sikemux.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet onglet nécessite une version plus récente de Sikemux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pestaña necesita una versión más reciente de Sikemux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Tab braucht ein neueres Sikemux."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此标签页需要更新版本的 Sikemux。"
          }
        }
      }
    },
    "This version, {current}, is older than Sikemux's servers work with now. Remote access and your account stay off until you update to {minimum} or later.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version, {current}, est plus ancienne que ce que les serveurs de Sikemux acceptent maintenant. L'accès à distance et votre compte restent désactivés jusqu'à la mise à jour vers {minimum} ou ultérieure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión, {current}, es más antigua de lo que admiten ahora los servidores de Sikemux. El acceso remoto y tu cuenta siguen desactivados hasta que actualices a {minimum} o posterior."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version, {current}, ist älter als das, womit die Server von Sikemux jetzt arbeiten. Fernzugriff und dein Account bleiben aus, bis du auf {minimum} oder neuer aktualisierst."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本 {current} 低于 Sikemux 服务器当前支持的版本。在你更新到 {minimum} 或更高版本前，远程访问和你的账户保持关闭。"
          }
        }
      }
    },
    "This wallpaper's format can't be read.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le format de ce fond d'écran est illisible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede leer el formato de este fondo de pantalla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Format dieses Hintergrundbilds kann nicht gelesen werden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取此墙纸的格式。"
          }
        }
      }
    },
    "This will discard BOTH staged and unstaged changes in 1 file. Cannot be undone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci abandonnera les modifications indexées ET non indexées dans 1 fichier. Action irréversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto descartará TANTO los cambios preparados como los no preparados en 1 archivo. No se puede deshacer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das verwirft gestagte UND nicht gestagte Änderungen in 1 Datei. Kann nicht rückgängig gemacht werden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将丢弃 1 个文件中已暂存和未暂存的全部更改。无法撤销。"
          }
        }
      }
    },
    "This will discard BOTH staged and unstaged changes in {count} files. Cannot be undone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci abandonnera les modifications indexées ET non indexées dans {count} fichiers. Action irréversible."
          }
        },
        "es": {
