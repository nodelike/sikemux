# Maintainer: nodelike
# packaging/arch/prepare.sh writes this for each release: the name, the version and
# the tarball's checksum. A nightly is sikemux-nightly-bin.

pkgname=sikemux-bin
_version=0.6.1
# pacman ranks 0.6.1nightly.6 below 0.6.1, as apt ranks 0.6.1~nightly.6.
pkgver=${_version//-/}
pkgrel=1
pkgdesc='The IDE for you and your coding agents'
arch=('x86_64')
url='https://sikemux.com'
# namcap rejects FSL-1.1-MIT as an SPDX licence, so it is named as our own.
license=('LicenseRef-FSL-1.1-MIT')
# The app opens Vulkan, EGL, Wayland and Xext while it runs rather than linking them.
# Browser recording loads GStreamer's base and good plugins by name.
depends=(
  'cairo'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gst-plugins-base'
  'gst-plugins-base-libs'
  'gst-plugins-good'
  'gstreamer'
  'gtk3'
  'hicolor-icon-theme'
  'libgcc'
  'libglvnd'
  'libsoup3'
  'libx11'
  'libxcb'
  'libxext'
  'libxkbcommon'
  'libxkbcommon-x11'
  'vulkan-icd-loader'
  'wayland'
  'webkit2gtk-4.1'
  'zlib'
)
optdepends=(
  'gst-plugins-ugly: browser recordings as MP4 rather than WebM'
  'vulkan-driver: the GPU driver the window draws with, such as vulkan-intel or vulkan-radeon'
)
provides=('sikemux')
conflicts=('sikemux')
options=('!strip' '!debug')
source=(
  "https://github.com/nodelike/sikemux/releases/download/v$_version/Sikemux_${_version}_amd64.tar.gz"
  'sikemux.sysusers'
  'sikemux.tmpfiles'
)
sha256sums=('SKIP' '20834e34c739b13a649a1e40c417bf0d32eef25ae01f198962b367207ca0191f' 'dd5d962cb4ad855254f7188d089537aeb4be4e2b04924355bfecfb452544366b')

package() {
  cp -a usr "$pkgdir/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 sikemux.sysusers "$pkgdir/usr/lib/sysusers.d/sikemux.conf"
  install -Dm644 sikemux.tmpfiles "$pkgdir/usr/lib/tmpfiles.d/sikemux.conf"
}
