{
  "version": 1,
  "check": { "ci": ["CI"] },
  "landChecks": [
    {
      "label": "pnpm strings:check",
      "command": "node scripts/generate-strings.mjs --check",
      "when": [
        "app/src/**/*.rs",
        "app/locales/Localizable.xcstrings",
        "crates/sikemux-core/src/assets/keybindings.json",
        "scripts/generate-strings.mjs"
      ]
    },
    {
      "label": "pnpm agent-catalog:check",
      "command": "node scripts/generate-agent-catalog.mjs --check",
      "when": [
        "crates/sikemux-core/src/assets/agent-catalog.json",
        "crates/sikemux-agents/src/agent_catalog.rs",
        "crates/sikemux-pty/src/agent_detection/agent_kind.rs",
        "crates/sikemux-pty/src/agent_detection/bundled.rs",
        "shared/agents/catalog.generated.json",
        "server/app/src/chat/styles/generated/agent-brands.css",
        "scripts/generate-agent-catalog.mjs",
        "scripts/lib/generated.mjs"
      ]
    },
    {
      "label": "pnpm wire:check",
      "command": "node scripts/generate-wire-types.mjs --check",
      "when": [
        "crates/sikemux-{wire,view,core,corekit,git,agents,drivers,plugin-api,markdown,base,calls,client}/src/**",
        "helpers/notch/wire.json",
        "mobile/app/wire.json",
        "**/*.generated.{ts,swift,kt}",
        "scripts/generate-wire-types.mjs"
      ]
    },
    {
      "label": "the notch icons and sources check",
      "command": "node scripts/generate-notch-icons.mjs --check && node scripts/generate-notch-sources.mjs --check",
      "when": [
        "shared/ui/**",
        "shared/assets/agent-logos/**",
        "shared/buddies/**",
        "brand/mark/**",
        "app/assets/icons/**",
        "crates/sikemux-core/src/assets/agent-catalog.json",
        "crates/sikemux-view/src/notch.rs",
        "helpers/notch/settings.json",
        "helpers/notch/Sources/NotchKit/*.generated.swift",
        "mobile/ios/Sikemux/UI/PhoneIcons.generated.swift",
        "scripts/generate-notch-{icons,sources}.mjs",
        "scripts/lib/generated.mjs"
      ]
    },
    {
      "label": "the phone's eslint",
      "command": "cd mobile/app && for f; do set -- \"$@\" \"${f#mobile/app/}\"; shift; done && node_modules/.bin/eslint --no-warn-ignored --cache --cache-location node_modules/.cache/eslint-land/ \"$@\"",
      "when": ["mobile/app/**/*.{ts,tsx,js,mjs,cjs}"]
    }
  ],
  "worktree": {
    "onCreate": [
      {
        "id": "link-build-outputs",
        "label": "Link the app's build outputs",
        "command": "main=\"$(git rev-parse --path-format=absolute --git-common-dir)/..\"; built=packaging/binaries; if [ -e \"$main/$built\" ] && [ ! -e \"$built\" ]; then ln -s \"$main/$built\" \"$built\"; fi"
      }
    ]
  },
  "generate": {
    "command": "pnpm -s wire:generate",
    "outputs": [
      "shared/wire.generated.ts",
      "helpers/notch/Sources/NotchKit/Wire.generated.swift",
      "mobile/ios/Shared/Notify/Card.generated.swift",
      "mobile/app/modules/notify/android/src/main/java/com/nodelike/sikemux/notify/Card.generated.kt"
    ]
  }
}
