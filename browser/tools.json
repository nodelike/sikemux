    "file": "SIKEMUX_GUIDE.md",
    "name": "guide",
    "row": {"verb": "read", "kind": "read", "icon": "book", "target": ["the guide: {topic}", "the guide"]},
    "description": "Read before your first task launch or browser click. Topics go deeper.",
    "comment": "The sidecar answers it from the guide the core serves with this manifest, so it has no harness method."
  },
