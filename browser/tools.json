            "back",
            "forward",
            "reload"
          ]
        },
        "hard": {
          "type": "boolean"
        },
        "waitFor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "textGone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "selector": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
