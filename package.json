{
  "name": "sikemux",
  "private": true,
  "version": "0.3.4",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build": "tsc --noEmit && vite build && pnpm bundle:check",
    "bundle:check": "node scripts/check-bundle-globals.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/*.mjs\" vite.config.ts eslint.config.js package.json README.md CONTRIBUTING.md \".github/workflows/*.{yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/*.mjs\" vite.config.ts eslint.config.js package.json README.md CONTRIBUTING.md \".github/workflows/*.{yml,yaml}\"",
    "lint": "eslint --max-warnings=0 \"src/**/*.{ts,tsx}\" vite.config.ts",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "test:coverage": "NODE_ENV=test vitest run --coverage",
    "test:e2e:desktop": "node scripts/build-cli-sidecar.mjs && CARGO_TARGET_DIR=\"$PWD/src-tauri/target/e2e\" tauri build --debug --no-bundle --ci --config src-tauri/tauri.e2e.conf.json && node scripts/smoke-desktop-e2e.mjs",
    "bench:perf": "NODE_ENV=test vitest bench --run src/performance.bench.ts",
    "perf:budget": "node scripts/check-performance-budget.mjs",
    "ipc:generate": "node scripts/generate-ipc-contracts.mjs",
    "ipc:check": "node scripts/generate-ipc-contracts.mjs --check",
    "deps:audit": "node scripts/check-dependency-health.mjs",
    "browser:test": "uv run --project browser python -m unittest discover -s browser -p 'test_*.py'",
    "dev-launcher:test": "node --test scripts/dev-desktop.node-test.mjs",
    "browser:audit": "uv run --project browser --with pip-audit==2.10.1 pip-audit --local",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "rust:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --all-targets --all-features",
    "release:check": "./scripts/check-release.sh",
    "check": "pnpm ipc:check && pnpm deps:audit && pnpm browser:audit && pnpm browser:test && pnpm dev-launcher:test && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm perf:budget && pnpm rust:fmt:check && pnpm rust:clippy && pnpm rust:test",
    "tauri": "tauri",
    "build:sidecar": "node scripts/build-cli-sidecar.mjs && node scripts/build-browser-sidecar.mjs",
    "build:mac": "./scripts/build-mac.sh",
    "build:windows": "pnpm build:sidecar && tauri build --bundles nsis --config src-tauri/tauri.sidecar.conf.json"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.3",
    "@paper-design/shaders": "^0.0.80",
    "@pierre/diffs": "^1.3.6",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "@shikijs/langs": "^4.4.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "immer": "^11.1.16",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "terser": "^5.50.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
