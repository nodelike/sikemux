{
  "name": "sikemux",
  "private": true,
  "version": "0.6.0-nightly.1",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "dev:desktop": "pnpm sidecar:dev && node scripts/dev-desktop.mjs",
    "sidecar:dev": "cargo build --manifest-path src-tauri/Cargo.toml -p sikemux-host --bin sikemux-host && node scripts/build-voice-helper.mjs --dev && node scripts/build-notch-helper.mjs --dev && node scripts/build-sim-helper.mjs --dev",
    "build": "tsrs --noEmit && vite build && pnpm bundle:check",
    "bundle:check": "node scripts/check-bundle-globals.mjs",
    "preview": "vite preview",
    "brand": "node scripts/brand.mjs",
    "showcase": "node showcase/capture.mjs",
    "showcase:serve": "vite --config showcase/vite.config.ts",
    "showcase:perf": "NODE_ENV=production vite --config showcase/vite.perf.config.ts --mode production --force --port 5791",
    "showcase:twitter": "node showcase/twitter.mjs",
    "showcase:video": "node showcase/video/render.mjs",
    "typecheck": "tsrs --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"shared/**/*.{ts,tsx}\" \"scripts/*.mjs\" vite.config.ts eslint.config.js package.json README.md CONTRIBUTING.md \".github/workflows/*.{yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"shared/**/*.{ts,tsx}\" \"scripts/*.mjs\" vite.config.ts eslint.config.js package.json README.md CONTRIBUTING.md \".github/workflows/*.{yml,yaml}\"",
    "lint": "eslint --max-warnings=0 \"src/**/*.{ts,tsx}\" \"shared/**/*.{ts,tsx}\" vite.config.ts && node scripts/check-plugin-boundaries.mjs && node scripts/check-css-important.mjs && node mobile/scripts/check-shared-imports.mjs",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "test:coverage": "NODE_ENV=test vitest run --coverage",
    "test:e2e:desktop": "CARGO_TARGET_DIR=\"$PWD/src-tauri/target/e2e\" tauri build --debug --no-bundle --ci --config src-tauri/tauri.e2e.conf.json -- -p sikemux -p sikemux-host -p sikemux-core && node scripts/smoke-desktop-e2e.mjs",
    "bench:perf": "NODE_ENV=test vitest bench --run src/performance.bench.ts",
    "perf:budget": "node scripts/check-performance-budget.mjs",
    "ipc:generate": "node scripts/generate-ipc-contracts.mjs",
    "ipc:check": "node scripts/generate-ipc-contracts.mjs --check",
    "wire:generate": "node scripts/generate-wire-types.mjs",
    "wire:check": "node scripts/generate-wire-types.mjs --check",
    "agent-tools:generate": "node scripts/generate-agent-tools.mjs",
    "agent-tools:check": "node scripts/generate-agent-tools.mjs --check",
    "agent-catalog:generate": "node scripts/generate-agent-catalog.mjs",
    "agent-catalog:check": "node scripts/generate-agent-catalog.mjs --check",
    "docs:reference": "node scripts/generate-docs-reference.mjs",
    "docs:reference:check": "node scripts/generate-docs-reference.mjs --check",
    "notch-sources:generate": "node scripts/generate-notch-sources.mjs",
    "notch-sources:check": "node scripts/generate-notch-sources.mjs --check",
    "grammars:generate": "node scripts/generate-grammars.mjs",
    "grammars:check": "node scripts/generate-grammars.mjs --check",
    "file-icons:generate": "node scripts/generate-file-icons.mjs",
    "file-icons:check": "node scripts/generate-file-icons.mjs --check",
    "faces:generate": "node scripts/generate-faces.mjs",
    "faces:check": "node scripts/generate-faces.mjs --check",
    "keybindings:generate": "node scripts/generate-keybindings.mjs",
    "keybindings:check": "node scripts/generate-keybindings.mjs --check",
    "syntax:generate": "node scripts/generate-syntax.mjs",
    "syntax:check": "node scripts/generate-syntax.mjs --check",
    "plugin-contract:check": "node scripts/check-plugin-contract.mjs",
    "voice-models:generate": "node scripts/generate-voice-models.mjs",
    "agent-tools:report": "node scripts/report-agent-tools.mjs",
    "deps:audit": "node scripts/check-dependency-health.mjs",
    "audit:rust": "cargo audit --file src-tauri/Cargo.lock",
    "shell:lint": "shellcheck scripts/*.sh",
    "dev-launcher:test": "node --test scripts/dev-desktop.node-test.mjs",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "rust:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "rust:hakari": "cd src-tauri && cargo hakari generate && cargo hakari manage-deps --yes",
    "rust:hakari:check": "cd src-tauri && cargo hakari generate --diff",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets --all-features -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --workspace --all-targets --all-features",
    "release:check": "./scripts/check-release.sh",
    "check": "pnpm ipc:check && pnpm wire:check && pnpm agent-tools:check && pnpm agent-catalog:check && pnpm docs:reference:check && pnpm notch-sources:check && pnpm grammars:check && pnpm file-icons:check && pnpm faces:check && pnpm keybindings:check && pnpm syntax:check && pnpm plugin-contract:check && pnpm deps:audit && pnpm shell:lint && pnpm dev-launcher:test && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm release:check && pnpm rust:fmt:check && pnpm rust:clippy && pnpm rust:test",
    "tauri": "tauri",
    "build:sidecar": "node scripts/build-cli-sidecar.mjs",
    "build:voice": "node scripts/build-voice-helper.mjs",
    "build:notch": "node scripts/build-notch-helper.mjs",
    "build:sim": "node scripts/build-sim-helper.mjs",
    "build:sim-fixture": "node scripts/build-sim-fixture.mjs",
    "test:sim": "swift test --package-path src-tauri/sim",
    "build:mac": "./scripts/build-mac.sh",
    "build:windows": "pnpm build:sidecar && tauri build --bundles nsis --config src-tauri/tauri.sidecar.conf.json",
    "build:linux": "scripts/build-linux.sh",
    "prepush": "./scripts/pre-push.sh",
    "perf": "node scripts/perf.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "@paper-design/shaders": "^0.0.81",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "@shikijs/langs": "^4.4.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "chai": "^6.3.0",
    "codemirror": "^6.0.2",
    "immer": "^11.1.18",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.3",
    "uqr": "0.1.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/chai": "^5.2.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "material-icon-theme": "5.39.0",
    "opentype.js": "^1.3.4",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
