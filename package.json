{
  "name": "sikemux",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "sidecar:dev": "cargo build -p sikemux-host --bin sikemux-host && node scripts/build-voice-helper.mjs --dev && node scripts/build-notch-helper.mjs --dev && node scripts/build-sim-helper.mjs --dev",
    "brand": "node scripts/brand.mjs",
    "typecheck": "tsc6 --noEmit",
    "format": "prettier --write \"shared/**/*.{ts,tsx}\" \"scripts/*.mjs\" eslint.config.js package.json README.md CONTRIBUTING.md \".github/workflows/*.{yml,yaml}\"",
    "format:check": "prettier --check \"shared/**/*.{ts,tsx}\" \"scripts/*.mjs\" eslint.config.js package.json README.md CONTRIBUTING.md \".github/workflows/*.{yml,yaml}\"",
    "lint": "eslint --max-warnings=0 \"shared/**/*.{ts,tsx}\" && node mobile/scripts/check-shared-imports.mjs",
    "wire:generate": "node scripts/generate-wire-types.mjs",
    "wire:check": "node scripts/generate-wire-types.mjs --check",
    "agent-tools:generate": "node scripts/generate-agent-tools.mjs",
    "agent-tools:check": "node scripts/generate-agent-tools.mjs --check",
    "agent-catalog:generate": "node scripts/generate-agent-catalog.mjs",
    "agent-catalog:check": "node scripts/generate-agent-catalog.mjs --check",
    "docs:reference": "node scripts/generate-docs-reference.mjs",
    "docs:reference:check": "node scripts/generate-docs-reference.mjs --check",
    "notch-sources:generate": "node scripts/generate-notch-sources.mjs",
    "notch-sources:check": "node scripts/generate-notch-sources.mjs --check",
    "grammars:generate": "node scripts/generate-grammars.mjs",
    "grammars:check": "node scripts/generate-grammars.mjs --check",
    "file-icons:generate": "node scripts/generate-file-icons.mjs",
    "file-icons:check": "node scripts/generate-file-icons.mjs --check",
    "faces:generate": "node scripts/generate-faces.mjs",
    "faces:check": "node scripts/generate-faces.mjs --check",
    "syntax:generate": "node scripts/generate-syntax.mjs",
    "syntax:check": "node scripts/generate-syntax.mjs --check",
    "voice-models:generate": "node scripts/generate-voice-models.mjs",
    "agent-tools:report": "node scripts/report-agent-tools.mjs",
    "eval:tools": "node evals/tools/run.mjs",
    "deps:audit": "node scripts/check-dependency-health.mjs",
    "audit:rust": "cargo audit --file Cargo.lock",
    "shell:lint": "shellcheck scripts/*.sh",
    "dev-launcher:test": "node --test scripts/dev-process.node-test.mjs",
    "rust:fmt": "cargo fmt --all",
    "rust:fmt:check": "cargo fmt --all -- --check",
    "rust:hakari": "cargo hakari generate && cargo hakari manage-deps --yes",
    "rust:hakari:check": "cargo hakari generate --diff",
    "rust:clippy": "cargo clippy --all-targets --all-features -- -D warnings",
    "rust:test": "cargo test --all-targets --all-features",
    "release:check": "./scripts/check-release.sh",
    "check": "pnpm wire:check && pnpm agent-tools:check && pnpm agent-catalog:check && pnpm docs:reference:check && pnpm notch-sources:check && pnpm grammars:check && pnpm file-icons:check && pnpm faces:check && pnpm syntax:check && pnpm deps:audit && pnpm shell:lint && pnpm dev-launcher:test && pnpm format:check && pnpm lint && pnpm typecheck && pnpm release:check && pnpm rust:fmt:check && pnpm rust:clippy && pnpm rust:test",
    "build:sidecar": "node scripts/build-cli-sidecar.mjs",
    "build:voice": "node scripts/build-voice-helper.mjs",
    "build:notch": "node scripts/build-notch-helper.mjs",
    "build:sim": "node scripts/build-sim-helper.mjs",
    "build:sim-fixture": "node scripts/build-sim-fixture.mjs",
    "test:sim": "swift test --package-path helpers/sim",
    "build:mac": "./scripts/build-mac.sh",
    "build:linux": "scripts/build-linux.sh",
    "prepush": "./scripts/pre-push.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@shikijs/langs": "^4.4.3",
    "@types/react": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "material-icon-theme": "5.39.0",
    "opentype.js": "^1.3.4",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  }
}
