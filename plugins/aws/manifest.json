{
  "id": "sikemux.aws",
  "name": "AWS",
  "callTimeoutSecs": 150,
  "environment": [
    "AWS_CLI",
    "AWS_CONFIG_FILE",
    "AWS_SHARED_CREDENTIALS_FILE",
    "AWS_REGION",
    "AWS_DEFAULT_REGION",
    "AWS_CA_BUNDLE"
  ],
  "accountMethods": [
    "setDefaultAccount",
    "signIn"
  ],
  "tools": [
    {
      "name": "aws_profiles",
      "row": {
        "verb": "list",
        "kind": "read",
        "icon": "folder",
        "target": [
          "AWS profiles"
        ]
      },
      "method": "agentProfiles",
      "description": "The AWS profiles set up on this computer, and which one calls use when you name none.",
      "properties": {}
    },
    {
      "name": "aws_identity",
      "row": {
        "verb": "whoami",
        "kind": "read",
        "icon": "status",
        "target": [
          "{profile}",
          "AWS identity"
        ]
      },
      "method": "agentIdentity",
      "description": "The account, role and region a profile acts as. Fails with a clear message when its sign-in has expired.",
      "properties": {
        "profile": {
          "type": "string",
          "description": "Default: the agents' profile."
        },
        "region": {
          "type": "string",
          "description": "Default: the profile's."
        }
      }
    },
    {
      "name": "aws_ecs",
      "row": {
        "verb": "ecs",
        "kind": "read",
        "icon": "dashboard",
        "target": [
          "{cluster}/{service} {tasks} tasks",
          "{cluster} {tasks} tasks",
          "{cluster}/{service}",
          "{cluster}",
          "{service}",
          "clusters"
        ]
      },
      "method": "agentEcs",
      "description": "ECS clusters; a cluster's services; a service's deployments and recent events; or tasks with health, image and why they stopped.",
      "properties": {
        "profile": {
          "type": "string",
          "description": "Default: the agents' profile."
        },
        "region": {
          "type": "string",
          "description": "Default: the profile's."
        },
        "cluster": {
          "type": "string",
          "description": "Name or ARN; leave out to list clusters."
        },
        "service": {
          "type": "string",
          "description": "Name; with no tasks, its deployments and events. Alone, searched for in every cluster."
        },
        "tasks": {
          "type": "string",
          "enum": [
            "running",
            "stopped"
          ],
          "description": "List tasks, of the service or the whole cluster."
        }
      }
    },
    {
      "name": "aws_task_definition",
      "row": {
        "verb": "read",
        "kind": "read",
        "icon": "code",
        "target": [
          "{name}"
        ]
      },
      "method": "agentTaskDefinition",
      "description": "An ECS task definition's containers: image, cpu, memory, ports, log group, and the names of its environment variables and secrets.",
      "properties": {
        "profile": {
          "type": "string",
          "description": "Default: the agents' profile."
        },
        "region": {
          "type": "string",
          "description": "Default: the profile's."
        },
        "name": {
          "type": "string",
          "description": "family, family:revision or ARN."
        }
      },
      "required": [
        "name"
      ]
    },
    {
      "name": "aws_target_health",
      "row": {
        "verb": "health",
        "kind": "read",
        "icon": "network",
        "target": [
          "{loadBalancer}",
          "{targetGroup}",
          "load balancers"
        ]
      },
      "method": "agentTargetHealth",
      "description": "A load balancer's listeners, rules and target health, or one target group's. With neither, lists the load balancers.",
      "properties": {
        "profile": {
          "type": "string",
          "description": "Default: the agents' profile."
        },
        "region": {
          "type": "string",
          "description": "Default: the profile's."
        },
        "loadBalancer": {
          "type": "string",
          "description": "Name or ARN."
        },
        "targetGroup": {
          "type": "string",
          "description": "Name or ARN."
        }
      }
    },
    {
      "name": "aws_logs",
      "row": {
        "verb": "logs",
        "kind": "search",
        "icon": "log-lines",
        "target": [
          "{group}"
        ],
        "detail": [
          "{pattern}",
          "{stream}"
        ]
      },
      "method": "agentLogs",
      "description": "The newest CloudWatch log events in a group, or one stream of it, optionally matching a filter pattern.",
      "properties": {
        "profile": {
          "type": "string",
          "description": "Default: the agents' profile."
        },
        "region": {
          "type": "string",
          "description": "Default: the profile's."
        },
        "group": {
          "type": "string",
          "description": "The log group. An unknown one lists groups with a similar name."
        },
        "stream": {
          "type": "string",
          "description": "One log stream."
        },
        "pattern": {
          "type": "string",
          "description": "A CloudWatch filter pattern, like ERROR or \"timed out\"."
        },
        "since": {
          "type": "string",
          "description": "How far back: 30m, 2h, 1d. Default 1h."
        },
        "limit": {
          "type": "integer",
          "description": "Events to return, newest kept. Default 100, at most 500."
        }
      },
      "required": [
        "group"
      ]
    },
    {
      "name": "aws_metrics",
      "row": {
        "verb": "metric",
        "kind": "read",
        "icon": "activity",
        "target": [
          "{namespace} {metric}"
        ]
      },
      "method": "agentMetrics",
      "description": "A CloudWatch metric over time, at most 120 points, oldest first.",
      "properties": {
        "profile": {
          "type": "string",
          "description": "Default: the agents' profile."
        },
        "region": {
          "type": "string",
          "description": "Default: the profile's."
        },
        "namespace": {
          "type": "string",
          "description": "Like AWS/ECS or AWS/ApplicationELB."
        },
        "metric": {
          "type": "string",
          "description": "Like CPUUtilization."
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Name to value, like {\"ClusterName\":\"prod\",\"ServiceName\":\"api\"}; all of the metric's."
        },
        "stat": {
          "type": "string",
          "description": "Average (default), Sum, Minimum, Maximum, SampleCount or a percentile like p99."
        },
        "since": {
          "type": "string",
          "description": "How far back: 30m, 2h, 1d. Default 3h."
        },
        "period": {
          "type": "integer",
          "description": "Seconds per point, widened to keep 120 points."
        }
      },
      "required": [
        "namespace",
        "metric"
      ]
    },
    {
      "name": "aws_ec2",
      "row": {
        "verb": "list",
        "kind": "read",
        "icon": "window",
        "target": [
          "EC2 {name}",
          "EC2 {state}",
          "EC2 instances"
        ]
      },
      "method": "agentEc2",
      "description": "EC2 instances with name, state, type, zone, VPC and addresses, or EBS volumes with their size and instances; at most 100.",
      "properties": {
        "profile": {
          "type": "string",
          "description": "Default: the agents' profile."
        },
        "region": {
          "type": "string",
          "description": "Default: the profile's."
        },
        "name": {
          "type": "string",
          "description": "Only those whose name, id, IP or instance contains this."
        },
        "state": {
          "type": "string",
          "description": "e.g. running, or available for unattached volumes"
        },
        "type": {
          "type": "string",
          "description": "e.g. t3.large or gp3"
        },
        "tag": {
          "type": "string",
          "description": "Key=Value or Key"
        },
        "vpc": {
          "type": "string",
          "description": "VPC id"
        },
        "volumes": {
          "type": "boolean",
          "description": "EBS volumes instead, largest first."
        }
      }
    },
    {
      "name": "aws_cost",
      "row": {
        "verb": "cost",
        "kind": "read",
        "icon": "activity",
        "target": [
          "AWS cost of {service}",
          "AWS cost by {groupBy}",
          "AWS cost"
        ]
      },
      "method": "agentCost",
      "description": "Spend from Cost Explorer up to yesterday, biggest groups first. Costs $0.01 a call.",
      "properties": {
        "profile": {
          "type": "string",
          "description": "Default: the agents' profile."
        },
        "days": {
          "type": "integer",
          "description": "Default 30, at most 365."
        },
        "daily": {
          "type": "boolean",
          "description": "Per day, not per month."
        },
        "groupBy": {
          "type": "string",
          "description": "Default SERVICE; or REGION, USAGE_TYPE and the like."
        },
        "service": {
          "type": "string",
          "description": "Only this SERVICE."
        }
      }
    }
  ]
}
