{
  "id": "sikemux.bitbucket",
  "name": "Bitbucket",
  "version": "0.1.0",
  "sikemux": ">=0.4",
  "callTimeoutSecs": 120,
  "writes": ["addComment", "cancel", "createIssue", "createPull", "dispatch", "editPull", "mergePull", "rerun", "reviewPull", "setIssueState", "setPullState"],
  "accountMethods": ["setDefaultAccount", "signInWithBrowser", "signInWithToken", "signOut"],
  "tokenForm": {
    "method": "signInWithToken",
    "lede": "Pull requests, pipelines and reviews for this repository, right beside your changes.",
    "fields": [
      { "name": "token", "label": "Token", "placeholder": "ATATT… or ATCTT…", "secret": true },
      { "name": "email", "label": "Atlassian account email", "placeholder": "you@example.com" }
    ],
    "tokenPage": "https://id.atlassian.com/manage-profile/security/api-tokens"
  },
  "codeHost": {
    "label": "Bitbucket",
    "ciName": "Pipelines",
    "runPath": "/pipelines/results/",
    "webHosts": ["bitbucket.org"],
    "compare": {
      "path": "pull-requests/new",
      "query": {
        "source": "{branch}"
      }
    },
    "pulls": {
      "mergeMethods": ["squash", "merge"],
      "requestChanges": true,
      "reopen": false,
      "mergeability": true
    },
    "ci": {
      "attempts": false,
      "approvals": false,
      "dispatch": true,
      "annotations": false,
      "summaries": false,
      "artifacts": false,
      "billing": false,
      "workflowFile": true,
      "rerunFailed": false,
      "rerunJob": false,
      "debugLogs": false,
      "deleteRuns": false,
      "deleteLogs": false
    }
  },
  "tools": [
    {
      "name": "bitbucket_pulls",
      "row": {"verb": "list", "kind": "read", "icon": "pull-request", "target": ["{name} pull requests"], "detail": ["{state}"]},
      "method": "pulls",
      "description": "Pull requests, most recently updated first, with state, branches and reviewers. owner and name come from the git remote.",
      "properties": {
        "owner": { "type": "string", "description": "The workspace." },
        "name": { "type": "string", "description": "The repository slug." },
        "state": { "type": "string", "enum": ["open", "closed", "all"], "description": "Default open. closed covers merged, declined and superseded." }
      },
      "required": ["owner", "name"]
    },
    {
      "name": "bitbucket_pull",
      "row": {"verb": "read", "kind": "read", "icon": "pull-request", "target": ["{name}#{number}"]},
      "method": "pull",
      "description": "One pull request with its reviewers, headSha, builds, and whether it can merge; mergeState says why not.",
      "properties": {
        "owner": { "type": "string", "description": "The workspace." },
        "name": { "type": "string", "description": "The repository slug." },
        "number": { "type": "integer", "description": "The pull request's id." }
      },
      "required": ["owner", "name", "number"]
    },
    {
      "name": "bitbucket_pull_files",
      "row": {"verb": "diff", "kind": "read", "icon": "pull-request", "target": ["{name}#{number}"], "detail": ["{paths}"]},
      "method": "pullFiles",
      "description": "The files a pull request changes, with status, line counts and any old path. Name paths for their diffs; a long diff comes in parts, with a note on the rest.",
      "properties": {
        "owner": { "type": "string", "description": "The workspace." },
        "name": { "type": "string", "description": "The repository slug." },
        "number": { "type": "integer", "description": "The pull request's id." },
        "paths": { "type": "array", "items": { "type": "string" }, "description": "Only these files, each with its patch." },
        "offset": { "type": "integer", "description": "Patch line to start from, from 0. The note gives the next one." },
        "lines": { "type": "integer", "description": "Patch lines to return. Default 400, at most 1000; a patch also stops at 32 KB." }
      },
      "required": ["owner", "name", "number"]
    },
    {
      "name": "bitbucket_comments",
      "row": {"verb": "read", "kind": "read", "icon": "pull-request", "target": ["comments on {name}#{number}"]},
      "method": "comments",
      "description": "What people wrote on a pull request or an issue, oldest first. Issues are numbered apart from pull requests, so say which.",
      "properties": {
        "owner": { "type": "string", "description": "The workspace." },
        "name": { "type": "string", "description": "The repository slug." },
        "number": { "type": "integer", "description": "The pull request's or issue's id." },
        "of": { "type": "string", "enum": ["pull", "issue"], "description": "Default pull." }
      },
      "required": ["owner", "name", "number"]
    },
    {
      "name": "bitbucket_issues",
      "row": {"verb": "list", "kind": "read", "icon": "issue", "target": ["{name} issues"], "detail": ["{state}"]},
      "method": "issues",
      "description": "Issues in the repository's Bitbucket tracker, recently updated first, 30 a page. A repository whose issues live in Jira has none here.",
      "properties": {
        "owner": { "type": "string", "description": "The workspace." },
        "name": { "type": "string", "description": "The repository slug." },
        "state": { "type": "string", "enum": ["open", "closed", "all"], "description": "Default open." },
        "page": { "type": "integer", "description": "From 1." }
      },
      "required": ["owner", "name"]
    },
    {
      "name": "bitbucket_pipelines",
      "row": {"verb": "list", "kind": "read", "icon": "workflow", "target": ["{name} pipelines"], "detail": ["{branch}", "{status}"]},
      "method": "runs",
      "description": "Recent Pipelines runs, newest first, with status and conclusion.",
      "properties": {
        "owner": { "type": "string", "description": "The workspace." },
        "name": { "type": "string", "description": "The repository slug." },
        "branch": { "type": "string" },
        "status": { "type": "string", "enum": ["queued", "in_progress", "waiting", "completed", "success", "failure", "cancelled", "skipped"], "description": "A state or a conclusion." },
        "headSha": { "type": "string", "description": "A commit." },
        "perPage": { "type": "integer", "description": "Default 30, at most 100." },
        "page": { "type": "integer", "description": "From 1." }
      },
      "required": ["owner", "name"]
    },
    {
      "name": "bitbucket_pipeline",
      "row": {"verb": "read", "kind": "read", "icon": "workflow", "target": ["pipeline {runId}"], "detail": ["{name}"]},
      "method": "run",
      "description": "One pipeline with its steps and their status, to see which step failed.",
      "properties": {
        "owner": { "type": "string", "description": "The workspace." },
        "name": { "type": "string", "description": "The repository slug." },
        "runId": { "type": "string", "description": "The {uuid} or build number." }
      },
      "required": ["owner", "name", "runId"]
    },
    {
      "name": "bitbucket_step_log",
      "row": {"verb": "logs", "kind": "read", "icon": "log-lines", "target": ["step {jobId}"], "detail": ["“{grep}”"]},
      "method": "jobLogExcerpt",
      "description": "The end of one pipeline step's log. Start with the default tail or grep for the error. truncated means earlier lines were left out.",
      "properties": {
        "owner": { "type": "string", "description": "The workspace." },
        "name": { "type": "string", "description": "The repository slug." },
        "jobId": { "type": "string", "description": "A step's id from bitbucket_pipeline, or a step {uuid} with runId." },
        "runId": { "type": "string", "description": "A step {uuid}'s pipeline." },
        "tail": { "type": "integer", "description": "Lines from the end, after grep. Default 200, at most 2000." },
        "grep": { "type": "string", "description": "Only lines containing this, ignoring case." }
      },
      "required": ["owner", "name", "jobId"]
    },
    {
      "name": "bitbucket_comment",
      "row": {"verb": "comment", "kind": "edit", "icon": "message", "target": ["on {name}#{number}"]},
      "method": "addComment",
      "description": "Comment on a pull request or an issue, in markdown. Issues are numbered apart from pull requests, so say which.",
      "properties": {
        "owner": { "type": "string", "description": "The workspace." },
        "name": { "type": "string", "description": "The repository slug." },
        "number": { "type": "integer", "description": "The pull request's or issue's id." },
        "body": { "type": "string" },
        "of": { "type": "string", "enum": ["pull", "issue"], "description": "Default pull." }
      },
      "required": ["owner", "name", "number", "body"]
    },
    {
      "name": "bitbucket_review",
      "row": {"verb": "review", "kind": "edit", "icon": "pull-request", "target": ["{name}#{number}"], "detail": ["{event}"]},
      "method": "reviewPull",
      "description": "Approve a pull request or request changes on it. A body is added as a comment after the verdict; COMMENT posts only the body.",
      "properties": {
        "owner": { "type": "string", "description": "The workspace." },
        "name": { "type": "string", "description": "The repository slug." },
        "number": { "type": "integer", "description": "The pull request's id." },
        "event": { "type": "string", "enum": ["APPROVE", "REQUEST_CHANGES", "COMMENT"] },
        "body": { "type": "string", "description": "Markdown." }
      },
      "required": ["owner", "name", "number", "event"]
    },
    {
      "name": "bitbucket_create_pull",
      "row": {"verb": "open", "kind": "edit", "icon": "square-plus", "target": ["{head} → {base}"], "detail": ["{name}"]},
      "method": "createPull",
      "description": "Open a pull request from a pushed branch. Push the branch with git first. The body is markdown.",
      "properties": {
        "owner": { "type": "string", "description": "The workspace." },
        "name": { "type": "string", "description": "The repository slug." },
        "title": { "type": "string" },
        "head": { "type": "string", "description": "The branch with the changes." },
        "base": { "type": "string", "description": "The branch to merge into." },
        "body": { "type": "string", "description": "No footer naming yourself." },
        "draft": { "type": "boolean" },
        "closeBranch": { "type": "boolean", "description": "Delete head once merged." }
      },
      "required": ["owner", "name", "title", "head", "base"]
    },
    {
      "name": "bitbucket_edit_pull",
      "row": {"verb": "edit", "kind": "edit", "icon": "pull-request", "target": ["{name}#{number}"]},
      "method": "editPull",
      "description": "Change a pull request's title, markdown body or base. Only the fields given change.",
      "properties": {
        "owner": { "type": "string", "description": "The workspace." },
        "name": { "type": "string", "description": "The repository slug." },
        "number": { "type": "integer", "description": "The pull request's id." },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "base": { "type": "string" }
      },
      "required": ["owner", "name", "number"]
    },
    {
      "name": "bitbucket_merge",
      "row": {"verb": "merge", "kind": "edit", "icon": "pull-request", "target": ["{name}#{number}"], "detail": ["{method}"]},
      "method": "mergePull",
      "description": "Merge a pull request. sha is the headSha from bitbucket_pull; the merge is refused if the branch has moved since.",
      "properties": {
        "owner": { "type": "string", "description": "The workspace." },
        "name": { "type": "string", "description": "The repository slug." },
        "number": { "type": "integer", "description": "The pull request's id." },
        "method": { "type": "string", "enum": ["merge", "squash", "fast_forward"], "description": "Default: the repository's." },
        "sha": { "type": "string", "description": "The head commit you reviewed." },
        "message": { "type": "string", "description": "Commit message." }
      },
      "required": ["owner", "name", "number", "sha"]
    },
    {
      "name": "bitbucket_decline",
      "row": {"verb": "decline", "kind": "delete", "icon": "close", "target": ["{name}#{number}"]},
      "method": "setPullState",
      "description": "Decline a pull request. Bitbucket cannot reopen a declined pull request, so do it only when asked.",
      "properties": {
        "owner": { "type": "string", "description": "The workspace." },
        "name": { "type": "string", "description": "The repository slug." },
        "number": { "type": "integer", "description": "The pull request's id." },
        "state": { "type": "string", "enum": ["closed"] }
      },
      "required": ["owner", "name", "number", "state"]
    },
    {
      "name": "bitbucket_create_issue",
      "row": {"verb": "create", "kind": "edit", "icon": "square-plus", "target": ["{title}"], "detail": ["{name}"]},
      "method": "createIssue",
      "description": "Create an issue in the repository's Bitbucket tracker. The body is markdown. A repository whose issues live in Jira has no tracker here.",
      "properties": {
        "owner": { "type": "string", "description": "The workspace." },
        "name": { "type": "string", "description": "The repository slug." },
        "title": { "type": "string" },
        "body": { "type": "string" }
      },
      "required": ["owner", "name", "title"]
    },
    {
      "name": "bitbucket_issue_state",
      "row": {"verb": "move", "kind": "move", "icon": "status", "target": ["{name} issue {number} to {state}"]},
      "method": "setIssueState",
      "description": "Close an issue, which marks it resolved, or reopen it.",
      "properties": {
        "owner": { "type": "string", "description": "The workspace." },
        "name": { "type": "string", "description": "The repository slug." },
        "number": { "type": "integer", "description": "The issue's id." },
        "state": { "type": "string", "enum": ["open", "closed"] }
      },
      "required": ["owner", "name", "number", "state"]
    },
    {
      "name": "bitbucket_rerun",
      "row": {"verb": "rerun", "kind": "execute", "icon": "refresh", "target": ["pipeline {runId}"], "detail": ["{name}"]},
      "method": "rerun",
      "description": "Run a pipeline again on the same commit. Bitbucket starts it as a new pipeline; list them to find it.",
      "properties": {
        "owner": { "type": "string", "description": "The workspace." },
        "name": { "type": "string", "description": "The repository slug." },
        "runId": { "type": "string", "description": "The {uuid} from bitbucket_pipelines." }
      },
      "required": ["owner", "name", "runId"]
    },
    {
      "name": "bitbucket_stop_pipeline",
      "row": {"verb": "stop", "kind": "execute", "icon": "stop", "target": ["pipeline {runId}"], "detail": ["{name}"]},
      "method": "cancel",
      "description": "Stop a running pipeline.",
      "properties": {
        "owner": { "type": "string", "description": "The workspace." },
        "name": { "type": "string", "description": "The repository slug." },
        "runId": { "type": "string", "description": "The {uuid} from bitbucket_pipelines." }
      },
      "required": ["owner", "name", "runId"]
    }
  ]
}
