{
  "id": "sikemux.gitlab",
  "name": "GitLab",
  "callTimeoutSecs": 120,
  "accountMethods": ["setDefaultAccount", "signInWithToken", "signOut"],
  "tokenForm": {
    "method": "signInWithToken",
    "lede": "Tools for your agents to read and work on merge requests, pipelines and issues.",
    "fields": [
      { "name": "host", "label": "Server", "placeholder": "gitlab.com" },
      { "name": "token", "label": "Personal access token", "placeholder": "glpat-…", "secret": true }
    ],
    "tokenPage": "https://{server}/-/user_settings/personal_access_tokens?name=Sikemux&scopes=api,read_user",
    "defaultServer": "gitlab.com"
  },
  "codeHost": {
    "label": "GitLab",
    "ciName": "Pipelines",
    "runPath": "/-/pipelines/",
    "jobPath": "/-/jobs/",
    "pullHeads": "merge-requests",
    "webHosts": ["gitlab.*"],
    "compare": {
      "path": "-/merge_requests/new",
      "query": {
        "merge_request[source_branch]": "{branch}"
      }
    },
    "pulls": {
      "mergeMethods": ["merge", "squash"],
      "requestChanges": false,
      "reopen": true,
      "mergeability": true
    },
    "ci": {
      "attempts": false,
      "approvals": false,
      "dispatch": true,
      "annotations": false,
      "summaries": false,
      "artifacts": false,
      "billing": false,
      "workflowFile": true,
      "rerunFailed": true,
      "rerunJob": true,
      "debugLogs": false,
      "deleteRuns": true,
      "deleteLogs": false
    }
  },
  "tools": [
    {
      "name": "gitlab_merge_requests",
      "row": {"verb": "list", "kind": "read", "icon": "pull-request", "target": ["{name} merge requests"], "detail": ["{state}"]},
      "method": "pulls",
      "description": "Merge requests, most recently updated first, with state, branches, reviewers and whether each can merge. owner, name and host come from the git remote.",
      "properties": {
        "owner": { "type": "string", "description": "The group path, e.g. platform/payments." },
        "name": { "type": "string", "description": "The project path." },
        "host": { "type": "string", "description": "The server in the git remote, e.g. gitlab.acme.dev." },
        "state": { "type": "string", "enum": ["open", "closed", "merged", "all"], "description": "Default open." }
      },
      "required": ["owner", "name"]
    },
    {
      "name": "gitlab_mr_files",
      "row": {"verb": "diff", "kind": "read", "icon": "pull-request", "target": ["{name}!{number}"], "detail": ["{paths}"]},
      "method": "pullFiles",
      "description": "The files a merge request changes, with status and line counts. Name paths for their diffs; a long diff comes in parts, with a note on the rest.",
      "properties": {
        "owner": { "type": "string", "description": "The group path." },
        "name": { "type": "string", "description": "The project path." },
        "host": { "type": "string", "description": "The server in the git remote, e.g. gitlab.acme.dev." },
        "number": { "type": "integer", "description": "The merge request's !number." },
        "paths": { "type": "array", "items": { "type": "string" }, "description": "Only these files, each with its patch." },
        "offset": { "type": "integer", "description": "Patch line to start from, from 0. The note gives the next one." },
        "lines": { "type": "integer", "description": "Patch lines to return. Default 400, at most 1000; a patch also stops at 32 KB." }
      },
      "required": ["owner", "name", "number"]
    },
    {
      "name": "gitlab_comments",
      "row": {"verb": "read", "kind": "read", "icon": "pull-request", "target": ["comments on {name} {number}"], "detail": ["{of}"]},
      "method": "comments",
      "description": "What people wrote on a merge request or an issue, oldest first. Merge requests and issues are numbered apart, so say which.",
      "properties": {
        "owner": { "type": "string", "description": "The group path." },
        "name": { "type": "string", "description": "The project path." },
        "host": { "type": "string", "description": "The server in the git remote, e.g. gitlab.acme.dev." },
        "number": { "type": "integer", "description": "The merge request's !number or the issue's #number." },
        "of": { "type": "string", "enum": ["pull", "issue"], "description": "Default pull, a merge request." }
      },
      "required": ["owner", "name", "number"]
    },
    {
      "name": "gitlab_issues",
      "row": {"verb": "list", "kind": "read", "icon": "issue", "target": ["{name} issues"], "detail": ["{state}"]},
      "method": "issues",
      "description": "A project's issues, most recently updated first, 30 to a page, with labels and assignees.",
      "properties": {
        "owner": { "type": "string", "description": "The group path." },
        "name": { "type": "string", "description": "The project path." },
        "host": { "type": "string", "description": "The server in the git remote, e.g. gitlab.acme.dev." },
        "state": { "type": "string", "enum": ["open", "closed", "all"], "description": "Default open." },
        "page": { "type": "integer", "description": "From 1." }
      },
      "required": ["owner", "name"]
    },
    {
      "name": "gitlab_pipelines",
      "row": {"verb": "list", "kind": "read", "icon": "workflow", "target": ["{name} pipelines"], "detail": ["{branch}", "{status}"]},
      "method": "runs",
      "description": "Recent pipelines, newest first, with status, conclusion, branch and the merge request each ran for.",
      "properties": {
        "owner": { "type": "string", "description": "The group path." },
        "name": { "type": "string", "description": "The project path." },
        "host": { "type": "string", "description": "The server in the git remote, e.g. gitlab.acme.dev." },
        "branch": { "type": "string" },
        "status": { "type": "string", "enum": ["queued", "in_progress", "waiting", "success", "failure", "cancelled", "skipped"], "description": "A state or a conclusion." },
        "headSha": { "type": "string", "description": "A commit." },
        "perPage": { "type": "integer", "description": "Default 30, at most 100." },
        "page": { "type": "integer", "description": "From 1." }
      },
      "required": ["owner", "name"]
    },
    {
      "name": "gitlab_pipeline",
      "row": {"verb": "read", "kind": "read", "icon": "workflow", "target": ["pipeline {runId}"], "detail": ["{name}"]},
      "method": "run",
      "description": "One pipeline with its jobs, named stage / job, and their status, to see which job failed.",
      "properties": {
        "owner": { "type": "string", "description": "The group path." },
        "name": { "type": "string", "description": "The project path." },
        "host": { "type": "string", "description": "The server in the git remote, e.g. gitlab.acme.dev." },
        "runId": { "type": "string", "description": "The pipeline id from gitlab_pipelines." }
      },
      "required": ["owner", "name", "runId"]
    },
    {
      "name": "gitlab_job_log",
      "row": {"verb": "logs", "kind": "read", "icon": "log-lines", "target": ["job {jobId}"], "detail": ["“{grep}”"]},
      "method": "jobLogExcerpt",
      "description": "The end of one CI job's log, or the lines asked for, without colour codes, at most 30,000 characters. Start with the default tail or grep for the error. truncated means lines were left out; note says which.",
      "properties": {
        "owner": { "type": "string", "description": "The group path." },
        "name": { "type": "string", "description": "The project path." },
        "host": { "type": "string", "description": "The server in the git remote, e.g. gitlab.acme.dev." },
        "jobId": { "type": "string", "description": "A job's id from gitlab_pipeline." },
        "tail": { "type": "integer", "description": "Lines from the end, after grep; from from when given. Default 200, at most 2000." },
        "grep": { "type": "string", "description": "Only lines containing this, ignoring case." },
        "context": { "type": "integer", "description": "Lines kept around each grep match, at most 50." },
        "from": { "type": "integer", "description": "First line number to read." },
        "to": { "type": "integer", "description": "Last line number to read." }
      },
      "required": ["owner", "name", "jobId"]
    }
  ]
}
